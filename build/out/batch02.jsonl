{"id": "h1-0253", "hv": "Nã", "pos_vi": "Động từ", "vi": "Cầm; lấy; mang", "ex_zh": "请把书拿给我。", "ex_vi": "Xin đưa quyển sách cho tôi."}
{"id": "h1-0254", "hv": "Nã", "pos_vi": "Đại từ", "vi": "Nào; đâu", "ex_zh": "你是哪国人？", "ex_vi": "Bạn là người nước nào?"}
{"id": "h1-0255", "hv": "Nã nhi", "pos_vi": "Đại từ", "vi": "Ở đâu; đâu", "ex_zh": "你要去哪儿？", "ex_vi": "Bạn muốn đi đâu?"}
{"id": "h1-0256", "hv": "Nã lý", "pos_vi": "Đại từ", "vi": "Ở đâu; đâu có (khiêm tốn)", "ex_zh": "你家在哪里？", "ex_vi": "Nhà bạn ở đâu?"}
{"id": "h1-0257", "hv": "Nã ta", "pos_vi": "Đại từ", "vi": "Những cái nào; những ai", "ex_zh": "你喜欢哪些水果？", "ex_vi": "Bạn thích những loại trái cây nào?"}
{"id": "h1-0258", "hv": "Na", "pos_vi": "Đại từ", "vi": "Kia; đó; thế thì", "ex_zh": "那是我的书。", "ex_vi": "Đó là sách của tôi."}
{"id": "h1-0259", "hv": "Na biên", "pos_vi": "Đại từ", "vi": "Bên kia; đằng kia", "ex_zh": "他在那边等你。", "ex_vi": "Anh ấy đang đợi bạn bên kia."}
{"id": "h1-0260", "hv": "Na nhi", "pos_vi": "Đại từ", "vi": "Ở đó; chỗ đó", "ex_zh": "我的书在那儿。", "ex_vi": "Sách của tôi ở đó."}
{"id": "h1-0261", "hv": "Na lý", "pos_vi": "Đại từ", "vi": "Ở đó; chỗ đó", "ex_zh": "那里的天气很好。", "ex_vi": "Thời tiết ở đó rất tốt."}
{"id": "h1-0262", "hv": "Na ta", "pos_vi": "Đại từ", "vi": "Những cái kia; những cái đó", "ex_zh": "那些人是我同学。", "ex_vi": "Những người đó là bạn học của tôi."}
{"id": "h1-0263", "hv": "Nãi", "pos_vi": "Danh từ", "vi": "Sữa; bú sữa", "ex_zh": "宝宝在喝奶。", "ex_vi": "Em bé đang uống sữa."}
{"id": "h1-0264", "hv": "Nãi nãi", "pos_vi": "Danh từ", "vi": "Bà nội; bà", "ex_zh": "奶奶今年七十岁。", "ex_vi": "Bà nội năm nay bảy mươi tuổi."}
{"id": "h1-0265", "hv": "Nam", "pos_vi": "Tính từ", "vi": "Nam; con trai", "ex_zh": "这是男的，那是女的。", "ex_vi": "Đây là nam, kia là nữ."}
{"id": "h1-0266", "hv": "Nam hài nhi", "pos_vi": "Danh từ", "vi": "Bé trai; con trai", "ex_zh": "那个男孩儿很可爱。", "ex_vi": "Cậu bé đó rất đáng yêu."}
{"id": "h1-0267", "hv": "Nam bằng hữu", "pos_vi": "Danh từ", "vi": "Bạn trai", "ex_zh": "她的男朋友很高。", "ex_vi": "Bạn trai của cô ấy rất cao."}
{"id": "h1-0268", "hv": "Nam nhân", "pos_vi": "Danh từ", "vi": "Đàn ông; nam giới", "ex_zh": "那个男人是我爸爸。", "ex_vi": "Người đàn ông đó là bố tôi."}
{"id": "h1-0269", "hv": "Nam sinh", "pos_vi": "Danh từ", "vi": "Nam sinh; học sinh nam", "ex_zh": "我们班有十个男生。", "ex_vi": "Lớp chúng tôi có mười nam sinh."}
{"id": "h1-0270", "hv": "Nam", "pos_vi": "Danh từ", "vi": "Phía nam; hướng nam", "ex_zh": "我家在中国南方。", "ex_vi": "Nhà tôi ở miền nam Trung Quốc."}
{"id": "h1-0271", "hv": "Nam biên", "pos_vi": "Danh từ", "vi": "Phía nam; bên phía nam", "ex_zh": "商店在学校南边。", "ex_vi": "Cửa hàng ở phía nam trường học."}
{"id": "h1-0272", "hv": "Nan", "pos_vi": "Tính từ", "vi": "Khó; khó khăn", "ex_zh": "这个问题很难。", "ex_vi": "Câu hỏi này rất khó."}
{"id": "h1-0273", "hv": "Ni", "pos_vi": "Trợ từ", "vi": "Thì sao; đang (trợ từ nghi vấn)", "ex_zh": "我很好，你呢？", "ex_vi": "Tôi khỏe, còn bạn thì sao?"}
{"id": "h1-0274", "hv": "Năng", "pos_vi": "Động từ", "vi": "Có thể; có khả năng", "ex_zh": "明天你能来吗？", "ex_vi": "Ngày mai bạn có thể đến không?"}
{"id": "h1-0275", "hv": "Nễ", "pos_vi": "Đại từ", "vi": "Bạn; anh; chị; cậu", "ex_zh": "你今年多大了？", "ex_vi": "Năm nay bạn bao nhiêu tuổi?"}
{"id": "h1-0276", "hv": "Nễ môn", "pos_vi": "Đại từ", "vi": "Các bạn; các anh chị", "ex_zh": "你们好，欢迎来我家。", "ex_vi": "Chào các bạn, hoan nghênh đến nhà tôi."}
{"id": "h1-0277", "hv": "Niên", "pos_vi": "Danh từ", "vi": "Năm; tuổi", "ex_zh": "今年我二十五岁。", "ex_vi": "Năm nay tôi hai mươi lăm tuổi."}
{"id": "h1-0278", "hv": "Nâm", "pos_vi": "Đại từ", "vi": "Ngài; ông; bà (kính trọng)", "ex_zh": "您请坐，喝杯茶。", "ex_vi": "Mời ngài ngồi, uống tách trà."}
{"id": "h1-0279", "hv": "Ngưu nãi", "pos_vi": "Danh từ", "vi": "Sữa bò", "ex_zh": "我每天早上喝牛奶。", "ex_vi": "Mỗi sáng tôi uống sữa bò."}
{"id": "h1-0280", "hv": "Nữ", "pos_vi": "Tính từ", "vi": "Nữ; con gái; phụ nữ", "ex_zh": "她是女的，不是男的。", "ex_vi": "Cô ấy là nữ, không phải nam."}
{"id": "h1-0281", "hv": "Nữ nhi", "pos_vi": "Danh từ", "vi": "Con gái", "ex_zh": "我的女儿五岁了。", "ex_vi": "Con gái tôi năm tuổi rồi."}
{"id": "h1-0282", "hv": "Nữ hài nhi", "pos_vi": "Danh từ", "vi": "Bé gái; con gái", "ex_zh": "那个女孩儿是我妹妹。", "ex_vi": "Cô bé đó là em gái tôi."}
{"id": "h1-0283", "hv": "Nữ bằng hữu", "pos_vi": "Danh từ", "vi": "Bạn gái", "ex_zh": "他有一个女朋友。", "ex_vi": "Anh ấy có một người bạn gái."}
{"id": "h1-0284", "hv": "Nữ nhân", "pos_vi": "Danh từ", "vi": "Phụ nữ; đàn bà", "ex_zh": "那个女人是老师。", "ex_vi": "Người phụ nữ đó là giáo viên."}
{"id": "h1-0285", "hv": "Nữ sinh", "pos_vi": "Danh từ", "vi": "Nữ sinh; học sinh nữ", "ex_zh": "我们班女生比男生多。", "ex_vi": "Lớp chúng tôi nữ sinh nhiều hơn nam sinh."}
{"id": "h1-0286", "hv": "Bàng biên", "pos_vi": "Danh từ", "vi": "Bên cạnh; cạnh", "ex_zh": "银行在商店旁边。", "ex_vi": "Ngân hàng ở cạnh cửa hàng."}
{"id": "h1-0287", "hv": "Bào", "pos_vi": "Động từ", "vi": "Chạy", "ex_zh": "他跑得很快。", "ex_vi": "Anh ấy chạy rất nhanh."}
{"id": "h1-0288", "hv": "Bằng hữu", "pos_vi": "Danh từ", "vi": "Bạn; bạn bè", "ex_zh": "他是我的好朋友。", "ex_vi": "Anh ấy là bạn tốt của tôi."}
{"id": "h1-0289", "hv": "Phiếu", "pos_vi": "Danh từ", "vi": "Vé; phiếu", "ex_zh": "我买了两张票。", "ex_vi": "Tôi đã mua hai vé."}
{"id": "h1-0290", "hv": "Thất", "pos_vi": "Số từ", "vi": "Bảy; số 7", "ex_zh": "现在是七点。", "ex_vi": "Bây giờ là bảy giờ."}
{"id": "h1-0291", "hv": "Khởi", "pos_vi": "Động từ", "vi": "Dậy; nổi lên; bắt đầu", "ex_zh": "我们一起去吧。", "ex_vi": "Chúng ta cùng đi nhé."}
{"id": "h1-0292", "hv": "Khởi sàng", "pos_vi": "Động từ", "vi": "Thức dậy; dậy", "ex_zh": "我每天七点起床。", "ex_vi": "Mỗi ngày tôi dậy lúc bảy giờ."}
{"id": "h1-0293", "hv": "Khởi lai", "pos_vi": "Động từ", "vi": "Đứng dậy; dậy; lên", "ex_zh": "天亮了，快起来吧。", "ex_vi": "Trời sáng rồi, mau dậy đi."}
{"id": "h1-0294", "hv": "Khí xa", "pos_vi": "Danh từ", "vi": "Ô tô; xe hơi", "ex_zh": "他开汽车去上班。", "ex_vi": "Anh ấy lái ô tô đi làm."}
{"id": "h1-0295", "hv": "Tiền", "pos_vi": "Danh từ", "vi": "Trước; phía trước", "ex_zh": "学校前有一家书店。", "ex_vi": "Trước trường có một hiệu sách."}
{"id": "h1-0296", "hv": "Tiền biên", "pos_vi": "Danh từ", "vi": "Phía trước; đằng trước", "ex_zh": "我家前边有个公园。", "ex_vi": "Phía trước nhà tôi có một công viên."}
{"id": "h1-0297", "hv": "Tiền thiên", "pos_vi": "Danh từ", "vi": "Hôm kia", "ex_zh": "我前天去了商场。", "ex_vi": "Hôm kia tôi đã đi trung tâm thương mại."}
{"id": "h1-0298", "hv": "Tiền", "pos_vi": "Danh từ", "vi": "Tiền", "ex_zh": "这个多少钱？", "ex_vi": "Cái này bao nhiêu tiền?"}
{"id": "h1-0299", "hv": "Tiền bao", "pos_vi": "Danh từ", "vi": "Ví tiền; ví", "ex_zh": "我的钱包不见了。", "ex_vi": "Ví của tôi mất rồi."}
{"id": "h1-0300", "hv": "Thỉnh", "pos_vi": "Động từ", "vi": "Mời; xin; làm ơn", "ex_zh": "请坐，请喝茶。", "ex_vi": "Mời ngồi, mời uống trà."}
{"id": "h1-0301", "hv": "Thỉnh giả", "pos_vi": "Động từ", "vi": "Xin nghỉ", "ex_zh": "我今天要请假。", "ex_vi": "Hôm nay tôi phải xin nghỉ."}
{"id": "h1-0302", "hv": "Thỉnh tiến", "pos_vi": "Cụm từ", "vi": "Mời vào", "ex_zh": "门开着，请进！", "ex_vi": "Cửa đang mở, mời vào!"}
{"id": "h1-0303", "hv": "Thỉnh vấn", "pos_vi": "Động từ", "vi": "Xin hỏi", "ex_zh": "请问，厕所在哪儿？", "ex_vi": "Xin hỏi, nhà vệ sinh ở đâu?"}
{"id": "h1-0304", "hv": "Thỉnh tọa", "pos_vi": "Cụm từ", "vi": "Mời ngồi", "ex_zh": "老师，请坐！", "ex_vi": "Thưa thầy, mời thầy ngồi!"}
{"id": "h1-0305", "hv": "Cầu", "pos_vi": "Danh từ", "vi": "Quả bóng; bóng", "ex_zh": "他喜欢打球。", "ex_vi": "Anh ấy thích chơi bóng."}
{"id": "h1-0306", "hv": "Khứ", "pos_vi": "Động từ", "vi": "Đi; đến", "ex_zh": "我明天去北京。", "ex_vi": "Ngày mai tôi đi Bắc Kinh."}
{"id": "h1-0307", "hv": "Khứ niên", "pos_vi": "Danh từ", "vi": "Năm ngoái", "ex_zh": "我去年学了汉语。", "ex_vi": "Năm ngoái tôi đã học tiếng Hán."}
{"id": "h1-0308", "hv": "Nhiệt", "pos_vi": "Tính từ", "vi": "Nóng; nhiệt", "ex_zh": "今天天气很热。", "ex_vi": "Hôm nay thời tiết rất nóng."}
{"id": "h1-0309", "hv": "Nhân", "pos_vi": "Danh từ", "vi": "Người; con người", "ex_zh": "这里有很多人。", "ex_vi": "Ở đây có rất nhiều người."}
{"id": "h1-0310", "hv": "Nhận thức", "pos_vi": "Động từ", "vi": "Quen biết; nhận ra", "ex_zh": "我认识你的哥哥。", "ex_vi": "Tôi quen anh trai của bạn."}
{"id": "h1-0311", "hv": "Nhận chân", "pos_vi": "Tính từ", "vi": "Chăm chỉ; nghiêm túc", "ex_zh": "他学习很认真。", "ex_vi": "Anh ấy học rất chăm chỉ."}
{"id": "h1-0312", "hv": "Nhật", "pos_vi": "Danh từ", "vi": "Ngày; mặt trời; Nhật Bản", "ex_zh": "今天是五月一日。", "ex_vi": "Hôm nay là ngày một tháng năm."}
{"id": "h1-0313", "hv": "Nhật kỳ", "pos_vi": "Danh từ", "vi": "Ngày tháng; ngày", "ex_zh": "请写上今天的日期。", "ex_vi": "Hãy viết ngày hôm nay lên."}
{"id": "h1-0314", "hv": "Nhục", "pos_vi": "Danh từ", "vi": "Thịt; thịt quả", "ex_zh": "我不喜欢吃肉。", "ex_vi": "Tôi không thích ăn thịt."}
{"id": "h1-0315", "hv": "Tam", "pos_vi": "Số từ", "vi": "Ba; số 3", "ex_zh": "我有三个朋友。", "ex_vi": "Tôi có ba người bạn."}
{"id": "h1-0316", "hv": "Sơn", "pos_vi": "Danh từ", "vi": "Núi; ngọn núi", "ex_zh": "那座山很高。", "ex_vi": "Ngọn núi đó rất cao."}
{"id": "h1-0317", "hv": "Thương trường", "pos_vi": "Danh từ", "vi": "Trung tâm thương mại", "ex_zh": "我们去商场买衣服。", "ex_vi": "Chúng tôi đi trung tâm thương mại mua quần áo."}
{"id": "h1-0318", "hv": "Thương điếm", "pos_vi": "Danh từ", "vi": "Cửa hàng; tiệm", "ex_zh": "这家商店很大。", "ex_vi": "Cửa hàng này rất lớn."}
{"id": "h1-0319", "hv": "Thượng", "pos_vi": "Danh từ", "vi": "Trên; lên; đi", "ex_zh": "桌子上有一本书。", "ex_vi": "Trên bàn có một quyển sách."}
{"id": "h1-0320", "hv": "Thượng ban", "pos_vi": "Động từ", "vi": "Đi làm; đến chỗ làm", "ex_zh": "爸爸八点上班。", "ex_vi": "Bố đi làm lúc tám giờ."}
{"id": "h1-0321", "hv": "Thượng biên", "pos_vi": "Danh từ", "vi": "Phía trên; bên trên", "ex_zh": "书在桌子上边。", "ex_vi": "Sách ở trên bàn."}
{"id": "h1-0322", "hv": "Thượng xa", "pos_vi": "Động từ", "vi": "Lên xe", "ex_zh": "请大家快点上车。", "ex_vi": "Mời mọi người lên xe nhanh."}
{"id": "h1-0323", "hv": "Thượng thứ", "pos_vi": "Danh từ", "vi": "Lần trước", "ex_zh": "上次我们见面是去年。", "ex_vi": "Lần trước chúng ta gặp nhau là năm ngoái."}
{"id": "h1-0324", "hv": "Thượng khóa", "pos_vi": "Động từ", "vi": "Vào học; lên lớp; dạy", "ex_zh": "我们八点上课。", "ex_vi": "Chúng tôi vào học lúc tám giờ."}
{"id": "h1-0325", "hv": "Thượng võng", "pos_vi": "Động từ", "vi": "Lên mạng; vào internet", "ex_zh": "他每天晚上上网。", "ex_vi": "Mỗi tối anh ấy lên mạng."}
{"id": "h1-0326", "hv": "Thượng ngọ", "pos_vi": "Danh từ", "vi": "Buổi sáng", "ex_zh": "我上午有汉语课。", "ex_vi": "Buổi sáng tôi có tiết tiếng Hán."}
{"id": "h1-0327", "hv": "Thượng học", "pos_vi": "Động từ", "vi": "Đi học", "ex_zh": "弟弟明年上学。", "ex_vi": "Năm sau em trai đi học."}
{"id": "h1-0328", "hv": "Thiểu", "pos_vi": "Tính từ", "vi": "Ít; thiếu", "ex_zh": "我的钱很少。", "ex_vi": "Tiền của tôi rất ít."}
{"id": "h1-0329", "hv": "Thân thượng", "pos_vi": "Danh từ", "vi": "Trên người; trong người", "ex_zh": "我身上没带钱。", "ex_vi": "Trên người tôi không mang tiền."}
{"id": "h1-0330", "hv": "Thân thể", "pos_vi": "Danh từ", "vi": "Cơ thể; sức khỏe", "ex_zh": "你身体好吗？", "ex_vi": "Sức khỏe của bạn tốt không?"}
{"id": "h1-0331", "hv": "Thập ma", "pos_vi": "Đại từ", "vi": "Cái gì; gì", "ex_zh": "你想吃什么？", "ex_vi": "Bạn muốn ăn gì?"}
{"id": "h1-0332", "hv": "Sinh bệnh", "pos_vi": "Động từ", "vi": "Bị bệnh; ốm", "ex_zh": "他昨天生病了。", "ex_vi": "Hôm qua anh ấy bị ốm."}
{"id": "h1-0333", "hv": "Sinh khí", "pos_vi": "Động từ", "vi": "Tức giận; giận", "ex_zh": "别生气，没关系。", "ex_vi": "Đừng giận, không sao đâu."}
{"id": "h1-0334", "hv": "Sinh nhật", "pos_vi": "Danh từ", "vi": "Sinh nhật", "ex_zh": "明天是我的生日。", "ex_vi": "Ngày mai là sinh nhật của tôi."}
{"id": "h1-0335", "hv": "Thập", "pos_vi": "Số từ", "vi": "Mười; số 10", "ex_zh": "我家有十个人。", "ex_vi": "Nhà tôi có mười người."}
{"id": "h1-0336", "hv": "Thời hậu", "pos_vi": "Danh từ", "vi": "Lúc; khi; thời gian", "ex_zh": "你什么时候回家？", "ex_vi": "Khi nào bạn về nhà?"}
{"id": "h1-0337", "hv": "Thời gian", "pos_vi": "Danh từ", "vi": "Thời gian; giờ", "ex_zh": "现在是学习时间。", "ex_vi": "Bây giờ là giờ học."}
{"id": "h1-0338", "hv": "Sự", "pos_vi": "Danh từ", "vi": "Việc; chuyện", "ex_zh": "我有一件事想问你。", "ex_vi": "Tôi có một việc muốn hỏi bạn."}
{"id": "h1-0339", "hv": "Thí", "pos_vi": "Động từ", "vi": "Thử; thi", "ex_zh": "你试一下这件衣服。", "ex_vi": "Bạn thử cái áo này xem."}
{"id": "h1-0340", "hv": "Thị", "pos_vi": "Động từ", "vi": "Là; phải; đúng", "ex_zh": "我是越南人。", "ex_vi": "Tôi là người Việt Nam."}
{"id": "h1-0341", "hv": "Thị bất thị", "pos_vi": "Cụm từ", "vi": "Có phải không; phải không", "ex_zh": "你是不是不舒服？", "ex_vi": "Có phải bạn không khỏe không?"}
{"id": "h1-0342", "hv": "Thủ", "pos_vi": "Danh từ", "vi": "Tay; bàn tay", "ex_zh": "我的手很冷。", "ex_vi": "Tay tôi rất lạnh."}
{"id": "h1-0343", "hv": "Thủ cơ", "pos_vi": "Danh từ", "vi": "Điện thoại di động", "ex_zh": "我的手机在桌子上。", "ex_vi": "Điện thoại của tôi ở trên bàn."}
{"id": "h1-0344", "hv": "Thư", "pos_vi": "Danh từ", "vi": "Sách", "ex_zh": "这本书很好看。", "ex_vi": "Quyển sách này rất hay."}
{"id": "h1-0345", "hv": "Thư bao", "pos_vi": "Danh từ", "vi": "Cặp sách; ba lô", "ex_zh": "我的书包很重。", "ex_vi": "Cặp sách của tôi rất nặng."}
{"id": "h1-0346", "hv": "Thư điếm", "pos_vi": "Danh từ", "vi": "Hiệu sách; nhà sách", "ex_zh": "我去书店买书。", "ex_vi": "Tôi đến hiệu sách mua sách."}
{"id": "h1-0347", "hv": "Thụ", "pos_vi": "Danh từ", "vi": "Cây; trồng", "ex_zh": "公园里有很多树。", "ex_vi": "Trong công viên có rất nhiều cây."}
{"id": "h1-0348", "hv": "Thùy", "pos_vi": "Đại từ", "vi": "Ai", "ex_zh": "他是谁？", "ex_vi": "Anh ấy là ai?"}
{"id": "h1-0349", "hv": "Thủy", "pos_vi": "Danh từ", "vi": "Nước", "ex_zh": "我想喝水。", "ex_vi": "Tôi muốn uống nước."}
{"id": "h1-0350", "hv": "Thủy quả", "pos_vi": "Danh từ", "vi": "Trái cây; hoa quả", "ex_zh": "我喜欢吃水果。", "ex_vi": "Tôi thích ăn trái cây."}
{"id": "h1-0351", "hv": "Thụy", "pos_vi": "Động từ", "vi": "Ngủ", "ex_zh": "孩子已经睡了。", "ex_vi": "Đứa trẻ đã ngủ rồi."}
{"id": "h1-0352", "hv": "Thụy giác", "pos_vi": "Động từ", "vi": "Ngủ; đi ngủ", "ex_zh": "我十一点睡觉。", "ex_vi": "Tôi đi ngủ lúc mười một giờ."}
{"id": "h1-0353", "hv": "Thuyết", "pos_vi": "Động từ", "vi": "Nói; bảo", "ex_zh": "请你再说一遍。", "ex_vi": "Xin bạn nói lại một lần nữa."}
{"id": "h1-0354", "hv": "Thuyết thoại", "pos_vi": "Động từ", "vi": "Nói chuyện; phát biểu", "ex_zh": "老师在说话。", "ex_vi": "Thầy giáo đang nói chuyện."}
{"id": "h1-0355", "hv": "Tứ", "pos_vi": "Số từ", "vi": "Bốn; số 4", "ex_zh": "我家有四个人。", "ex_vi": "Nhà tôi có bốn người."}
{"id": "h1-0356", "hv": "Tống", "pos_vi": "Động từ", "vi": "Tặng; tiễn; đưa", "ex_zh": "我送你回家。", "ex_vi": "Tôi đưa bạn về nhà."}
{"id": "h1-0357", "hv": "Tuế", "pos_vi": "Lượng từ", "vi": "Tuổi; năm tuổi", "ex_zh": "我女儿五岁了。", "ex_vi": "Con gái tôi năm tuổi rồi."}
{"id": "h1-0358", "hv": "Tha", "pos_vi": "Đại từ", "vi": "Anh ấy; ông ấy; nó", "ex_zh": "他是我的老师。", "ex_vi": "Ông ấy là thầy giáo của tôi."}
{"id": "h1-0359", "hv": "Tha môn", "pos_vi": "Đại từ", "vi": "Họ; các anh ấy", "ex_zh": "他们都是学生。", "ex_vi": "Họ đều là học sinh."}
{"id": "h1-0360", "hv": "Tha", "pos_vi": "Đại từ", "vi": "Cô ấy; bà ấy", "ex_zh": "她是我的同学。", "ex_vi": "Cô ấy là bạn học của tôi."}
{"id": "h1-0361", "hv": "Tha môn", "pos_vi": "Đại từ", "vi": "Họ (nữ); các cô ấy", "ex_zh": "她们在商店买东西。", "ex_vi": "Họ đang mua đồ ở cửa hàng."}
{"id": "h1-0362", "hv": "Thái", "pos_vi": "Phó từ", "vi": "Quá; rất; lắm", "ex_zh": "今天太热了。", "ex_vi": "Hôm nay nóng quá."}
{"id": "h1-0363", "hv": "Thiên", "pos_vi": "Danh từ", "vi": "Ngày; trời", "ex_zh": "今天天气很好。", "ex_vi": "Hôm nay thời tiết rất đẹp."}
{"id": "h1-0364", "hv": "Thiên khí", "pos_vi": "Danh từ", "vi": "Thời tiết", "ex_zh": "明天天气怎么样？", "ex_vi": "Ngày mai thời tiết thế nào?"}
{"id": "h1-0365", "hv": "Thính", "pos_vi": "Động từ", "vi": "Nghe", "ex_zh": "请听我说。", "ex_vi": "Xin hãy nghe tôi nói."}
{"id": "h1-0366", "hv": "Thính đáo", "pos_vi": "Động từ", "vi": "Nghe thấy; nghe được", "ex_zh": "我听到有人说话。", "ex_vi": "Tôi nghe thấy có người nói chuyện."}
{"id": "h1-0367", "hv": "Thính kiến", "pos_vi": "Động từ", "vi": "Nghe thấy", "ex_zh": "我没听见你说什么。", "ex_vi": "Tôi không nghe thấy bạn nói gì."}
{"id": "h1-0368", "hv": "Thính tả", "pos_vi": "Động từ", "vi": "Nghe viết; chính tả", "ex_zh": "老师让我们听写汉字。", "ex_vi": "Thầy giáo cho chúng tôi nghe viết chữ Hán."}
{"id": "h1-0369", "hv": "Đồng học", "pos_vi": "Danh từ", "vi": "Bạn học; bạn cùng lớp", "ex_zh": "他是我的同学。", "ex_vi": "Anh ấy là bạn học của tôi."}
{"id": "h1-0370", "hv": "Đồ thư quán", "pos_vi": "Danh từ", "vi": "Thư viện", "ex_zh": "我在图书馆看书。", "ex_vi": "Tôi đọc sách ở thư viện."}
{"id": "h1-0371", "hv": "Ngoại", "pos_vi": "Danh từ", "vi": "Ngoài; bên ngoài; nước ngoài", "ex_zh": "他在门外等你。", "ex_vi": "Anh ấy đợi bạn ngoài cửa."}
{"id": "h1-0372", "hv": "Ngoại biên", "pos_vi": "Danh từ", "vi": "Bên ngoài; phía ngoài", "ex_zh": "外边在下雨。", "ex_vi": "Bên ngoài đang mưa."}
{"id": "h1-0373", "hv": "Ngoại quốc", "pos_vi": "Danh từ", "vi": "Nước ngoài; ngoại quốc", "ex_zh": "他是外国人。", "ex_vi": "Anh ấy là người nước ngoài."}
{"id": "h1-0374", "hv": "Ngoại ngữ", "pos_vi": "Danh từ", "vi": "Ngoại ngữ", "ex_zh": "我在学习外语。", "ex_vi": "Tôi đang học ngoại ngữ."}
{"id": "h1-0375", "hv": "Ngoạn nhi", "pos_vi": "Động từ", "vi": "Chơi; vui chơi", "ex_zh": "我们去公园玩儿吧。", "ex_vi": "Chúng ta đến công viên chơi nhé."}
{"id": "h1-0376", "hv": "Vãn", "pos_vi": "Tính từ", "vi": "Tối; muộn", "ex_zh": "他今天来得很晚。", "ex_vi": "Hôm nay anh ấy đến rất muộn."}
{"id": "h1-0377", "hv": "Vãn phạn", "pos_vi": "Danh từ", "vi": "Cơm tối; bữa tối", "ex_zh": "我们一起吃晚饭吧。", "ex_vi": "Chúng ta cùng ăn cơm tối nhé."}
{"id": "h1-0378", "hv": "Vãn thượng", "pos_vi": "Danh từ", "vi": "Buổi tối; tối", "ex_zh": "晚上我在家看书。", "ex_vi": "Buổi tối tôi ở nhà đọc sách."}
