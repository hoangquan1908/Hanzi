{"id": "h2-0503", "hv": "Đông", "pos_vi": "Động từ", "vi": "Đau; nhức; thương yêu", "ex_zh": "我头疼，想休息。", "ex_vi": "Tôi đau đầu, muốn nghỉ ngơi."}
{"id": "h2-0504", "hv": "Đề", "pos_vi": "Động từ", "vi": "Nhắc; xách (trong 提防: đề phòng)", "ex_zh": "你要提防坏人。", "ex_vi": "Bạn phải đề phòng kẻ xấu."}
{"id": "h2-0505", "hv": "Đề xuất", "pos_vi": "Động từ", "vi": "Nêu ra; đề xuất; đưa ra", "ex_zh": "他提出了一个好问题。", "ex_vi": "Anh ấy đã nêu ra một câu hỏi hay."}
{"id": "h2-0506", "hv": "Đề đáo", "pos_vi": "Động từ", "vi": "Nhắc đến; đề cập", "ex_zh": "老师提到了你的名字。", "ex_vi": "Cô giáo đã nhắc đến tên bạn."}
{"id": "h2-0507", "hv": "Đề cao", "pos_vi": "Động từ", "vi": "Nâng cao; tăng; cải thiện", "ex_zh": "我想提高汉语水平。", "ex_vi": "Tôi muốn nâng cao trình độ tiếng Trung."}
{"id": "h2-0508", "hv": "Đề", "pos_vi": "Danh từ", "vi": "Đề; câu hỏi; chủ đề; họ Đề", "ex_zh": "这道题很难。", "ex_vi": "Câu hỏi này rất khó."}
{"id": "h2-0509", "hv": "Thể dục", "pos_vi": "Danh từ", "vi": "Thể thao; thể dục", "ex_zh": "我喜欢体育课。", "ex_vi": "Tôi thích giờ thể dục."}
{"id": "h2-0510", "hv": "Thể dục trường", "pos_vi": "Danh từ", "vi": "Sân vận động", "ex_zh": "我们在体育场踢球。", "ex_vi": "Chúng tôi đá bóng ở sân vận động."}
{"id": "h2-0511", "hv": "Thể dục quán", "pos_vi": "Danh từ", "vi": "Nhà thi đấu; phòng tập thể thao", "ex_zh": "体育馆里有很多人。", "ex_vi": "Trong nhà thi đấu có rất nhiều người."}
{"id": "h2-0512", "hv": "Thiên thượng", "pos_vi": "Danh từ", "vi": "Trên trời; thiên đường", "ex_zh": "天上有很多星星。", "ex_vi": "Trên trời có rất nhiều ngôi sao."}
{"id": "h2-0513", "hv": "Điều", "pos_vi": "Lượng từ", "vi": "Con, sợi, dải (cá, đường, quần...)", "ex_zh": "这条路很长。", "ex_vi": "Con đường này rất dài."}
{"id": "h2-0514", "hv": "Điều kiện", "pos_vi": "Danh từ", "vi": "Điều kiện; hoàn cảnh; yêu cầu", "ex_zh": "这里的条件很好。", "ex_vi": "Điều kiện ở đây rất tốt."}
{"id": "h2-0515", "hv": "Thính giảng", "pos_vi": "Động từ", "vi": "Nghe giảng; dự giờ", "ex_zh": "学生们在认真听讲。", "ex_vi": "Các học sinh đang chăm chú nghe giảng."}
{"id": "h2-0516", "hv": "Thính thuyết", "pos_vi": "Động từ", "vi": "Nghe nói", "ex_zh": "我听说你要去北京。", "ex_vi": "Tôi nghe nói bạn sắp đi Bắc Kinh."}
{"id": "h2-0517", "hv": "Đình", "pos_vi": "Động từ", "vi": "Dừng; ngừng; đỗ (xe)", "ex_zh": "车停在门口了。", "ex_vi": "Xe đã dừng ở trước cửa."}
{"id": "h2-0518", "hv": "Đình xa", "pos_vi": "Động từ", "vi": "Đỗ xe; dừng xe", "ex_zh": "这里不能停车。", "ex_vi": "Ở đây không được đỗ xe."}
{"id": "h2-0519", "hv": "Đình xa trường", "pos_vi": "Danh từ", "vi": "Bãi đỗ xe", "ex_zh": "停车场在楼下。", "ex_vi": "Bãi đỗ xe ở dưới tầng."}
{"id": "h2-0520", "hv": "Đĩnh", "pos_vi": "Phó từ", "vi": "Khá; rất; thẳng; ưỡn", "ex_zh": "这个菜挺好吃的。", "ex_vi": "Món này khá ngon."}
{"id": "h2-0521", "hv": "Đĩnh hảo", "pos_vi": "Cụm từ", "vi": "Rất tốt; khá tốt", "ex_zh": "这个主意挺好。", "ex_vi": "Ý kiến này rất tốt."}
{"id": "h2-0522", "hv": "Thông", "pos_vi": "Động từ", "vi": "Thông; thông suốt; thông thạo", "ex_zh": "这条路不通。", "ex_vi": "Con đường này không thông."}
{"id": "h2-0523", "hv": "Thông quá", "pos_vi": "Động từ", "vi": "Đi qua; thông qua; vượt qua", "ex_zh": "他通过了考试。", "ex_vi": "Anh ấy đã thi đỗ."}
{"id": "h2-0524", "hv": "Thông tri", "pos_vi": "Động từ", "vi": "Thông báo; báo; giấy báo", "ex_zh": "老师通知我们明天考试。", "ex_vi": "Cô giáo thông báo ngày mai thi."}
{"id": "h2-0525", "hv": "Đồng thời", "pos_vi": "Liên từ", "vi": "Đồng thời; cùng lúc", "ex_zh": "他同时会说两种语言。", "ex_vi": "Anh ấy đồng thời biết nói hai thứ tiếng."}
{"id": "h2-0526", "hv": "Đồng sự", "pos_vi": "Danh từ", "vi": "Đồng nghiệp", "ex_zh": "他是我的同事。", "ex_vi": "Anh ấy là đồng nghiệp của tôi."}
{"id": "h2-0527", "hv": "Đồng dạng", "pos_vi": "Tính từ", "vi": "Giống nhau; như nhau; tương tự", "ex_zh": "我们有同样的爱好。", "ex_vi": "Chúng tôi có cùng sở thích."}
{"id": "h2-0528", "hv": "Đầu", "pos_vi": "Danh từ", "vi": "Đầu; phần đầu; đầu tóc", "ex_zh": "我的头很疼。", "ex_vi": "Đầu tôi rất đau."}
{"id": "h2-0529", "hv": "Đầu phát", "pos_vi": "Danh từ", "vi": "Tóc", "ex_zh": "她的头发很长。", "ex_vi": "Tóc của cô ấy rất dài."}
{"id": "h2-0530", "hv": "Đồ phiến", "pos_vi": "Danh từ", "vi": "Hình ảnh; tranh ảnh", "ex_zh": "这张图片很好看。", "ex_vi": "Bức hình này rất đẹp."}
{"id": "h2-0531", "hv": "Thôi", "pos_vi": "Động từ", "vi": "Đẩy; từ chối; thoái thác", "ex_zh": "请把门推开。", "ex_vi": "Xin hãy đẩy cửa ra."}
{"id": "h2-0532", "hv": "Thoái", "pos_vi": "Danh từ", "vi": "Chân; cẳng chân", "ex_zh": "我的腿有点疼。", "ex_vi": "Chân tôi hơi đau."}
{"id": "h2-0533", "hv": "Ngoại địa", "pos_vi": "Danh từ", "vi": "Nơi khác; tỉnh khác", "ex_zh": "他是外地人。", "ex_vi": "Anh ấy là người ở nơi khác đến."}
{"id": "h2-0534", "hv": "Ngoại mại", "pos_vi": "Danh từ", "vi": "Đồ ăn mang về; giao đồ ăn", "ex_zh": "我今天晚上点外卖。", "ex_vi": "Tối nay tôi gọi đồ ăn giao tận nơi."}
{"id": "h2-0535", "hv": "Hoàn", "pos_vi": "Động từ", "vi": "Xong; hết; hoàn thành", "ex_zh": "作业写完了吗？", "ex_vi": "Làm xong bài tập chưa?"}
{"id": "h2-0536", "hv": "Hoàn thành", "pos_vi": "Động từ", "vi": "Hoàn thành; làm xong", "ex_zh": "他已经完成了工作。", "ex_vi": "Anh ấy đã hoàn thành công việc."}
{"id": "h2-0537", "hv": "Hoàn toàn", "pos_vi": "Phó từ", "vi": "Hoàn toàn; trọn vẹn", "ex_zh": "我完全同意你的话。", "ex_vi": "Tôi hoàn toàn đồng ý với bạn."}
{"id": "h2-0538", "hv": "Vãn an", "pos_vi": "Cụm từ", "vi": "Chúc ngủ ngon; chào buổi tối", "ex_zh": "妈妈，晚安！", "ex_vi": "Mẹ ơi, chúc mẹ ngủ ngon!"}
{"id": "h2-0539", "hv": "Vãn báo", "pos_vi": "Danh từ", "vi": "Báo chiều; báo buổi tối", "ex_zh": "爸爸每天看晚报。", "ex_vi": "Bố ngày nào cũng đọc báo chiều."}
{"id": "h2-0540", "hv": "Vãn xan", "pos_vi": "Danh từ", "vi": "Bữa tối; cơm tối", "ex_zh": "我们一起吃晚餐吧。", "ex_vi": "Chúng ta cùng ăn bữa tối nhé."}
{"id": "h2-0541", "hv": "Vãn hội", "pos_vi": "Danh từ", "vi": "Dạ tiệc; buổi tiệc tối", "ex_zh": "今晚有一个晚会。", "ex_vi": "Tối nay có một buổi dạ hội."}
{"id": "h2-0542", "hv": "Uyển", "pos_vi": "Danh từ", "vi": "Bát; chén", "ex_zh": "请给我一碗米饭。", "ex_vi": "Xin cho tôi một bát cơm."}
{"id": "h2-0543", "hv": "Mặc", "pos_vi": "Số từ", "vi": "Vạn (mười nghìn); họ Mặc (trong 万俟)", "ex_zh": "他有一万块钱。", "ex_vi": "Anh ấy có một vạn tệ."}
{"id": "h2-0544", "hv": "Võng", "pos_vi": "Danh từ", "vi": "Lưới; mạng; internet", "ex_zh": "我在网上买东西。", "ex_vi": "Tôi mua đồ trên mạng."}
{"id": "h2-0545", "hv": "Võng cầu", "pos_vi": "Danh từ", "vi": "Quần vợt; tennis", "ex_zh": "他喜欢打网球。", "ex_vi": "Anh ấy thích chơi quần vợt."}
{"id": "h2-0546", "hv": "Võng trạm", "pos_vi": "Danh từ", "vi": "Trang web; website", "ex_zh": "这个网站很有用。", "ex_vi": "Trang web này rất hữu ích."}
{"id": "h2-0547", "hv": "Vãng", "pos_vi": "Giới từ", "vi": "Đi về; hướng về; về phía", "ex_zh": "请往前走。", "ex_vi": "Xin hãy đi về phía trước."}
{"id": "h2-0548", "hv": "Vi", "pos_vi": "Giới từ", "vi": "Làm; là; vì; do", "ex_zh": "他被选为班长。", "ex_vi": "Anh ấy được chọn làm lớp trưởng."}
{"id": "h2-0549", "hv": "Vị thập ma", "pos_vi": "Đại từ", "vi": "Tại sao; vì sao", "ex_zh": "你为什么不去？", "ex_vi": "Tại sao bạn không đi?"}
{"id": "h2-0550", "hv": "Vị", "pos_vi": "Lượng từ", "vi": "Vị; người (kính trọng); vị trí", "ex_zh": "这位是我的老师。", "ex_vi": "Vị này là thầy giáo của tôi."}
{"id": "h2-0551", "hv": "Vị đạo", "pos_vi": "Danh từ", "vi": "Mùi vị; hương vị", "ex_zh": "这个菜的味道很好。", "ex_vi": "Hương vị món này rất ngon."}
{"id": "h2-0552", "hv": "Uy", "pos_vi": "Thán từ", "vi": "Alo; này; ơi", "ex_zh": "喂，你好！", "ex_vi": "Alo, xin chào!"}
{"id": "h2-0553", "hv": "Ôn độ", "pos_vi": "Danh từ", "vi": "Nhiệt độ", "ex_zh": "今天的温度很低。", "ex_vi": "Nhiệt độ hôm nay rất thấp."}
{"id": "h2-0554", "hv": "Văn", "pos_vi": "Động từ", "vi": "Ngửi; nghe thấy; họ Văn", "ex_zh": "我闻到了香味。", "ex_vi": "Tôi ngửi thấy mùi thơm."}
{"id": "h2-0555", "hv": "Vấn lộ", "pos_vi": "Động từ", "vi": "Hỏi đường", "ex_zh": "我向警察问路。", "ex_vi": "Tôi hỏi đường chú cảnh sát."}
{"id": "h2-0556", "hv": "Vấn đề", "pos_vi": "Danh từ", "vi": "Câu hỏi; vấn đề", "ex_zh": "我有一个问题。", "ex_vi": "Tôi có một câu hỏi."}
{"id": "h2-0557", "hv": "Ngọ xan", "pos_vi": "Danh từ", "vi": "Bữa trưa; cơm trưa", "ex_zh": "午餐你想吃什么？", "ex_vi": "Bữa trưa bạn muốn ăn gì?"}
{"id": "h2-0558", "hv": "Ngọ thụy", "pos_vi": "Động từ", "vi": "Ngủ trưa", "ex_zh": "我每天都要午睡。", "ex_vi": "Ngày nào tôi cũng ngủ trưa."}
{"id": "h2-0559", "hv": "Tập quán", "pos_vi": "Danh từ", "vi": "Thói quen; tập quán; quen", "ex_zh": "我习惯早起了。", "ex_vi": "Tôi đã quen dậy sớm."}
{"id": "h2-0560", "hv": "Tẩy y cơ", "pos_vi": "Danh từ", "vi": "Máy giặt", "ex_zh": "我家有一台洗衣机。", "ex_vi": "Nhà tôi có một cái máy giặt."}
{"id": "h2-0561", "hv": "Tẩy tảo", "pos_vi": "Động từ", "vi": "Tắm", "ex_zh": "我每天晚上洗澡。", "ex_vi": "Tối nào tôi cũng tắm."}
{"id": "h2-0562", "hv": "Tây bắc", "pos_vi": "Danh từ", "vi": "Tây Bắc; hướng tây bắc", "ex_zh": "他来自中国西北。", "ex_vi": "Anh ấy đến từ vùng Tây Bắc Trung Quốc."}
{"id": "h2-0563", "hv": "Tây xan", "pos_vi": "Danh từ", "vi": "Món Tây; đồ ăn kiểu Tây", "ex_zh": "我们去吃西餐吧。", "ex_vi": "Chúng ta đi ăn món Tây nhé."}
{"id": "h2-0564", "hv": "Tây phương", "pos_vi": "Danh từ", "vi": "Phương Tây; các nước phương Tây", "ex_zh": "他喜欢西方文化。", "ex_vi": "Anh ấy thích văn hóa phương Tây."}
{"id": "h2-0565", "hv": "Tây nam", "pos_vi": "Danh từ", "vi": "Tây nam; hướng tây nam", "ex_zh": "四川在中国西南。", "ex_vi": "Tứ Xuyên ở phía tây nam Trung Quốc."}
{"id": "h2-0566", "hv": "Tây y", "pos_vi": "Danh từ", "vi": "Tây y; bác sĩ tây y", "ex_zh": "他是一名西医。", "ex_vi": "Ông ấy là một bác sĩ tây y."}
{"id": "h2-0567", "hv": "Hạ tuyết", "pos_vi": "Động từ", "vi": "Tuyết rơi", "ex_zh": "北京下雪了。", "ex_vi": "Bắc Kinh có tuyết rơi rồi."}
{"id": "h2-0568", "hv": "Hạ chu", "pos_vi": "Cụm từ", "vi": "Tuần sau", "ex_zh": "我下周去上海。", "ex_vi": "Tuần sau tôi đi Thượng Hải."}
{"id": "h2-0569", "hv": "Hạ thiên", "pos_vi": "Danh từ", "vi": "Mùa hè", "ex_zh": "夏天太热了。", "ex_vi": "Mùa hè nóng quá."}
{"id": "h2-0570", "hv": "Tướng cơ", "pos_vi": "Danh từ", "vi": "Máy ảnh", "ex_zh": "这个相机很贵。", "ex_vi": "Chiếc máy ảnh này rất đắt."}
{"id": "h2-0571", "hv": "Tương đồng", "pos_vi": "Tính từ", "vi": "Giống nhau; như nhau", "ex_zh": "我们的想法相同。", "ex_vi": "Suy nghĩ của chúng tôi giống nhau."}
{"id": "h2-0572", "hv": "Tương tín", "pos_vi": "Động từ", "vi": "Tin; tin tưởng", "ex_zh": "我相信你说的话。", "ex_vi": "Tôi tin lời bạn nói."}
{"id": "h2-0573", "hv": "Hưởng", "pos_vi": "Động từ", "vi": "Vang; kêu; tiếng vang", "ex_zh": "电话响了。", "ex_vi": "Điện thoại reo rồi."}
{"id": "h2-0574", "hv": "Tưởng đáo", "pos_vi": "Động từ", "vi": "Nghĩ đến; nghĩ ra", "ex_zh": "我没想到他会来。", "ex_vi": "Tôi không nghĩ là anh ấy sẽ đến."}
{"id": "h2-0575", "hv": "Tưởng pháp", "pos_vi": "Danh từ", "vi": "Ý nghĩ; ý kiến; suy nghĩ", "ex_zh": "你有什么想法？", "ex_vi": "Bạn có ý kiến gì?"}
{"id": "h2-0576", "hv": "Tưởng khởi", "pos_vi": "Động từ", "vi": "Nhớ ra; nghĩ ra", "ex_zh": "我想起来了！", "ex_vi": "Tôi nhớ ra rồi!"}
{"id": "h2-0577", "hv": "Hướng", "pos_vi": "Giới từ", "vi": "Hướng về; về phía; họ Hướng", "ex_zh": "请向左走。", "ex_vi": "Xin hãy đi về phía bên trái."}
{"id": "h2-0578", "hv": "Tượng", "pos_vi": "Động từ", "vi": "Giống; như", "ex_zh": "你长得像妈妈。", "ex_vi": "Bạn trông giống mẹ."}
{"id": "h2-0579", "hv": "Tiểu thanh", "pos_vi": "Phó từ", "vi": "Nhỏ tiếng; khẽ", "ex_zh": "请小声说话。", "ex_vi": "Xin hãy nói nhỏ tiếng."}
{"id": "h2-0580", "hv": "Tiểu thời hậu", "pos_vi": "Danh từ", "vi": "Hồi nhỏ; lúc nhỏ", "ex_zh": "我小时候住在河内。", "ex_vi": "Hồi nhỏ tôi sống ở Hà Nội."}
{"id": "h2-0581", "hv": "Tiểu thuyết", "pos_vi": "Danh từ", "vi": "Tiểu thuyết", "ex_zh": "我喜欢看小说。", "ex_vi": "Tôi thích đọc tiểu thuyết."}
{"id": "h2-0582", "hv": "Tiểu tâm", "pos_vi": "Tính từ", "vi": "Cẩn thận; coi chừng", "ex_zh": "过马路要小心。", "ex_vi": "Qua đường phải cẩn thận."}
{"id": "h2-0583", "hv": "Tiểu tổ", "pos_vi": "Danh từ", "vi": "Nhóm nhỏ; tổ", "ex_zh": "我们小组有五个人。", "ex_vi": "Nhóm chúng tôi có năm người."}
{"id": "h2-0584", "hv": "Hiệu viên", "pos_vi": "Danh từ", "vi": "Khuôn viên trường; sân trường", "ex_zh": "校园里的花很漂亮。", "ex_vi": "Hoa trong khuôn viên trường rất đẹp."}
{"id": "h2-0585", "hv": "Hiệu trưởng", "pos_vi": "Danh từ", "vi": "Hiệu trưởng", "ex_zh": "校长在办公室里。", "ex_vi": "Hiệu trưởng đang ở trong văn phòng."}
{"id": "h2-0586", "hv": "Tiếu thoại", "pos_vi": "Danh từ", "vi": "Chuyện cười; trò cười; cười nhạo", "ex_zh": "他讲了一个笑话。", "ex_vi": "Anh ấy kể một câu chuyện cười."}
{"id": "h2-0587", "hv": "Tiếu thoại nhi", "pos_vi": "Danh từ", "vi": "Chuyện cười (kiểu giọng Bắc)", "ex_zh": "他爱讲笑话儿。", "ex_vi": "Anh ấy thích kể chuyện cười."}
{"id": "h2-0588", "hv": "Hài", "pos_vi": "Danh từ", "vi": "Giày", "ex_zh": "这双鞋很舒服。", "ex_vi": "Đôi giày này rất thoải mái."}
{"id": "h2-0589", "hv": "Tâm lý", "pos_vi": "Danh từ", "vi": "Trong lòng; trong tim", "ex_zh": "我心里很高兴。", "ex_vi": "Trong lòng tôi rất vui."}
{"id": "h2-0590", "hv": "Tâm tình", "pos_vi": "Danh từ", "vi": "Tâm trạng", "ex_zh": "今天我心情很好。", "ex_vi": "Hôm nay tâm trạng tôi rất tốt."}
{"id": "h2-0591", "hv": "Tâm trung", "pos_vi": "Danh từ", "vi": "Trong lòng; trong tâm trí", "ex_zh": "他心中很难过。", "ex_vi": "Trong lòng anh ấy rất buồn."}
{"id": "h2-0592", "hv": "Tân văn", "pos_vi": "Danh từ", "vi": "Tin tức", "ex_zh": "我每天看新闻。", "ex_vi": "Ngày nào tôi cũng xem tin tức."}
{"id": "h2-0593", "hv": "Tín", "pos_vi": "Danh từ", "vi": "Thư; tin; tin tưởng", "ex_zh": "我给朋友写了一封信。", "ex_vi": "Tôi đã viết một bức thư cho bạn."}
{"id": "h2-0594", "hv": "Tín hiệu", "pos_vi": "Danh từ", "vi": "Tín hiệu; sóng", "ex_zh": "这里手机信号不好。", "ex_vi": "Ở đây sóng điện thoại không tốt."}
{"id": "h2-0595", "hv": "Tín tức", "pos_vi": "Danh từ", "vi": "Thông tin; tin nhắn", "ex_zh": "我收到了他的信息。", "ex_vi": "Tôi đã nhận được tin nhắn của anh ấy."}
{"id": "h2-0596", "hv": "Tín tâm", "pos_vi": "Danh từ", "vi": "Sự tự tin; niềm tin", "ex_zh": "你要有信心。", "ex_vi": "Bạn phải có niềm tin."}
{"id": "h2-0597", "hv": "Tín dụng tạp", "pos_vi": "Danh từ", "vi": "Thẻ tín dụng", "ex_zh": "我可以用信用卡吗？", "ex_vi": "Tôi có thể dùng thẻ tín dụng không?"}
{"id": "h2-0598", "hv": "Tinh tinh", "pos_vi": "Danh từ", "vi": "Ngôi sao; sao", "ex_zh": "晚上天上有很多星星。", "ex_vi": "Buổi tối trên trời có rất nhiều sao."}
{"id": "h2-0599", "hv": "Hành động", "pos_vi": "Động từ", "vi": "Hành động; hoạt động; đi lại", "ex_zh": "我们明天开始行动。", "ex_vi": "Ngày mai chúng ta bắt đầu hành động."}
{"id": "h2-0600", "hv": "Hành nhân", "pos_vi": "Danh từ", "vi": "Người đi bộ; khách bộ hành", "ex_zh": "行人要走人行道。", "ex_vi": "Người đi bộ phải đi trên vỉa hè."}
{"id": "h2-0601", "hv": "Hành vi", "pos_vi": "Danh từ", "vi": "Hành vi; cách cư xử", "ex_zh": "他的行为很好。", "ex_vi": "Hành vi của anh ấy rất tốt."}
{"id": "h2-0602", "hv": "Tính", "pos_vi": "Động từ", "vi": "Họ; mang họ", "ex_zh": "你姓什么？", "ex_vi": "Bạn họ gì?"}
{"id": "h2-0603", "hv": "Tính danh", "pos_vi": "Danh từ", "vi": "Họ tên", "ex_zh": "请写下你的姓名。", "ex_vi": "Xin hãy viết họ tên của bạn."}
{"id": "h2-0604", "hv": "Hưu giả", "pos_vi": "Động từ", "vi": "Nghỉ phép; nghỉ lễ", "ex_zh": "我下个月要休假。", "ex_vi": "Tháng sau tôi sẽ nghỉ phép."}
{"id": "h2-0605", "hv": "Hứa đa", "pos_vi": "Số từ", "vi": "Nhiều; rất nhiều", "ex_zh": "这里有许多人。", "ex_vi": "Ở đây có rất nhiều người."}
{"id": "h2-0606", "hv": "Tuyển", "pos_vi": "Động từ", "vi": "Chọn; lựa chọn", "ex_zh": "你选哪一个？", "ex_vi": "Bạn chọn cái nào?"}
{"id": "h2-0607", "hv": "Học kỳ", "pos_vi": "Danh từ", "vi": "Học kỳ", "ex_zh": "这个学期我很忙。", "ex_vi": "Học kỳ này tôi rất bận."}
{"id": "h2-0608", "hv": "Tuyết", "pos_vi": "Danh từ", "vi": "Tuyết; họ Tuyết", "ex_zh": "外面的雪很大。", "ex_vi": "Tuyết bên ngoài rất lớn."}
{"id": "h2-0609", "hv": "Nhan sắc", "pos_vi": "Danh từ", "vi": "Màu sắc", "ex_zh": "你喜欢什么颜色？", "ex_vi": "Bạn thích màu gì?"}
{"id": "h2-0610", "hv": "Nhãn", "pos_vi": "Danh từ", "vi": "Mắt; lỗ nhỏ; mấu chốt", "ex_zh": "他的左眼有点疼。", "ex_vi": "Mắt trái của anh ấy hơi đau."}
{"id": "h2-0611", "hv": "Nhãn tình", "pos_vi": "Danh từ", "vi": "Mắt; đôi mắt", "ex_zh": "她的眼睛很大。", "ex_vi": "Mắt của cô ấy rất to."}
{"id": "h2-0612", "hv": "Dưỡng", "pos_vi": "Động từ", "vi": "Nuôi (thú, con); chăm sóc", "ex_zh": "我家养了一只猫。", "ex_vi": "Nhà tôi nuôi một con mèo."}
{"id": "h2-0613", "hv": "Dạng tử", "pos_vi": "Danh từ", "vi": "Dáng vẻ; bộ dạng; mẫu", "ex_zh": "他笑的样子很可爱。", "ex_vi": "Dáng vẻ anh ấy cười rất dễ thương."}
{"id": "h2-0614", "hv": "Dược", "pos_vi": "Danh từ", "vi": "Thuốc", "ex_zh": "你要按时吃药。", "ex_vi": "Bạn phải uống thuốc đúng giờ."}
{"id": "h2-0615", "hv": "Dược điếm", "pos_vi": "Danh từ", "vi": "Hiệu thuốc; nhà thuốc", "ex_zh": "药店就在前面。", "ex_vi": "Hiệu thuốc ở ngay phía trước."}
{"id": "h2-0616", "hv": "Dược phiến", "pos_vi": "Danh từ", "vi": "Viên thuốc", "ex_zh": "一次吃两片药片。", "ex_vi": "Mỗi lần uống hai viên thuốc."}
{"id": "h2-0617", "hv": "Dược thủy", "pos_vi": "Danh từ", "vi": "Thuốc nước; dung dịch thuốc", "ex_zh": "这瓶药水要放冰箱。", "ex_vi": "Chai thuốc nước này phải để trong tủ lạnh."}
{"id": "h2-0618", "hv": "Yêu cầu", "pos_vi": "Động từ", "vi": "Yêu cầu; đòi hỏi", "ex_zh": "老师要求我们早到。", "ex_vi": "Cô giáo yêu cầu chúng tôi đến sớm."}
{"id": "h2-0619", "hv": "Dã hứa", "pos_vi": "Phó từ", "vi": "Có lẽ; có thể", "ex_zh": "他也许不在家。", "ex_vi": "Có lẽ anh ấy không có nhà."}
{"id": "h2-0620", "hv": "Dạ", "pos_vi": "Danh từ", "vi": "Đêm; ban đêm", "ex_zh": "夜很深了，快睡吧。", "ex_vi": "Đêm khuya rồi, ngủ mau đi."}
{"id": "h2-0621", "hv": "Dạ lý", "pos_vi": "Danh từ", "vi": "Ban đêm; trong đêm", "ex_zh": "夜里下了一场雨。", "ex_vi": "Ban đêm đã có một trận mưa."}
{"id": "h2-0622", "hv": "Nhất ban", "pos_vi": "Tính từ", "vi": "Bình thường; thông thường; nói chung", "ex_zh": "他的成绩一般。", "ex_vi": "Thành tích của anh ấy bình thường."}
{"id": "h2-0623", "hv": "Nhất bộ phận", "pos_vi": "Danh từ", "vi": "Một phần; một bộ phận", "ex_zh": "这只是一部分。", "ex_vi": "Đây chỉ là một phần."}
{"id": "h2-0624", "hv": "Nhất điểm điểm", "pos_vi": "Cụm từ", "vi": "Một chút xíu; một ít", "ex_zh": "我只会说一点点。", "ex_vi": "Tôi chỉ biết nói một chút xíu."}
{"id": "h2-0625", "hv": "Nhất định", "pos_vi": "Phó từ", "vi": "Nhất định; chắc chắn", "ex_zh": "明天我一定来。", "ex_vi": "Ngày mai tôi nhất định sẽ đến."}
{"id": "h2-0626", "hv": "Nhất cộng", "pos_vi": "Phó từ", "vi": "Tổng cộng; tất cả", "ex_zh": "一共多少钱？", "ex_vi": "Tổng cộng bao nhiêu tiền?"}
{"id": "h2-0627", "hv": "Nhất lộ bình an", "pos_vi": "Cụm từ", "vi": "Thượng lộ bình an; chúc đi đường bình an", "ex_zh": "祝你一路平安！", "ex_vi": "Chúc bạn thượng lộ bình an!"}
{"id": "h2-0628", "hv": "Nhất lộ thuận phong", "pos_vi": "Cụm từ", "vi": "Thuận buồm xuôi gió; chúc đi đường thuận lợi", "ex_zh": "祝你一路顺风！", "ex_vi": "Chúc bạn thuận buồm xuôi gió!"}
