{"id": "h2-0205", "hv": "Hảo đa", "pos_vi": "Số từ", "vi": "Rất nhiều; khá nhiều", "ex_zh": "公园里有好多人。", "ex_vi": "Trong công viên có rất nhiều người."}
{"id": "h2-0206", "hv": "Hảo cửu", "pos_vi": "Số từ", "vi": "Rất lâu; khá lâu", "ex_zh": "我们好久没见了。", "ex_vi": "Chúng ta lâu rồi không gặp."}
{"id": "h2-0207", "hv": "Hảo nhân", "pos_vi": "Danh từ", "vi": "Người tốt", "ex_zh": "他是一个好人。", "ex_vi": "Anh ấy là một người tốt."}
{"id": "h2-0208", "hv": "Hảo sự", "pos_vi": "Danh từ", "vi": "Việc tốt; chuyện tốt; việc vui", "ex_zh": "帮助别人是好事。", "ex_vi": "Giúp đỡ người khác là việc tốt."}
{"id": "h2-0209", "hv": "Hảo tượng", "pos_vi": "Động từ", "vi": "Hình như; dường như; giống như", "ex_zh": "他好像不高兴。", "ex_vi": "Hình như anh ấy không vui."}
{"id": "h2-0210", "hv": "Hợp thích", "pos_vi": "Tính từ", "vi": "Phù hợp; thích hợp", "ex_zh": "这件衣服很合适。", "ex_vi": "Chiếc áo này rất vừa vặn."}
{"id": "h2-0211", "hv": "Hà", "pos_vi": "Danh từ", "vi": "Sông", "ex_zh": "河里有很多鱼。", "ex_vi": "Dưới sông có rất nhiều cá."}
{"id": "h2-0212", "hv": "Hắc", "pos_vi": "Tính từ", "vi": "Đen; tối; (viết tắt) Hắc Long Giang", "ex_zh": "天黑了，我们回家吧。", "ex_vi": "Trời tối rồi, chúng ta về nhà thôi."}
{"id": "h2-0213", "hv": "Hắc bản", "pos_vi": "Danh từ", "vi": "Bảng đen", "ex_zh": "老师在黑板上写字。", "ex_vi": "Thầy giáo viết chữ lên bảng đen."}
{"id": "h2-0214", "hv": "Hắc sắc", "pos_vi": "Danh từ", "vi": "Màu đen", "ex_zh": "我喜欢黑色的包。", "ex_vi": "Tôi thích chiếc túi màu đen."}
{"id": "h2-0215", "hv": "Hồng", "pos_vi": "Tính từ", "vi": "Đỏ; họ Hồng", "ex_zh": "她穿了一件红衣服。", "ex_vi": "Cô ấy mặc một chiếc áo đỏ."}
{"id": "h2-0216", "hv": "Hồng sắc", "pos_vi": "Danh từ", "vi": "Màu đỏ", "ex_zh": "这朵花是红色的。", "ex_vi": "Bông hoa này màu đỏ."}
{"id": "h2-0217", "hv": "Hậu lai", "pos_vi": "Danh từ", "vi": "Sau đó; về sau", "ex_zh": "后来他去了北京。", "ex_vi": "Sau đó anh ấy đã đi Bắc Kinh."}
{"id": "h2-0218", "hv": "Hốt nhiên", "pos_vi": "Phó từ", "vi": "Đột nhiên; bỗng nhiên", "ex_zh": "天气忽然变冷了。", "ex_vi": "Thời tiết đột nhiên trở lạnh."}
{"id": "h2-0219", "hv": "Hồ", "pos_vi": "Danh từ", "vi": "Hồ", "ex_zh": "这个湖又大又美。", "ex_vi": "Cái hồ này vừa to vừa đẹp."}
{"id": "h2-0220", "hv": "Hộ chiếu", "pos_vi": "Danh từ", "vi": "Hộ chiếu", "ex_zh": "出国要带护照。", "ex_vi": "Ra nước ngoài phải mang hộ chiếu."}
{"id": "h2-0221", "hv": "Hoa viên", "pos_vi": "Danh từ", "vi": "Vườn hoa; khu vườn", "ex_zh": "花园里有很多花。", "ex_vi": "Trong vườn có rất nhiều hoa."}
{"id": "h2-0222", "hv": "Họa", "pos_vi": "Động từ", "vi": "Vẽ; tranh; bức tranh", "ex_zh": "她正在画一只猫。", "ex_vi": "Cô ấy đang vẽ một con mèo."}
{"id": "h2-0223", "hv": "Họa nhi", "pos_vi": "Danh từ", "vi": "Bức tranh; tranh vẽ", "ex_zh": "墙上有一张画儿。", "ex_vi": "Trên tường có một bức tranh."}
{"id": "h2-0224", "hv": "Họa gia", "pos_vi": "Danh từ", "vi": "Họa sĩ", "ex_zh": "他想当一个画家。", "ex_vi": "Anh ấy muốn trở thành họa sĩ."}
{"id": "h2-0225", "hv": "Hoại xứ", "pos_vi": "Danh từ", "vi": "Tác hại; điểm xấu", "ex_zh": "玩手机太久有坏处。", "ex_vi": "Chơi điện thoại quá lâu có hại."}
{"id": "h2-0226", "hv": "Hoại nhân", "pos_vi": "Danh từ", "vi": "Kẻ xấu; người xấu", "ex_zh": "电影里的坏人被抓了。", "ex_vi": "Kẻ xấu trong phim bị bắt rồi."}
{"id": "h2-0227", "hv": "Hoán", "pos_vi": "Động từ", "vi": "Đổi; thay; hoán đổi", "ex_zh": "我想换一件衣服。", "ex_vi": "Tôi muốn đổi một bộ quần áo."}
{"id": "h2-0228", "hv": "Hoan nghênh", "pos_vi": "Động từ", "vi": "Hoan nghênh; chào đón", "ex_zh": "欢迎你来我家玩。", "ex_vi": "Hoan nghênh bạn đến nhà tôi chơi."}
{"id": "h2-0229", "hv": "Hoàng", "pos_vi": "Tính từ", "vi": "Vàng; họ Hoàng", "ex_zh": "这个苹果是黄的。", "ex_vi": "Quả táo này màu vàng."}
{"id": "h2-0230", "hv": "Hoàng sắc", "pos_vi": "Danh từ", "vi": "Màu vàng", "ex_zh": "她买了黄色的裙子。", "ex_vi": "Cô ấy mua một chiếc váy màu vàng."}
{"id": "h2-0231", "hv": "Hồi quốc", "pos_vi": "Động từ", "vi": "Về nước", "ex_zh": "他明年就要回国了。", "ex_vi": "Sang năm anh ấy sẽ về nước."}
{"id": "h2-0232", "hv": "Hoạt động", "pos_vi": "Danh từ", "vi": "Hoạt động; vận động", "ex_zh": "学校有很多活动。", "ex_vi": "Trường có rất nhiều hoạt động."}
{"id": "h2-0233", "hv": "Hoặc", "pos_vi": "Liên từ", "vi": "Hoặc; có lẽ", "ex_zh": "你或他去都可以。", "ex_vi": "Bạn hoặc anh ấy đi đều được."}
{"id": "h2-0234", "hv": "Hoặc giả", "pos_vi": "Liên từ", "vi": "Hoặc; hoặc là", "ex_zh": "你喝茶或者咖啡？", "ex_vi": "Bạn uống trà hay cà phê?"}
{"id": "h2-0235", "hv": "Cơ hội", "pos_vi": "Danh từ", "vi": "Cơ hội", "ex_zh": "这是一个好机会。", "ex_vi": "Đây là một cơ hội tốt."}
{"id": "h2-0236", "hv": "Kê", "pos_vi": "Danh từ", "vi": "Gà; con gà", "ex_zh": "我家养了三只鸡。", "ex_vi": "Nhà tôi nuôi ba con gà."}
{"id": "h2-0237", "hv": "Cấp", "pos_vi": "Danh từ", "vi": "Cấp; lớp; bậc", "ex_zh": "他在三年级。", "ex_vi": "Cậu ấy học lớp ba."}
{"id": "h2-0238", "hv": "Cấp", "pos_vi": "Tính từ", "vi": "Gấp; vội; nóng ruột", "ex_zh": "别急，慢慢说。", "ex_vi": "Đừng vội, nói từ từ thôi."}
{"id": "h2-0239", "hv": "Kế hoạch", "pos_vi": "Danh từ", "vi": "Kế hoạch; lên kế hoạch", "ex_zh": "你有什么计划？", "ex_vi": "Bạn có kế hoạch gì không?"}
{"id": "h2-0240", "hv": "Kế toán cơ", "pos_vi": "Danh từ", "vi": "Máy tính", "ex_zh": "我的计算机坏了。", "ex_vi": "Máy tính của tôi hỏng rồi."}
{"id": "h2-0241", "hv": "Gia", "pos_vi": "Động từ", "vi": "Cộng; thêm; Canada (viết tắt)", "ex_zh": "三加五等于八。", "ex_vi": "Ba cộng năm bằng tám."}
{"id": "h2-0242", "hv": "Gia du", "pos_vi": "Động từ", "vi": "Cố lên; đổ xăng", "ex_zh": "加油，你一定行！", "ex_vi": "Cố lên, bạn nhất định làm được!"}
{"id": "h2-0243", "hv": "Gia đình", "pos_vi": "Danh từ", "vi": "Gia đình", "ex_zh": "我的家庭很幸福。", "ex_vi": "Gia đình tôi rất hạnh phúc."}
{"id": "h2-0244", "hv": "Gia trưởng", "pos_vi": "Danh từ", "vi": "Phụ huynh; gia trưởng", "ex_zh": "家长会在明天开。", "ex_vi": "Họp phụ huynh sẽ diễn ra vào ngày mai."}
{"id": "h2-0245", "hv": "Giả", "pos_vi": "Tính từ", "vi": "Giả; không thật", "ex_zh": "这个消息是假的。", "ex_vi": "Tin này là giả."}
{"id": "h2-0246", "hv": "Giả kỳ", "pos_vi": "Danh từ", "vi": "Kỳ nghỉ; kỳ nghỉ lễ", "ex_zh": "假期我想去旅游。", "ex_vi": "Kỳ nghỉ tôi muốn đi du lịch."}
{"id": "h2-0247", "hv": "Kiểm tra", "pos_vi": "Động từ", "vi": "Kiểm tra; xem xét", "ex_zh": "医生要检查你的身体。", "ex_vi": "Bác sĩ cần kiểm tra cơ thể bạn."}
{"id": "h2-0248", "hv": "Kiến đáo", "pos_vi": "Động từ", "vi": "Nhìn thấy; gặp", "ex_zh": "很高兴见到你。", "ex_vi": "Rất vui được gặp bạn."}
{"id": "h2-0249", "hv": "Kiến quá", "pos_vi": "Động từ", "vi": "Đã từng thấy; từng gặp", "ex_zh": "我以前见过她。", "ex_vi": "Trước đây tôi từng gặp cô ấy."}
{"id": "h2-0250", "hv": "Kiện", "pos_vi": "Lượng từ", "vi": "Cái; chiếc; việc (lượng từ)", "ex_zh": "我买了一件新衣服。", "ex_vi": "Tôi đã mua một chiếc áo mới."}
