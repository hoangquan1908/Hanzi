{"id": "h2-0251", "hv": "Kiện khang", "pos_vi": "Tính từ", "vi": "Khỏe mạnh; sức khỏe", "ex_zh": "我希望你身体健康。", "ex_vi": "Tôi hy vọng bạn khỏe mạnh."}
{"id": "h2-0252", "hv": "Giảng", "pos_vi": "Động từ", "vi": "Nói; giảng giải; bàn bạc", "ex_zh": "老师给我们讲故事。", "ex_vi": "Thầy giáo kể chuyện cho chúng tôi."}
{"id": "h2-0253", "hv": "Giảng thoại", "pos_vi": "Động từ", "vi": "Nói chuyện; phát biểu", "ex_zh": "请大家不要讲话。", "ex_vi": "Mời mọi người đừng nói chuyện."}
{"id": "h2-0254", "hv": "Giao", "pos_vi": "Động từ", "vi": "Nộp; giao; kết giao", "ex_zh": "请把作业交给老师。", "ex_vi": "Hãy nộp bài tập cho thầy giáo."}
{"id": "h2-0255", "hv": "Giao cấp", "pos_vi": "Động từ", "vi": "Giao cho; đưa cho", "ex_zh": "他把钥匙交给了我。", "ex_vi": "Anh ấy đã đưa chìa khóa cho tôi."}
{"id": "h2-0256", "hv": "Giao bằng hữu", "pos_vi": "Động từ", "vi": "Kết bạn", "ex_zh": "我想和他交朋友。", "ex_vi": "Tôi muốn kết bạn với anh ấy."}
{"id": "h2-0257", "hv": "Giao thông", "pos_vi": "Danh từ", "vi": "Giao thông", "ex_zh": "这里的交通很方便。", "ex_vi": "Giao thông ở đây rất thuận tiện."}
{"id": "h2-0258", "hv": "Giác", "pos_vi": "Danh từ", "vi": "Góc; sừng; hào (tiền)", "ex_zh": "他站在桌子的一角。", "ex_vi": "Anh ấy đứng ở một góc bàn."}
{"id": "h2-0259", "hv": "Giác độ", "pos_vi": "Danh từ", "vi": "Góc độ; quan điểm", "ex_zh": "从另一个角度看问题。", "ex_vi": "Nhìn vấn đề từ một góc độ khác."}
{"id": "h2-0260", "hv": "Giảo tử", "pos_vi": "Danh từ", "vi": "Sủi cảo; bánh chẻo", "ex_zh": "我们晚上吃饺子。", "ex_vi": "Buổi tối chúng tôi ăn sủi cảo."}
{"id": "h2-0261", "hv": "Cước", "pos_vi": "Danh từ", "vi": "Chân; bàn chân; chân (đồ vật)", "ex_zh": "我的脚有点儿疼。", "ex_vi": "Chân tôi hơi đau."}
{"id": "h2-0262", "hv": "Khiếu tác", "pos_vi": "Động từ", "vi": "Gọi là; tên là", "ex_zh": "这种水果叫作苹果。", "ex_vi": "Loại quả này gọi là táo."}
{"id": "h2-0263", "hv": "Giáo sư", "pos_vi": "Danh từ", "vi": "Giáo viên", "ex_zh": "她是一名小学教师。", "ex_vi": "Cô ấy là giáo viên tiểu học."}
{"id": "h2-0264", "hv": "Giáo thất", "pos_vi": "Danh từ", "vi": "Phòng học; lớp học", "ex_zh": "教室里有二十个学生。", "ex_vi": "Trong lớp học có hai mươi học sinh."}
{"id": "h2-0265", "hv": "Giáo học", "pos_vi": "Động từ", "vi": "Dạy học; giảng dạy", "ex_zh": "他在大学教学。", "ex_vi": "Anh ấy dạy học ở trường đại học."}
{"id": "h2-0266", "hv": "Giáo dục", "pos_vi": "Danh từ", "vi": "Giáo dục; dạy dỗ", "ex_zh": "父母要重视孩子的教育。", "ex_vi": "Cha mẹ cần coi trọng việc giáo dục con cái."}
{"id": "h2-0267", "hv": "Tiếp", "pos_vi": "Động từ", "vi": "Đón; nhận; nghe (điện thoại)", "ex_zh": "我去机场接朋友。", "ex_vi": "Tôi ra sân bay đón bạn."}
{"id": "h2-0268", "hv": "Tiếp đáo", "pos_vi": "Động từ", "vi": "Nhận được", "ex_zh": "我接到了他的电话。", "ex_vi": "Tôi đã nhận được điện thoại của anh ấy."}
{"id": "h2-0269", "hv": "Tiếp thụ", "pos_vi": "Động từ", "vi": "Tiếp nhận; chấp nhận", "ex_zh": "我接受你的建议。", "ex_vi": "Tôi chấp nhận đề nghị của bạn."}
{"id": "h2-0270", "hv": "Tiếp hạ lai", "pos_vi": "Cụm từ", "vi": "Tiếp theo; sau đây", "ex_zh": "接下来我们去哪儿？", "ex_vi": "Tiếp theo chúng ta đi đâu?"}
{"id": "h2-0271", "hv": "Tiếp trước", "pos_vi": "Phó từ", "vi": "Tiếp đó; tiếp tục", "ex_zh": "他说完，接着唱了一首歌。", "ex_vi": "Nói xong, anh ấy tiếp đó hát một bài."}
{"id": "h2-0272", "hv": "Nhai", "pos_vi": "Danh từ", "vi": "Phố; đường phố", "ex_zh": "街上有很多人。", "ex_vi": "Trên phố có rất nhiều người."}
{"id": "h2-0273", "hv": "Tiết", "pos_vi": "Lượng từ", "vi": "Tiết (học); đốt; lễ tết", "ex_zh": "我们今天有四节课。", "ex_vi": "Hôm nay chúng tôi có bốn tiết học."}
{"id": "h2-0274", "hv": "Tiết mục", "pos_vi": "Danh từ", "vi": "Tiết mục; chương trình", "ex_zh": "这个节目很有意思。", "ex_vi": "Chương trình này rất thú vị."}
{"id": "h2-0275", "hv": "Tiết nhật", "pos_vi": "Danh từ", "vi": "Ngày lễ; ngày hội", "ex_zh": "春节是中国最大的节日。", "ex_vi": "Tết Xuân là ngày lễ lớn nhất của Trung Quốc."}
{"id": "h2-0276", "hv": "Kết quả", "pos_vi": "Danh từ", "vi": "Kết quả; rốt cuộc", "ex_zh": "考试结果怎么样？", "ex_vi": "Kết quả thi thế nào?"}
{"id": "h2-0277", "hv": "Tá", "pos_vi": "Động từ", "vi": "Mượn; cho mượn", "ex_zh": "我想借一本书。", "ex_vi": "Tôi muốn mượn một quyển sách."}
{"id": "h2-0278", "hv": "Kim hậu", "pos_vi": "Danh từ", "vi": "Từ nay về sau; sau này", "ex_zh": "今后我会努力学习。", "ex_vi": "Từ nay về sau tôi sẽ chăm chỉ học."}
{"id": "h2-0279", "hv": "Cân", "pos_vi": "Lượng từ", "vi": "Cân (500g)", "ex_zh": "我买了两斤苹果。", "ex_vi": "Tôi mua hai cân táo."}
{"id": "h2-0280", "hv": "Cận", "pos_vi": "Tính từ", "vi": "Gần; sát", "ex_zh": "我家离学校很近。", "ex_vi": "Nhà tôi gần trường."}
{"id": "h2-0281", "hv": "Tiến nhập", "pos_vi": "Động từ", "vi": "Đi vào; bước vào", "ex_zh": "请进入教室。", "ex_vi": "Mời vào lớp học."}
{"id": "h2-0282", "hv": "Tiến hành", "pos_vi": "Động từ", "vi": "Tiến hành; đang diễn ra", "ex_zh": "会议正在进行。", "ex_vi": "Cuộc họp đang diễn ra."}
{"id": "h2-0283", "hv": "Kinh thường", "pos_vi": "Phó từ", "vi": "Thường xuyên; luôn", "ex_zh": "我经常去图书馆。", "ex_vi": "Tôi thường xuyên đến thư viện."}
{"id": "h2-0284", "hv": "Kinh quá", "pos_vi": "Động từ", "vi": "Đi qua; trải qua; quá trình", "ex_zh": "我每天经过这家商店。", "ex_vi": "Mỗi ngày tôi đều đi qua cửa hàng này."}
{"id": "h2-0285", "hv": "Kinh lý", "pos_vi": "Danh từ", "vi": "Giám đốc; quản lý", "ex_zh": "他是我们公司的经理。", "ex_vi": "Anh ấy là giám đốc công ty chúng tôi."}
{"id": "h2-0286", "hv": "Tửu", "pos_vi": "Danh từ", "vi": "Rượu", "ex_zh": "他不喝酒。", "ex_vi": "Anh ấy không uống rượu."}
{"id": "h2-0287", "hv": "Tửu điếm", "pos_vi": "Danh từ", "vi": "Khách sạn; tiệm rượu", "ex_zh": "我们住在这家酒店。", "ex_vi": "Chúng tôi ở khách sạn này."}
{"id": "h2-0288", "hv": "Tựu yếu", "pos_vi": "Phó từ", "vi": "Sắp; sắp sửa", "ex_zh": "火车就要开了。", "ex_vi": "Tàu hỏa sắp chạy rồi."}
{"id": "h2-0289", "hv": "Cử", "pos_vi": "Động từ", "vi": "Giơ lên; nâng; nêu ra", "ex_zh": "请举起你的手。", "ex_vi": "Hãy giơ tay của bạn lên."}
{"id": "h2-0290", "hv": "Cử thủ", "pos_vi": "Động từ", "vi": "Giơ tay", "ex_zh": "有问题请举手。", "ex_vi": "Có câu hỏi xin hãy giơ tay."}
{"id": "h2-0291", "hv": "Cử hành", "pos_vi": "Động từ", "vi": "Tổ chức; cử hành", "ex_zh": "学校明天举行比赛。", "ex_vi": "Ngày mai trường tổ chức thi đấu."}
{"id": "h2-0292", "hv": "Cú", "pos_vi": "Lượng từ", "vi": "Câu (lượng từ)", "ex_zh": "他说了一句话。", "ex_vi": "Anh ấy nói một câu."}
{"id": "h2-0293", "hv": "Cú tử", "pos_vi": "Danh từ", "vi": "Câu", "ex_zh": "请用这个词造句子。", "ex_vi": "Hãy dùng từ này đặt câu."}
{"id": "h2-0294", "hv": "Tạp", "pos_vi": "Danh từ", "vi": "Thẻ; card; kẹt", "ex_zh": "我有一张银行卡。", "ex_vi": "Tôi có một thẻ ngân hàng."}
{"id": "h2-0295", "hv": "Khai cơ", "pos_vi": "Động từ", "vi": "Bật máy; khởi động", "ex_zh": "手机怎么开机？", "ex_vi": "Điện thoại bật nguồn thế nào?"}
{"id": "h2-0296", "hv": "Khai tâm", "pos_vi": "Tính từ", "vi": "Vui vẻ; vui", "ex_zh": "今天我很开心。", "ex_vi": "Hôm nay tôi rất vui."}
{"id": "h2-0297", "hv": "Khai học", "pos_vi": "Động từ", "vi": "Khai giảng; bắt đầu học kỳ", "ex_zh": "下个星期就要开学了。", "ex_vi": "Tuần sau là khai giảng rồi."}
{"id": "h2-0298", "hv": "Khán pháp", "pos_vi": "Danh từ", "vi": "Cách nhìn; quan điểm", "ex_zh": "你对这件事有什么看法？", "ex_vi": "Bạn nghĩ sao về việc này?"}
{"id": "h2-0299", "hv": "Khảo sinh", "pos_vi": "Danh từ", "vi": "Thí sinh", "ex_zh": "考生们都在教室外面等。", "ex_vi": "Các thí sinh đều đợi bên ngoài phòng học."}
{"id": "h2-0300", "hv": "Kháo", "pos_vi": "Động từ", "vi": "Dựa vào; tựa; gần", "ex_zh": "他靠着窗户站着。", "ex_vi": "Anh ấy đứng dựa vào cửa sổ."}
{"id": "h2-0301", "hv": "Khoa", "pos_vi": "Danh từ", "vi": "Khoa; ngành; bộ môn", "ex_zh": "他在医院的内科工作。", "ex_vi": "Anh ấy làm việc ở khoa nội của bệnh viện."}
{"id": "h2-0302", "hv": "Khoa học", "pos_vi": "Danh từ", "vi": "Khoa học; mang tính khoa học", "ex_zh": "科学让生活更方便。", "ex_vi": "Khoa học làm cuộc sống tiện lợi hơn."}
{"id": "h2-0303", "hv": "Khoa học gia", "pos_vi": "Danh từ", "vi": "Nhà khoa học", "ex_zh": "他想当一名科学家。", "ex_vi": "Cậu ấy muốn trở thành nhà khoa học."}
{"id": "h2-0304", "hv": "Khả ái", "pos_vi": "Tính từ", "vi": "Đáng yêu", "ex_zh": "这只小猫很可爱。", "ex_vi": "Chú mèo con này rất đáng yêu."}
{"id": "h2-0305", "hv": "Khả năng", "pos_vi": "Động từ", "vi": "Có thể; có khả năng", "ex_zh": "明天可能会下雨。", "ex_vi": "Ngày mai có thể sẽ mưa."}
{"id": "h2-0306", "hv": "Khả phạ", "pos_vi": "Tính từ", "vi": "Đáng sợ; kinh khủng", "ex_zh": "这个电影很可怕。", "ex_vi": "Bộ phim này rất đáng sợ."}
{"id": "h2-0307", "hv": "Khả thị", "pos_vi": "Liên từ", "vi": "Nhưng; tuy nhiên", "ex_zh": "我想去，可是没有时间。", "ex_vi": "Tôi muốn đi nhưng không có thời gian."}
{"id": "h2-0308", "hv": "Khả dĩ", "pos_vi": "Động từ", "vi": "Có thể; được phép", "ex_zh": "这里可以照相吗？", "ex_vi": "Ở đây có thể chụp ảnh không?"}
{"id": "h2-0309", "hv": "Khắc", "pos_vi": "Lượng từ", "vi": "Gam; khắc phục", "ex_zh": "这个苹果重二百克。", "ex_vi": "Quả táo này nặng hai trăm gam."}
{"id": "h2-0310", "hv": "Khắc", "pos_vi": "Lượng từ", "vi": "Khắc (15 phút); chạm; khắc", "ex_zh": "现在是三点一刻。", "ex_vi": "Bây giờ là ba giờ mười lăm."}
{"id": "h2-0311", "hv": "Khách nhân", "pos_vi": "Danh từ", "vi": "Khách; vị khách", "ex_zh": "家里来了两位客人。", "ex_vi": "Nhà có hai vị khách đến."}
{"id": "h2-0312", "hv": "Khóa đường", "pos_vi": "Danh từ", "vi": "Lớp học; giờ học", "ex_zh": "课堂上不要说话。", "ex_vi": "Trong giờ học đừng nói chuyện."}
{"id": "h2-0313", "hv": "Không khí", "pos_vi": "Danh từ", "vi": "Không khí", "ex_zh": "这里的空气很好。", "ex_vi": "Không khí ở đây rất tốt."}
{"id": "h2-0314", "hv": "Khốc", "pos_vi": "Động từ", "vi": "Khóc", "ex_zh": "她难过得哭了。", "ex_vi": "Cô ấy buồn đến mức khóc."}
{"id": "h2-0315", "hv": "Khoái xan", "pos_vi": "Danh từ", "vi": "Đồ ăn nhanh", "ex_zh": "我中午常吃快餐。", "ex_vi": "Buổi trưa tôi hay ăn đồ ăn nhanh."}
{"id": "h2-0316", "hv": "Khoái điểm nhi", "pos_vi": "Cụm từ", "vi": "Nhanh lên một chút", "ex_zh": "快点儿，我们要迟到了！", "ex_vi": "Nhanh lên, chúng ta sắp muộn rồi!"}
{"id": "h2-0317", "hv": "Khoái lạc", "pos_vi": "Tính từ", "vi": "Vui vẻ; hạnh phúc", "ex_zh": "祝你生日快乐！", "ex_vi": "Chúc bạn sinh nhật vui vẻ!"}
{"id": "h2-0318", "hv": "Khoái yếu", "pos_vi": "Phó từ", "vi": "Sắp; sắp sửa", "ex_zh": "天快要黑了。", "ex_vi": "Trời sắp tối rồi."}
{"id": "h2-0319", "hv": "Khoái tử", "pos_vi": "Danh từ", "vi": "Đũa", "ex_zh": "你会用筷子吗？", "ex_vi": "Bạn biết dùng đũa không?"}
{"id": "h2-0320", "hv": "Lạp", "pos_vi": "Động từ", "vi": "Kéo; lôi; kéo (đàn)", "ex_zh": "他拉着我的手。", "ex_vi": "Anh ấy nắm kéo tay tôi."}
{"id": "h2-0321", "hv": "Lai tự", "pos_vi": "Động từ", "vi": "Đến từ; xuất phát từ", "ex_zh": "我来自越南。", "ex_vi": "Tôi đến từ Việt Nam."}
{"id": "h2-0322", "hv": "Lam", "pos_vi": "Tính từ", "vi": "Xanh lam; xanh dương", "ex_zh": "天空是蓝的。", "ex_vi": "Bầu trời màu xanh."}
{"id": "h2-0323", "hv": "Lam sắc", "pos_vi": "Danh từ", "vi": "Màu xanh lam", "ex_zh": "我喜欢蓝色的衣服。", "ex_vi": "Tôi thích quần áo màu xanh lam."}
{"id": "h2-0324", "hv": "Lam cầu", "pos_vi": "Danh từ", "vi": "Bóng rổ", "ex_zh": "他喜欢打篮球。", "ex_vi": "Anh ấy thích chơi bóng rổ."}
{"id": "h2-0325", "hv": "Lão niên", "pos_vi": "Danh từ", "vi": "Tuổi già; người cao tuổi", "ex_zh": "爷爷的老年生活很幸福。", "ex_vi": "Cuộc sống tuổi già của ông nội rất hạnh phúc."}
{"id": "h2-0326", "hv": "Lão bằng hữu", "pos_vi": "Danh từ", "vi": "Bạn cũ", "ex_zh": "他是我的老朋友。", "ex_vi": "Anh ấy là bạn cũ của tôi."}
{"id": "h2-0327", "hv": "Lão thị", "pos_vi": "Phó từ", "vi": "Luôn; cứ", "ex_zh": "他老是忘记带钥匙。", "ex_vi": "Anh ấy cứ quên mang chìa khóa."}
{"id": "h2-0328", "hv": "Ly", "pos_vi": "Động từ", "vi": "Cách; rời xa", "ex_zh": "我家离公司很近。", "ex_vi": "Nhà tôi cách công ty rất gần."}
{"id": "h2-0329", "hv": "Ly khai", "pos_vi": "Động từ", "vi": "Rời khỏi; rời đi", "ex_zh": "他已经离开北京了。", "ex_vi": "Anh ấy đã rời Bắc Kinh rồi."}
{"id": "h2-0330", "hv": "Lễ vật", "pos_vi": "Danh từ", "vi": "Quà; quà tặng", "ex_zh": "这是送给你的礼物。", "ex_vi": "Đây là món quà tặng bạn."}
{"id": "h2-0331", "hv": "Lý đầu", "pos_vi": "Danh từ", "vi": "Bên trong", "ex_zh": "盒子里头有什么？", "ex_vi": "Trong hộp có gì?"}
{"id": "h2-0332", "hv": "Lý tưởng", "pos_vi": "Danh từ", "vi": "Lý tưởng; ước mơ; lý tưởng (tt)", "ex_zh": "我的理想是当医生。", "ex_vi": "Ước mơ của tôi là làm bác sĩ."}
{"id": "h2-0333", "hv": "Lệ như", "pos_vi": "Động từ", "vi": "Ví dụ; chẳng hạn", "ex_zh": "我喜欢水果，例如苹果。", "ex_vi": "Tôi thích trái cây, ví dụ như táo."}
{"id": "h2-0334", "hv": "Lệ tử", "pos_vi": "Danh từ", "vi": "Ví dụ", "ex_zh": "请举一个例子。", "ex_vi": "Hãy nêu một ví dụ."}
{"id": "h2-0335", "hv": "Kiểm", "pos_vi": "Danh từ", "vi": "Mặt; khuôn mặt", "ex_zh": "他的脸很红。", "ex_vi": "Mặt anh ấy rất đỏ."}
{"id": "h2-0336", "hv": "Luyện", "pos_vi": "Động từ", "vi": "Luyện; tập", "ex_zh": "他每天都练唱歌。", "ex_vi": "Mỗi ngày anh ấy đều luyện hát."}
{"id": "h2-0337", "hv": "Luyện tập", "pos_vi": "Động từ", "vi": "Luyện tập; bài tập", "ex_zh": "请多练习说汉语。", "ex_vi": "Hãy luyện nói tiếng Trung nhiều hơn."}
{"id": "h2-0338", "hv": "Lương", "pos_vi": "Tính từ", "vi": "Mát; lạnh", "ex_zh": "今天的水有点儿凉。", "ex_vi": "Nước hôm nay hơi lạnh."}
{"id": "h2-0339", "hv": "Lương khoái", "pos_vi": "Tính từ", "vi": "Mát mẻ", "ex_zh": "秋天很凉快。", "ex_vi": "Mùa thu rất mát mẻ."}
{"id": "h2-0340", "hv": "Lượng", "pos_vi": "Tính từ", "vi": "Sáng; sáng sủa", "ex_zh": "这个房间很亮。", "ex_vi": "Căn phòng này rất sáng."}
{"id": "h2-0341", "hv": "Lượng", "pos_vi": "Lượng từ", "vi": "Chiếc (xe)", "ex_zh": "门口有一辆车。", "ex_vi": "Ở cổng có một chiếc xe."}
{"id": "h2-0342", "hv": "Linh hạ", "pos_vi": "Danh từ", "vi": "Dưới không độ", "ex_zh": "今天零下五度。", "ex_vi": "Hôm nay âm năm độ."}
{"id": "h2-0343", "hv": "Lưu", "pos_vi": "Động từ", "vi": "Chảy; lưu truyền", "ex_zh": "河水向东流。", "ex_vi": "Nước sông chảy về phía đông."}
{"id": "h2-0344", "hv": "Lưu lợi", "pos_vi": "Tính từ", "vi": "Lưu loát; trôi chảy", "ex_zh": "她的汉语说得很流利。", "ex_vi": "Cô ấy nói tiếng Trung rất lưu loát."}
{"id": "h2-0345", "hv": "Lưu hành", "pos_vi": "Động từ", "vi": "Thịnh hành; phổ biến; lây lan", "ex_zh": "这首歌现在很流行。", "ex_vi": "Bài hát này bây giờ rất thịnh hành."}
{"id": "h2-0346", "hv": "Lưu", "pos_vi": "Động từ", "vi": "Giữ lại; ở lại; để lại", "ex_zh": "请留个电话号码。", "ex_vi": "Xin để lại một số điện thoại."}
{"id": "h2-0347", "hv": "Lưu hạ", "pos_vi": "Động từ", "vi": "Để lại; ở lại", "ex_zh": "请留下你的名字。", "ex_vi": "Xin để lại tên của bạn."}
{"id": "h2-0348", "hv": "Lưu học sinh", "pos_vi": "Danh từ", "vi": "Du học sinh", "ex_zh": "我们班有三个留学生。", "ex_vi": "Lớp chúng tôi có ba du học sinh."}
{"id": "h2-0349", "hv": "Lộ biên", "pos_vi": "Danh từ", "vi": "Ven đường; lề đường", "ex_zh": "路边有一家小商店。", "ex_vi": "Ven đường có một cửa hàng nhỏ."}
{"id": "h2-0350", "hv": "Lữ khách", "pos_vi": "Danh từ", "vi": "Hành khách; du khách", "ex_zh": "旅客们都上车了。", "ex_vi": "Hành khách đều đã lên xe."}
{"id": "h2-0351", "hv": "Lữ hành", "pos_vi": "Động từ", "vi": "Du lịch; đi chơi xa", "ex_zh": "我喜欢旅行。", "ex_vi": "Tôi thích đi du lịch."}
{"id": "h2-0352", "hv": "Lữ du", "pos_vi": "Động từ", "vi": "Du lịch", "ex_zh": "暑假我们去云南旅游。", "ex_vi": "Kỳ nghỉ hè chúng tôi đi Vân Nam du lịch."}
{"id": "h2-0353", "hv": "Lục", "pos_vi": "Tính từ", "vi": "Xanh lá; xanh", "ex_zh": "树叶都绿了。", "ex_vi": "Lá cây đều xanh rồi."}
{"id": "h2-0354", "hv": "Lục sắc", "pos_vi": "Danh từ", "vi": "Màu xanh lá; xanh", "ex_zh": "绿色对眼睛好。", "ex_vi": "Màu xanh lá tốt cho mắt."}
{"id": "h2-0355", "hv": "Mại", "pos_vi": "Động từ", "vi": "Bán", "ex_zh": "这里卖水果吗？", "ex_vi": "Ở đây có bán trái cây không?"}
{"id": "h2-0356", "hv": "Mãn", "pos_vi": "Tính từ", "vi": "Đầy; đủ", "ex_zh": "杯子里装满了水。", "ex_vi": "Trong cốc đầy nước."}
{"id": "h2-0357", "hv": "Mãn ý", "pos_vi": "Tính từ", "vi": "Hài lòng; vừa ý", "ex_zh": "我对这里很满意。", "ex_vi": "Tôi rất hài lòng về nơi này."}
{"id": "h2-0358", "hv": "Miêu", "pos_vi": "Danh từ", "vi": "Mèo", "ex_zh": "我家有一只猫。", "ex_vi": "Nhà tôi có một con mèo."}
{"id": "h2-0359", "hv": "Mễ", "pos_vi": "Danh từ", "vi": "Gạo; mét", "ex_zh": "他跑了一百米。", "ex_vi": "Anh ấy chạy một trăm mét."}
{"id": "h2-0360", "hv": "Diện", "pos_vi": "Danh từ", "vi": "Mặt; bề mặt; phía; mì", "ex_zh": "桌子上有一碗面。", "ex_vi": "Trên bàn có một bát mì."}
{"id": "h2-0361", "hv": "Diện tiền", "pos_vi": "Danh từ", "vi": "Trước mặt", "ex_zh": "他站在我面前。", "ex_vi": "Anh ấy đứng trước mặt tôi."}
{"id": "h2-0362", "hv": "Danh", "pos_vi": "Danh từ", "vi": "Tên; danh; hạng", "ex_zh": "你叫什么名字？", "ex_vi": "Bạn tên là gì?"}
{"id": "h2-0363", "hv": "Danh xưng", "pos_vi": "Danh từ", "vi": "Tên gọi; tên", "ex_zh": "请写出这个药的名称。", "ex_vi": "Hãy viết ra tên của loại thuốc này."}
{"id": "h2-0364", "hv": "Danh đơn", "pos_vi": "Danh từ", "vi": "Danh sách tên", "ex_zh": "名单上有你的名字。", "ex_vi": "Trong danh sách có tên bạn."}
{"id": "h2-0365", "hv": "Minh tinh", "pos_vi": "Danh từ", "vi": "Ngôi sao; minh tinh", "ex_zh": "她是一个有名的明星。", "ex_vi": "Cô ấy là một ngôi sao nổi tiếng."}
{"id": "h2-0366", "hv": "Mục đích", "pos_vi": "Danh từ", "vi": "Mục đích; mục tiêu", "ex_zh": "你来这里的目的是什么？", "ex_vi": "Mục đích bạn đến đây là gì?"}
{"id": "h2-0367", "hv": "Nã xuất", "pos_vi": "Động từ", "vi": "Lấy ra; đưa ra", "ex_zh": "请拿出你的书。", "ex_vi": "Hãy lấy sách của bạn ra."}
{"id": "h2-0368", "hv": "Nã đáo", "pos_vi": "Động từ", "vi": "Lấy được; nhận được", "ex_zh": "他拿到了第一名。", "ex_vi": "Anh ấy giành được hạng nhất."}
{"id": "h2-0369", "hv": "Na hội nhi", "pos_vi": "Đại từ", "vi": "Lúc đó; khi ấy", "ex_zh": "那会儿我还很小。", "ex_vi": "Lúc đó tôi còn rất nhỏ."}
{"id": "h2-0370", "hv": "Na ma", "pos_vi": "Đại từ", "vi": "Như vậy; thế", "ex_zh": "你为什么那么高兴？", "ex_vi": "Sao bạn vui đến thế?"}
{"id": "h2-0371", "hv": "Na thời", "pos_vi": "Đại từ", "vi": "Lúc đó; khi ấy", "ex_zh": "那时我住在北京。", "ex_vi": "Lúc đó tôi sống ở Bắc Kinh."}
{"id": "h2-0372", "hv": "Na thời hậu", "pos_vi": "Cụm từ", "vi": "Lúc đó; khi ấy", "ex_zh": "那时候没有手机。", "ex_vi": "Hồi đó chưa có điện thoại di động."}
{"id": "h2-0373", "hv": "Na dạng", "pos_vi": "Đại từ", "vi": "Như thế; kiểu đó", "ex_zh": "不要那样说话。", "ex_vi": "Đừng nói chuyện như thế."}
{"id": "h2-0374", "hv": "Nam phương", "pos_vi": "Danh từ", "vi": "Phương nam; miền nam", "ex_zh": "我喜欢南方的冬天。", "ex_vi": "Tôi thích mùa đông ở miền nam."}
{"id": "h2-0375", "hv": "Nan quá", "pos_vi": "Tính từ", "vi": "Buồn; khó chịu; khó khăn", "ex_zh": "听到这个消息，我很难过。", "ex_vi": "Nghe tin này, tôi rất buồn."}
{"id": "h2-0376", "hv": "Nan khán", "pos_vi": "Tính từ", "vi": "Xấu; khó coi", "ex_zh": "这件衣服太难看了。", "ex_vi": "Bộ quần áo này xấu quá."}
