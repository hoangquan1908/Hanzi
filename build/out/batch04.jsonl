{"id": "h1-0505", "hv": "Tọa hạ", "pos_vi": "Động từ", "vi": "Ngồi xuống", "ex_zh": "请坐下，我们开始吧。", "ex_vi": "Mời ngồi xuống, chúng ta bắt đầu nhé."}
{"id": "h1-0506", "hv": "Tố", "pos_vi": "Động từ", "vi": "Làm; thực hiện; nấu", "ex_zh": "妈妈在做饭。", "ex_vi": "Mẹ đang nấu cơm."}
{"id": "h2-0001", "hv": "A", "pos_vi": "Thán từ", "vi": "Ồ; a; à", "ex_zh": "啊，你也在这儿！", "ex_vi": "A, bạn cũng ở đây!"}
{"id": "h2-0002", "hv": "Ái tình", "pos_vi": "Danh từ", "vi": "Tình yêu; ái tình", "ex_zh": "他们的爱情很美。", "ex_vi": "Tình yêu của họ rất đẹp."}
{"id": "h2-0003", "hv": "Ái nhân", "pos_vi": "Danh từ", "vi": "Vợ/chồng; người yêu", "ex_zh": "他的爱人是医生。", "ex_vi": "Vợ anh ấy là bác sĩ."}
{"id": "h2-0004", "hv": "An tĩnh", "pos_vi": "Tính từ", "vi": "Yên tĩnh; im lặng", "ex_zh": "图书馆里很安静。", "ex_vi": "Trong thư viện rất yên tĩnh."}
{"id": "h2-0005", "hv": "An toàn", "pos_vi": "Tính từ", "vi": "An toàn; sự an toàn", "ex_zh": "开车要注意安全。", "ex_vi": "Lái xe phải chú ý an toàn."}
{"id": "h2-0006", "hv": "Bạch sắc", "pos_vi": "Danh từ", "vi": "Màu trắng", "ex_zh": "我喜欢白色的衣服。", "ex_vi": "Tôi thích quần áo màu trắng."}
{"id": "h2-0007", "hv": "Ban trưởng", "pos_vi": "Danh từ", "vi": "Lớp trưởng; tổ trưởng", "ex_zh": "他是我们的班长。", "ex_vi": "Cậu ấy là lớp trưởng của chúng tôi."}
{"id": "h2-0008", "hv": "Biện", "pos_vi": "Động từ", "vi": "Làm; xử lý; lo liệu", "ex_zh": "这件事我来办。", "ex_vi": "Việc này để tôi lo."}
{"id": "h2-0009", "hv": "Biện pháp", "pos_vi": "Danh từ", "vi": "Cách; phương pháp", "ex_zh": "我想到一个好办法。", "ex_vi": "Tôi nghĩ ra một cách hay."}
{"id": "h2-0010", "hv": "Biện công thất", "pos_vi": "Danh từ", "vi": "Văn phòng", "ex_zh": "他在办公室工作。", "ex_vi": "Anh ấy làm việc ở văn phòng."}
{"id": "h2-0011", "hv": "Bán dạ", "pos_vi": "Danh từ", "vi": "Nửa đêm; khuya", "ex_zh": "半夜他突然醒了。", "ex_vi": "Nửa đêm anh ấy đột nhiên tỉnh giấc."}
{"id": "h2-0012", "hv": "Bang trợ", "pos_vi": "Động từ", "vi": "Giúp đỡ; sự giúp đỡ", "ex_zh": "谢谢你帮助我。", "ex_vi": "Cảm ơn bạn đã giúp tôi."}
{"id": "h2-0013", "hv": "Bão", "pos_vi": "Tính từ", "vi": "No; đủ đầy", "ex_zh": "我吃饱了，谢谢。", "ex_vi": "Tôi ăn no rồi, cảm ơn."}
{"id": "h2-0014", "hv": "Báo danh", "pos_vi": "Động từ", "vi": "Đăng ký; ghi danh", "ex_zh": "我想报名学汉语。", "ex_vi": "Tôi muốn đăng ký học tiếng Hán."}
{"id": "h2-0015", "hv": "Báo chỉ", "pos_vi": "Danh từ", "vi": "Báo; tờ báo", "ex_zh": "爸爸每天看报纸。", "ex_vi": "Bố ngày nào cũng đọc báo."}
{"id": "h2-0016", "hv": "Bắc phương", "pos_vi": "Danh từ", "vi": "Phương bắc; miền Bắc", "ex_zh": "我家在中国北方。", "ex_vi": "Nhà tôi ở miền bắc Trung Quốc."}
{"id": "h2-0017", "hv": "Bối", "pos_vi": "Động từ", "vi": "Cõng; đeo; vác", "ex_zh": "他背着一个大包。", "ex_vi": "Anh ấy đeo một cái túi lớn."}
{"id": "h2-0018", "hv": "Tỉ như", "pos_vi": "Động từ", "vi": "Ví dụ; chẳng hạn", "ex_zh": "我喜欢水果，比如苹果。", "ex_vi": "Tôi thích trái cây, ví dụ táo."}
{"id": "h2-0019", "hv": "Tỉ như thuyết", "pos_vi": "Cụm từ", "vi": "Ví dụ; chẳng hạn như", "ex_zh": "比如说，你可以喝茶。", "ex_vi": "Ví dụ, bạn có thể uống trà."}
{"id": "h2-0020", "hv": "Bút", "pos_vi": "Danh từ", "vi": "Bút; cây bút", "ex_zh": "我有一支新笔。", "ex_vi": "Tôi có một cây bút mới."}
{"id": "h2-0021", "hv": "Bút ký", "pos_vi": "Danh từ", "vi": "Ghi chép; vở ghi", "ex_zh": "上课要记笔记。", "ex_vi": "Lên lớp phải ghi chép bài."}
{"id": "h2-0022", "hv": "Bút ký bản", "pos_vi": "Danh từ", "vi": "Vở ghi chép; laptop", "ex_zh": "他买了一台笔记本。", "ex_vi": "Anh ấy mua một cái laptop."}
{"id": "h2-0023", "hv": "Tất tu", "pos_vi": "Phó từ", "vi": "Phải; nhất định phải", "ex_zh": "你必须早点儿睡觉。", "ex_vi": "Bạn phải đi ngủ sớm hơn."}
{"id": "h2-0024", "hv": "Biên", "pos_vi": "Danh từ", "vi": "Bên; cạnh; mép", "ex_zh": "学校旁边有一个店。", "ex_vi": "Bên cạnh trường có một cửa hàng."}
{"id": "h2-0025", "hv": "Biến", "pos_vi": "Động từ", "vi": "Thay đổi; biến đổi", "ex_zh": "这里的天气变了。", "ex_vi": "Thời tiết ở đây đã thay đổi."}
{"id": "h2-0026", "hv": "Biến thành", "pos_vi": "Động từ", "vi": "Biến thành; trở thành", "ex_zh": "天气变成了阴天。", "ex_vi": "Thời tiết đã chuyển thành u ám."}
{"id": "h2-0027", "hv": "Tiện nghi", "pos_vi": "Tính từ", "vi": "Rẻ; tiện lợi", "ex_zh": "这件衣服很便宜。", "ex_vi": "Bộ quần áo này rất rẻ."}
{"id": "h2-0028", "hv": "Biến", "pos_vi": "Lượng từ", "vi": "Lần; lượt (từ đầu đến cuối)", "ex_zh": "请你再说一遍。", "ex_vi": "Mời bạn nói lại một lần nữa."}
{"id": "h2-0029", "hv": "Biểu", "pos_vi": "Danh từ", "vi": "Bảng; đồng hồ; họ hàng bên ngoại", "ex_zh": "请填这张表。", "ex_vi": "Xin hãy điền vào tờ bảng này."}
{"id": "h2-0030", "hv": "Bất thác", "pos_vi": "Tính từ", "vi": "Không tệ; khá tốt", "ex_zh": "这个菜味道不错。", "ex_vi": "Món này vị khá ngon."}
{"id": "h2-0031", "hv": "Bất đãn", "pos_vi": "Liên từ", "vi": "Không chỉ; không những", "ex_zh": "他不但聪明，而且努力。", "ex_vi": "Cậu ấy không những thông minh mà còn chăm chỉ."}
{"id": "h2-0032", "hv": "Bất cấu", "pos_vi": "Tính từ", "vi": "Không đủ", "ex_zh": "我的钱不够了。", "ex_vi": "Tiền của tôi không đủ rồi."}
{"id": "h2-0033", "hv": "Bất quá", "pos_vi": "Liên từ", "vi": "Nhưng; chỉ là; chỉ", "ex_zh": "他不过是个孩子。", "ex_vi": "Nó chẳng qua chỉ là đứa trẻ."}
{"id": "h2-0034", "hv": "Bất hảo ý tư", "pos_vi": "Cụm từ", "vi": "Ngại; xin lỗi; ngượng", "ex_zh": "不好意思，我来晚了。", "ex_vi": "Xin lỗi, tôi đến muộn."}
{"id": "h2-0035", "hv": "Bất cửu", "pos_vi": "Phó từ", "vi": "Không lâu sau; sắp", "ex_zh": "不久他就回来了。", "ex_vi": "Không lâu sau anh ấy đã quay lại."}
{"id": "h2-0036", "hv": "Bất mãn", "pos_vi": "Tính từ", "vi": "Bất mãn; không hài lòng", "ex_zh": "他对工作很不满。", "ex_vi": "Anh ấy rất bất mãn với công việc."}
{"id": "h2-0037", "hv": "Bất như", "pos_vi": "Động từ", "vi": "Không bằng; chi bằng", "ex_zh": "走路不如坐车快。", "ex_vi": "Đi bộ không nhanh bằng đi xe."}
{"id": "h2-0038", "hv": "Bất thiểu", "pos_vi": "Tính từ", "vi": "Khá nhiều; không ít", "ex_zh": "教室里有不少学生。", "ex_vi": "Trong lớp có không ít học sinh."}
{"id": "h2-0039", "hv": "Bất thái", "pos_vi": "Phó từ", "vi": "Không... lắm; không quá", "ex_zh": "今天天气不太好。", "ex_vi": "Hôm nay thời tiết không tốt lắm."}
{"id": "h2-0040", "hv": "Bất đồng", "pos_vi": "Tính từ", "vi": "Khác nhau; không giống", "ex_zh": "我们的想法不同。", "ex_vi": "Suy nghĩ của chúng ta khác nhau."}
{"id": "h2-0041", "hv": "Bất hành", "pos_vi": "Tính từ", "vi": "Không được; không ổn", "ex_zh": "这样做不行。", "ex_vi": "Làm thế này không được."}
{"id": "h2-0042", "hv": "Bất yếu", "pos_vi": "Phó từ", "vi": "Đừng; không được", "ex_zh": "不要在这里玩手机。", "ex_vi": "Đừng chơi điện thoại ở đây."}
{"id": "h2-0043", "hv": "Bất nhất định", "pos_vi": "Cụm từ", "vi": "Chưa chắc; không nhất định", "ex_zh": "他不一定来。", "ex_vi": "Anh ấy chưa chắc sẽ đến."}
{"id": "h2-0044", "hv": "Bất nhất hội nhi", "pos_vi": "Cụm từ", "vi": "Một lát sau; chẳng mấy chốc", "ex_zh": "不一会儿，他就到了。", "ex_vi": "Chẳng mấy chốc anh ấy đã đến."}
{"id": "h2-0045", "hv": "Bộ phận", "pos_vi": "Danh từ", "vi": "Bộ phận; phần", "ex_zh": "这是书的一部分。", "ex_vi": "Đây là một phần của cuốn sách."}
{"id": "h2-0046", "hv": "Tài", "pos_vi": "Phó từ", "vi": "Mới; chỉ mới; tài năng", "ex_zh": "他十点才起床。", "ex_vi": "Mười giờ anh ấy mới dậy."}
{"id": "h2-0047", "hv": "Thái đơn", "pos_vi": "Danh từ", "vi": "Thực đơn", "ex_zh": "请给我看看菜单。", "ex_vi": "Cho tôi xem thực đơn."}
{"id": "h2-0048", "hv": "Tham quan", "pos_vi": "Động từ", "vi": "Tham quan", "ex_zh": "我们去参观博物馆。", "ex_vi": "Chúng tôi đi tham quan bảo tàng."}
{"id": "h2-0049", "hv": "Tham gia", "pos_vi": "Động từ", "vi": "Tham gia; góp mặt", "ex_zh": "你想参加比赛吗？", "ex_vi": "Bạn có muốn tham gia cuộc thi không?"}
{"id": "h2-0050", "hv": "Thảo", "pos_vi": "Danh từ", "vi": "Cỏ", "ex_zh": "草是绿色的。", "ex_vi": "Cỏ có màu xanh lá."}
{"id": "h2-0051", "hv": "Thảo địa", "pos_vi": "Danh từ", "vi": "Bãi cỏ; đồng cỏ", "ex_zh": "孩子们在草地上玩。", "ex_vi": "Bọn trẻ chơi trên bãi cỏ."}
{"id": "h2-0052", "hv": "Tằng", "pos_vi": "Lượng từ", "vi": "Tầng; lớp", "ex_zh": "我家住在五层。", "ex_vi": "Nhà tôi ở tầng năm."}
{"id": "h2-0053", "hv": "Tra", "pos_vi": "Danh từ riêng", "vi": "Họ Tra", "ex_zh": "查先生是我的老师。", "ex_vi": "Ông Tra là thầy giáo của tôi."}
{"id": "h2-0054", "hv": "Sai bất đa", "pos_vi": "Phó từ", "vi": "Gần như; xấp xỉ; tương tự", "ex_zh": "我们差不多大。", "ex_vi": "Chúng tôi xấp xỉ tuổi nhau."}
{"id": "h2-0055", "hv": "Thường kiến", "pos_vi": "Tính từ", "vi": "Thường gặp; phổ biến", "ex_zh": "这是常见的问题。", "ex_vi": "Đây là vấn đề thường gặp."}
{"id": "h2-0056", "hv": "Thường dụng", "pos_vi": "Tính từ", "vi": "Thường dùng", "ex_zh": "这是常用的词。", "ex_vi": "Đây là từ thường dùng."}
{"id": "h2-0057", "hv": "Trường", "pos_vi": "Lượng từ", "vi": "Trận; buổi; cuộc", "ex_zh": "昨天下了一场大雨。", "ex_vi": "Hôm qua có một trận mưa lớn."}
{"id": "h2-0058", "hv": "Siêu quá", "pos_vi": "Động từ", "vi": "Vượt qua; vượt quá", "ex_zh": "他的成绩超过了我。", "ex_vi": "Thành tích của anh ấy vượt tôi."}
{"id": "h2-0059", "hv": "Siêu thị", "pos_vi": "Danh từ", "vi": "Siêu thị", "ex_zh": "我去超市买水果。", "ex_vi": "Tôi đi siêu thị mua trái cây."}
{"id": "h2-0060", "hv": "Xa lượng", "pos_vi": "Danh từ", "vi": "Xe cộ; phương tiện", "ex_zh": "路上的车辆很多。", "ex_vi": "Trên đường có rất nhiều xe cộ."}
{"id": "h2-0061", "hv": "Xưng", "pos_vi": "Động từ", "vi": "Cân; gọi là; vừa vặn", "ex_zh": "请称一下这个苹果。", "ex_vi": "Hãy cân thử quả táo này."}
{"id": "h2-0062", "hv": "Thành", "pos_vi": "Động từ", "vi": "Thành; trở thành; được", "ex_zh": "这件事成了。", "ex_vi": "Việc này thành rồi."}
{"id": "h2-0063", "hv": "Thành tích", "pos_vi": "Danh từ", "vi": "Thành tích; kết quả; điểm", "ex_zh": "他的成绩很好。", "ex_vi": "Thành tích của cậu ấy rất tốt."}
{"id": "h2-0064", "hv": "Thành vi", "pos_vi": "Động từ", "vi": "Trở thành", "ex_zh": "他想成为医生。", "ex_vi": "Cậu ấy muốn trở thành bác sĩ."}
{"id": "h2-0065", "hv": "Xuất phát", "pos_vi": "Động từ", "vi": "Xuất phát; lên đường", "ex_zh": "我们明天早上出发。", "ex_vi": "Sáng mai chúng tôi lên đường."}
{"id": "h2-0066", "hv": "Xuất quốc", "pos_vi": "Động từ", "vi": "Ra nước ngoài", "ex_zh": "他想出国学习。", "ex_vi": "Anh ấy muốn ra nước ngoài học."}
{"id": "h2-0067", "hv": "Xuất khẩu", "pos_vi": "Danh từ", "vi": "Lối ra; cửa ra; xuất khẩu", "ex_zh": "出口在那边。", "ex_vi": "Lối ra ở bên kia."}
{"id": "h2-0068", "hv": "Xuất môn", "pos_vi": "Động từ", "vi": "Ra ngoài; ra khỏi nhà", "ex_zh": "出门要带雨伞。", "ex_vi": "Ra ngoài phải mang theo ô."}
{"id": "h2-0069", "hv": "Xuất sinh", "pos_vi": "Động từ", "vi": "Sinh ra; chào đời", "ex_zh": "他在北京出生。", "ex_vi": "Anh ấy sinh ra ở Bắc Kinh."}
{"id": "h2-0070", "hv": "Xuất hiện", "pos_vi": "Động từ", "vi": "Xuất hiện; nảy sinh", "ex_zh": "他突然出现在门口。", "ex_vi": "Anh ấy đột nhiên xuất hiện ở cửa."}
{"id": "h2-0071", "hv": "Xuất viện", "pos_vi": "Động từ", "vi": "Xuất viện; ra viện", "ex_zh": "爸爸明天出院。", "ex_vi": "Ngày mai bố xuất viện."}
{"id": "h2-0072", "hv": "Xuất tô", "pos_vi": "Động từ", "vi": "Cho thuê", "ex_zh": "这个房子出租。", "ex_vi": "Căn nhà này cho thuê."}
{"id": "h2-0073", "hv": "Xuất tô xa", "pos_vi": "Danh từ", "vi": "Taxi", "ex_zh": "我们坐出租车去吧。", "ex_vi": "Chúng ta đi taxi nhé."}
{"id": "h2-0074", "hv": "Thuyền", "pos_vi": "Danh từ", "vi": "Thuyền; tàu", "ex_zh": "河里有一条船。", "ex_vi": "Trên sông có một chiếc thuyền."}
{"id": "h2-0075", "hv": "Xuy", "pos_vi": "Động từ", "vi": "Thổi; nói khoác", "ex_zh": "风吹得很大。", "ex_vi": "Gió thổi rất mạnh."}
{"id": "h2-0076", "hv": "Xuân tiết", "pos_vi": "Danh từ", "vi": "Tết Nguyên đán; Tết", "ex_zh": "春节我回老家。", "ex_vi": "Tết tôi về quê."}
{"id": "h2-0077", "hv": "Xuân thiên", "pos_vi": "Danh từ", "vi": "Mùa xuân", "ex_zh": "春天花都开了。", "ex_vi": "Mùa xuân hoa đều nở."}
{"id": "h2-0078", "hv": "Từ", "pos_vi": "Danh từ", "vi": "Từ; lời", "ex_zh": "这个词是什么意思？", "ex_vi": "Từ này nghĩa là gì?"}
{"id": "h2-0079", "hv": "Từ điển", "pos_vi": "Danh từ", "vi": "Từ điển", "ex_zh": "我买了一本词典。", "ex_vi": "Tôi đã mua một cuốn từ điển."}
{"id": "h2-0080", "hv": "Từ ngữ", "pos_vi": "Danh từ", "vi": "Từ ngữ; từ vựng", "ex_zh": "这个词语很常用。", "ex_vi": "Từ ngữ này rất thường dùng."}
{"id": "h2-0081", "hv": "Tòng tiểu", "pos_vi": "Phó từ", "vi": "Từ nhỏ; từ bé", "ex_zh": "他从小喜欢画画。", "ex_vi": "Cậu ấy từ nhỏ đã thích vẽ."}
{"id": "h2-0082", "hv": "Đáp ứng", "pos_vi": "Động từ", "vi": "Đồng ý; trả lời; nhận lời", "ex_zh": "他答应帮我的忙。", "ex_vi": "Anh ấy nhận lời giúp tôi."}
{"id": "h2-0083", "hv": "Đả công", "pos_vi": "Động từ", "vi": "Làm thêm; đi làm thuê", "ex_zh": "他在饭馆打工。", "ex_vi": "Anh ấy làm thêm ở quán ăn."}
{"id": "h2-0084", "hv": "Đả toán", "pos_vi": "Động từ", "vi": "Dự định; định", "ex_zh": "你打算去哪儿玩？", "ex_vi": "Bạn định đi chơi đâu?"}
{"id": "h2-0085", "hv": "Đả ấn", "pos_vi": "Động từ", "vi": "In (tài liệu)", "ex_zh": "请帮我打印这个。", "ex_vi": "Xin hãy in giúp tôi cái này."}
{"id": "h2-0086", "hv": "Đại bộ phận", "pos_vi": "Danh từ", "vi": "Phần lớn; đa số", "ex_zh": "大部分学生都来了。", "ex_vi": "Phần lớn học sinh đều đến rồi."}
{"id": "h2-0087", "hv": "Đại đại", "pos_vi": "Phó từ", "vi": "Rất nhiều; to lớn", "ex_zh": "天气大大影响了比赛。", "ex_vi": "Thời tiết ảnh hưởng rất lớn đến trận đấu."}
{"id": "h2-0088", "hv": "Đại đa số", "pos_vi": "Danh từ", "vi": "Đại đa số", "ex_zh": "大多数人都喜欢他。", "ex_vi": "Đại đa số mọi người đều thích anh ấy."}
{"id": "h2-0089", "hv": "Đại hải", "pos_vi": "Danh từ", "vi": "Biển; đại dương", "ex_zh": "我想去看大海。", "ex_vi": "Tôi muốn đi ngắm biển."}
{"id": "h2-0090", "hv": "Đại gia", "pos_vi": "Đại từ", "vi": "Mọi người; cả nhà", "ex_zh": "大家好！", "ex_vi": "Chào mọi người!"}
{"id": "h2-0091", "hv": "Đại lượng", "pos_vi": "Tính từ", "vi": "Số lượng lớn; rất nhiều", "ex_zh": "他喝了大量的水。", "ex_vi": "Anh ấy đã uống rất nhiều nước."}
{"id": "h2-0092", "hv": "Đại môn", "pos_vi": "Danh từ", "vi": "Cổng lớn; cửa chính", "ex_zh": "大门口有一个人。", "ex_vi": "Ở cổng lớn có một người."}
{"id": "h2-0093", "hv": "Đại nhân", "pos_vi": "Danh từ", "vi": "Người lớn; người trưởng thành", "ex_zh": "大人都去上班了。", "ex_vi": "Người lớn đều đi làm rồi."}
{"id": "h2-0094", "hv": "Đại thanh", "pos_vi": "Phó từ", "vi": "To tiếng; lớn tiếng", "ex_zh": "请不要大声说话。", "ex_vi": "Xin đừng nói to tiếng."}
{"id": "h2-0095", "hv": "Đại tiểu", "pos_vi": "Danh từ", "vi": "Kích cỡ; to nhỏ", "ex_zh": "这双鞋大小合适。", "ex_vi": "Đôi giày này cỡ vừa vặn."}
{"id": "h2-0096", "hv": "Đại y", "pos_vi": "Danh từ", "vi": "Áo khoác dài; áo choàng", "ex_zh": "冬天要穿大衣。", "ex_vi": "Mùa đông phải mặc áo khoác dài."}
{"id": "h2-0097", "hv": "Đại tự nhiên", "pos_vi": "Danh từ", "vi": "Thiên nhiên", "ex_zh": "我们要爱护大自然。", "ex_vi": "Chúng ta phải bảo vệ thiên nhiên."}
{"id": "h2-0098", "hv": "Đới", "pos_vi": "Động từ", "vi": "Mang; đeo; dẫn theo", "ex_zh": "出门别忘了带手机。", "ex_vi": "Ra ngoài đừng quên mang điện thoại."}
{"id": "h2-0099", "hv": "Đới lai", "pos_vi": "Động từ", "vi": "Mang lại; đem đến", "ex_zh": "好消息带来了快乐。", "ex_vi": "Tin tốt mang lại niềm vui."}
{"id": "h2-0100", "hv": "Đơn vị", "pos_vi": "Danh từ", "vi": "Đơn vị; cơ quan", "ex_zh": "他在一个大单位工作。", "ex_vi": "Anh ấy làm việc ở một cơ quan lớn."}
{"id": "h2-0101", "hv": "Đãn", "pos_vi": "Liên từ", "vi": "Nhưng; song", "ex_zh": "他很累，但很开心。", "ex_vi": "Anh ấy rất mệt nhưng rất vui."}
{"id": "h2-0102", "hv": "Đãn thị", "pos_vi": "Liên từ", "vi": "Nhưng; tuy nhiên", "ex_zh": "我想去，但是没时间。", "ex_vi": "Tôi muốn đi nhưng không có thời gian."}
{"id": "h2-0103", "hv": "Đản", "pos_vi": "Danh từ", "vi": "Trứng", "ex_zh": "我早上吃了一个蛋。", "ex_vi": "Buổi sáng tôi ăn một quả trứng."}
{"id": "h2-0104", "hv": "Đương", "pos_vi": "Giới từ", "vi": "Khi; đang lúc; làm", "ex_zh": "当我到家时，他在睡觉。", "ex_vi": "Khi tôi về đến nhà, anh ấy đang ngủ."}
{"id": "h2-0105", "hv": "Đương thời", "pos_vi": "Danh từ", "vi": "Lúc đó; khi ấy", "ex_zh": "当时我不在家。", "ex_vi": "Lúc đó tôi không ở nhà."}
{"id": "h2-0106", "hv": "Đáo xử", "pos_vi": "Phó từ", "vi": "Khắp nơi; mọi chỗ", "ex_zh": "城市到处都是人。", "ex_vi": "Trong thành phố đâu đâu cũng là người."}
{"id": "h2-0107", "hv": "Đảo", "pos_vi": "Động từ", "vi": "Ngã; đổ; rót", "ex_zh": "小心，别摔倒。", "ex_vi": "Cẩn thận, đừng ngã."}
{"id": "h2-0108", "hv": "Đạo", "pos_vi": "Danh từ", "vi": "Đường; đạo; lượng từ (món, đề)", "ex_zh": "这道菜很好吃。", "ex_vi": "Món này rất ngon."}
{"id": "h2-0109", "hv": "Đạo lý", "pos_vi": "Danh từ", "vi": "Lẽ phải; đạo lý; lý lẽ", "ex_zh": "他说得有道理。", "ex_vi": "Anh ấy nói có lý."}
{"id": "h2-0110", "hv": "Đạo lộ", "pos_vi": "Danh từ", "vi": "Đường; con đường", "ex_zh": "这条道路很宽。", "ex_vi": "Con đường này rất rộng."}
{"id": "h2-0111", "hv": "Địa cầu", "pos_vi": "Danh từ", "vi": "Trái Đất", "ex_zh": "地球是我们的家。", "ex_vi": "Trái Đất là nhà của chúng ta."}
{"id": "h2-0112", "hv": "Địa thiết", "pos_vi": "Danh từ", "vi": "Tàu điện ngầm", "ex_zh": "我每天坐地铁上班。", "ex_vi": "Mỗi ngày tôi đi tàu điện ngầm đi làm."}
{"id": "h2-0113", "hv": "Địa thiết trạm", "pos_vi": "Danh từ", "vi": "Ga tàu điện ngầm", "ex_zh": "地铁站离这儿很近。", "ex_vi": "Ga tàu điện ngầm cách đây rất gần."}
{"id": "h2-0114", "hv": "Đích thoại", "pos_vi": "Trợ từ", "vi": "Nếu... thì; nếu như", "ex_zh": "下雨的话，我就不去。", "ex_vi": "Nếu trời mưa thì tôi không đi."}
{"id": "h2-0115", "hv": "Đắc", "pos_vi": "Trợ từ", "vi": "Được (trợ từ bổ ngữ); phải", "ex_zh": "他跑得很快。", "ex_vi": "Anh ấy chạy rất nhanh."}
{"id": "h2-0116", "hv": "Đắc xuất", "pos_vi": "Động từ", "vi": "Rút ra; thu được", "ex_zh": "我们得出了答案。", "ex_vi": "Chúng tôi đã rút ra đáp án."}
{"id": "h2-0117", "hv": "Đăng", "pos_vi": "Danh từ", "vi": "Đèn", "ex_zh": "请把灯关上。", "ex_vi": "Làm ơn tắt đèn đi."}
{"id": "h2-0118", "hv": "Đẳng đáo", "pos_vi": "Động từ", "vi": "Đợi đến khi; chờ đến lúc", "ex_zh": "等到天黑，我们再走。", "ex_vi": "Đợi đến tối rồi chúng ta hãy đi."}
{"id": "h2-0119", "hv": "Đẳng ư", "pos_vi": "Động từ", "vi": "Bằng; tương đương", "ex_zh": "二加二等于四。", "ex_vi": "Hai cộng hai bằng bốn."}
{"id": "h2-0120", "hv": "Đê", "pos_vi": "Tính từ", "vi": "Thấp; hạ thấp", "ex_zh": "这个桌子太低了。", "ex_vi": "Cái bàn này thấp quá."}
{"id": "h2-0121", "hv": "Điểm đầu", "pos_vi": "Động từ", "vi": "Gật đầu", "ex_zh": "他笑着点头。", "ex_vi": "Anh ấy cười và gật đầu."}
{"id": "h2-0122", "hv": "Điếm", "pos_vi": "Danh từ", "vi": "Cửa hàng; tiệm", "ex_zh": "这家店的东西很便宜。", "ex_vi": "Đồ ở cửa hàng này rất rẻ."}
{"id": "h2-0123", "hv": "Điệu", "pos_vi": "Động từ", "vi": "Rơi; rớt; mất", "ex_zh": "书掉在地上了。", "ex_vi": "Cuốn sách rơi xuống đất rồi."}
{"id": "h2-0124", "hv": "Đông bắc", "pos_vi": "Danh từ", "vi": "Đông Bắc (Trung Quốc)", "ex_zh": "他来自中国东北。", "ex_vi": "Anh ấy đến từ vùng Đông Bắc Trung Quốc."}
