{"id": "h1-0379", "hv": "Võng thượng", "pos_vi": "Cụm từ", "vi": "Trên mạng; online", "ex_zh": "我喜欢在网上看书。", "ex_vi": "Tôi thích đọc sách trên mạng."}
{"id": "h1-0380", "hv": "Võng hữu", "pos_vi": "Danh từ", "vi": "Bạn qua mạng; cư dân mạng", "ex_zh": "他是我的网友。", "ex_vi": "Anh ấy là bạn qua mạng của tôi."}
{"id": "h1-0381", "hv": "Vong", "pos_vi": "Động từ", "vi": "Quên; bỏ quên", "ex_zh": "我忘了他的名字。", "ex_vi": "Tôi quên tên anh ấy rồi."}
{"id": "h1-0382", "hv": "Vong ký", "pos_vi": "Động từ", "vi": "Quên; không nhớ", "ex_zh": "别忘记你的书。", "ex_vi": "Đừng quên sách của bạn."}
{"id": "h1-0383", "hv": "Vấn", "pos_vi": "Động từ", "vi": "Hỏi; hỏi thăm", "ex_zh": "我想问你一个问题。", "ex_vi": "Tôi muốn hỏi bạn một câu."}
{"id": "h1-0384", "hv": "Ngã", "pos_vi": "Đại từ", "vi": "Tôi; tôi (của tôi)", "ex_zh": "我是学生。", "ex_vi": "Tôi là học sinh."}
{"id": "h1-0385", "hv": "Ngã môn", "pos_vi": "Đại từ", "vi": "Chúng tôi; chúng ta", "ex_zh": "我们都是朋友。", "ex_vi": "Chúng tôi đều là bạn bè."}
{"id": "h1-0386", "hv": "Ngũ", "pos_vi": "Số từ", "vi": "Năm; số 5", "ex_zh": "我有五个朋友。", "ex_vi": "Tôi có năm người bạn."}
{"id": "h1-0387", "hv": "Ngọ phạn", "pos_vi": "Danh từ", "vi": "Bữa trưa; cơm trưa", "ex_zh": "我们一起吃午饭吧。", "ex_vi": "Chúng ta cùng ăn trưa nhé."}
{"id": "h1-0388", "hv": "Tẩy", "pos_vi": "Động từ", "vi": "Rửa; giặt; tắm", "ex_zh": "我要洗衣服。", "ex_vi": "Tôi phải giặt quần áo."}
{"id": "h1-0389", "hv": "Tẩy thủ gian", "pos_vi": "Danh từ", "vi": "Nhà vệ sinh; toilet", "ex_zh": "洗手间在哪儿？", "ex_vi": "Nhà vệ sinh ở đâu?"}
{"id": "h1-0390", "hv": "Hỷ hoan", "pos_vi": "Động từ", "vi": "Thích; yêu thích", "ex_zh": "我喜欢喝茶。", "ex_vi": "Tôi thích uống trà."}
{"id": "h1-0391", "hv": "Tây", "pos_vi": "Danh từ", "vi": "Phía tây; phương Tây", "ex_zh": "太阳从西边下山。", "ex_vi": "Mặt trời lặn ở phía tây."}
{"id": "h1-0392", "hv": "Tây biên", "pos_vi": "Danh từ", "vi": "Phía tây; bên phía tây", "ex_zh": "学校在我家西边。", "ex_vi": "Trường ở phía tây nhà tôi."}
{"id": "h1-0393", "hv": "Hạ", "pos_vi": "Động từ", "vi": "Xuống; dưới; hạ", "ex_zh": "他下楼去了。", "ex_vi": "Anh ấy xuống lầu rồi."}
{"id": "h1-0394", "hv": "Hạ ban", "pos_vi": "Động từ", "vi": "Tan làm; hết giờ làm", "ex_zh": "我六点下班。", "ex_vi": "Sáu giờ tôi tan làm."}
{"id": "h1-0395", "hv": "Hạ biên", "pos_vi": "Danh từ", "vi": "Phía dưới; bên dưới", "ex_zh": "书在桌子下边。", "ex_vi": "Sách ở dưới bàn."}
{"id": "h1-0396", "hv": "Hạ xa", "pos_vi": "Động từ", "vi": "Xuống xe", "ex_zh": "请在前面下车。", "ex_vi": "Xin xuống xe ở phía trước."}
{"id": "h1-0397", "hv": "Hạ thứ", "pos_vi": "Danh từ", "vi": "Lần sau; lần tới", "ex_zh": "下次我请你吃饭。", "ex_vi": "Lần sau tôi mời bạn ăn cơm."}
{"id": "h1-0398", "hv": "Hạ khóa", "pos_vi": "Động từ", "vi": "Tan học; hết giờ học", "ex_zh": "我们十点下课。", "ex_vi": "Mười giờ chúng tôi tan học."}
{"id": "h1-0399", "hv": "Hạ ngọ", "pos_vi": "Danh từ", "vi": "Buổi chiều", "ex_zh": "下午我在家休息。", "ex_vi": "Buổi chiều tôi nghỉ ở nhà."}
{"id": "h1-0400", "hv": "Hạ vũ", "pos_vi": "Động từ", "vi": "Mưa; trời mưa", "ex_zh": "今天下雨了。", "ex_vi": "Hôm nay trời mưa rồi."}
{"id": "h1-0401", "hv": "Tiên", "pos_vi": "Phó từ", "vi": "Trước; trước tiên", "ex_zh": "你先走吧。", "ex_vi": "Bạn đi trước đi."}
{"id": "h1-0402", "hv": "Tiên sinh", "pos_vi": "Danh từ", "vi": "Ông; ngài; thầy; chồng", "ex_zh": "王先生是老师。", "ex_vi": "Ông Vương là giáo viên."}
{"id": "h1-0403", "hv": "Hiện tại", "pos_vi": "Danh từ", "vi": "Bây giờ; hiện nay", "ex_zh": "现在几点了？", "ex_vi": "Bây giờ mấy giờ rồi?"}
{"id": "h1-0404", "hv": "Tưởng", "pos_vi": "Động từ", "vi": "Nghĩ; muốn; nhớ", "ex_zh": "我想去中国。", "ex_vi": "Tôi muốn đi Trung Quốc."}
{"id": "h1-0405", "hv": "Tiểu", "pos_vi": "Tính từ", "vi": "Nhỏ; bé; ít", "ex_zh": "这只猫很小。", "ex_vi": "Con mèo này rất nhỏ."}
{"id": "h1-0406", "hv": "Tiểu hài nhi", "pos_vi": "Danh từ", "vi": "Trẻ con; em bé", "ex_zh": "那个小孩儿很可爱。", "ex_vi": "Đứa bé kia rất đáng yêu."}
{"id": "h1-0407", "hv": "Tiểu thư", "pos_vi": "Danh từ", "vi": "Cô; tiểu thư", "ex_zh": "李小姐是我的同学。", "ex_vi": "Cô Lý là bạn học của tôi."}
{"id": "h1-0408", "hv": "Tiểu bằng hữu", "pos_vi": "Danh từ", "vi": "Bạn nhỏ; em nhỏ; trẻ em", "ex_zh": "小朋友，你叫什么名字？", "ex_vi": "Bạn nhỏ, em tên là gì?"}
{"id": "h1-0409", "hv": "Tiểu thời", "pos_vi": "Danh từ", "vi": "Giờ; tiếng đồng hồ", "ex_zh": "我学习两个小时。", "ex_vi": "Tôi học hai tiếng."}
{"id": "h1-0410", "hv": "Tiểu học", "pos_vi": "Danh từ", "vi": "Tiểu học; trường tiểu học", "ex_zh": "我弟弟在小学学习。", "ex_vi": "Em trai tôi học ở trường tiểu học."}
{"id": "h1-0411", "hv": "Tiểu học sinh", "pos_vi": "Danh từ", "vi": "Học sinh tiểu học", "ex_zh": "他是小学生。", "ex_vi": "Cậu ấy là học sinh tiểu học."}
{"id": "h1-0412", "hv": "Tiếu", "pos_vi": "Động từ", "vi": "Cười", "ex_zh": "她笑得很开心。", "ex_vi": "Cô ấy cười rất vui."}
{"id": "h1-0413", "hv": "Tả", "pos_vi": "Động từ", "vi": "Viết; soạn", "ex_zh": "请写你的名字。", "ex_vi": "Xin hãy viết tên của bạn."}
{"id": "h1-0414", "hv": "Tạ tạ", "pos_vi": "Động từ", "vi": "Cảm ơn", "ex_zh": "谢谢你的帮助！", "ex_vi": "Cảm ơn sự giúp đỡ của bạn!"}
{"id": "h1-0415", "hv": "Tân", "pos_vi": "Tính từ", "vi": "Mới", "ex_zh": "我有一本新书。", "ex_vi": "Tôi có một quyển sách mới."}
{"id": "h1-0416", "hv": "Tân niên", "pos_vi": "Danh từ", "vi": "Năm mới; Tết", "ex_zh": "新年快乐！", "ex_vi": "Chúc mừng năm mới!"}
{"id": "h1-0417", "hv": "Tinh kỳ", "pos_vi": "Danh từ", "vi": "Tuần; thứ trong tuần", "ex_zh": "一个星期有七天。", "ex_vi": "Một tuần có bảy ngày."}
{"id": "h1-0418", "hv": "Tinh kỳ nhật", "pos_vi": "Danh từ", "vi": "Chủ nhật", "ex_zh": "星期日我不上班。", "ex_vi": "Chủ nhật tôi không đi làm."}
{"id": "h1-0419", "hv": "Tinh kỳ thiên", "pos_vi": "Danh từ", "vi": "Chủ nhật", "ex_zh": "星期天我去看爷爷。", "ex_vi": "Chủ nhật tôi đi thăm ông."}
{"id": "h1-0420", "hv": "Hành", "pos_vi": "Tính từ", "vi": "Được; giỏi; hàng; dòng", "ex_zh": "你说得行不行？", "ex_vi": "Bạn nói vậy có được không?"}
{"id": "h1-0421", "hv": "Hưu tức", "pos_vi": "Động từ", "vi": "Nghỉ ngơi", "ex_zh": "你累了，休息一下。", "ex_vi": "Bạn mệt rồi, nghỉ một lát đi."}
{"id": "h1-0422", "hv": "Học", "pos_vi": "Động từ", "vi": "Học; bắt chước", "ex_zh": "我在学中文。", "ex_vi": "Tôi đang học tiếng Trung."}
{"id": "h1-0423", "hv": "Học sinh", "pos_vi": "Danh từ", "vi": "Học sinh", "ex_zh": "这个学生很好。", "ex_vi": "Học sinh này rất giỏi."}
{"id": "h1-0424", "hv": "Học tập", "pos_vi": "Động từ", "vi": "Học tập; học", "ex_zh": "他学习很努力。", "ex_vi": "Anh ấy học tập rất chăm chỉ."}
{"id": "h1-0425", "hv": "Học hiệu", "pos_vi": "Danh từ", "vi": "Trường học", "ex_zh": "我们学校很大。", "ex_vi": "Trường chúng tôi rất lớn."}
{"id": "h1-0426", "hv": "Học viện", "pos_vi": "Danh từ", "vi": "Học viện; cao đẳng", "ex_zh": "他在语言学院学习。", "ex_vi": "Anh ấy học ở học viện ngôn ngữ."}
{"id": "h1-0427", "hv": "Yếu", "pos_vi": "Động từ", "vi": "Muốn; cần; đòi hỏi", "ex_zh": "我要一杯茶。", "ex_vi": "Tôi muốn một ly trà."}
{"id": "h1-0428", "hv": "Dã", "pos_vi": "Phó từ", "vi": "Cũng; cũng vậy", "ex_zh": "我也是学生。", "ex_vi": "Tôi cũng là học sinh."}
{"id": "h1-0429", "hv": "Hiệt", "pos_vi": "Lượng từ", "vi": "Trang (sách); trang giấy", "ex_zh": "请看第五页。", "ex_vi": "Xin xem trang thứ năm."}
{"id": "h1-0430", "hv": "Gia gia", "pos_vi": "Danh từ", "vi": "Ông nội", "ex_zh": "我爷爷七十岁了。", "ex_vi": "Ông nội tôi bảy mươi tuổi rồi."}
{"id": "h1-0431", "hv": "Nhất", "pos_vi": "Số từ", "vi": "Một; đơn; đồng nhất", "ex_zh": "我有一个哥哥。", "ex_vi": "Tôi có một anh trai."}
{"id": "h1-0432", "hv": "Nhất bán", "pos_vi": "Số từ", "vi": "Một nửa; phân nửa", "ex_zh": "我吃了一半。", "ex_vi": "Tôi ăn một nửa rồi."}
{"id": "h1-0433", "hv": "Nhất biên", "pos_vi": "Phó từ", "vi": "Một bên; vừa...vừa...", "ex_zh": "他一边吃饭一边看书。", "ex_vi": "Anh ấy vừa ăn cơm vừa đọc sách."}
{"id": "h1-0434", "hv": "Nhất điểm nhi", "pos_vi": "Cụm từ", "vi": "Một chút; một ít", "ex_zh": "我会说一点儿中文。", "ex_vi": "Tôi biết nói một chút tiếng Trung."}
{"id": "h1-0435", "hv": "Nhất hội nhi", "pos_vi": "Cụm từ", "vi": "Một lát; một lúc", "ex_zh": "请等一会儿。", "ex_vi": "Xin đợi một lát."}
{"id": "h1-0436", "hv": "Nhất khối nhi", "pos_vi": "Phó từ", "vi": "Cùng nhau; một chỗ", "ex_zh": "我们一块儿去吧。", "ex_vi": "Chúng ta cùng đi nhé."}
{"id": "h1-0437", "hv": "Nhất khởi", "pos_vi": "Phó từ", "vi": "Cùng nhau; cùng", "ex_zh": "我和朋友一起吃饭。", "ex_vi": "Tôi ăn cơm cùng bạn."}
{"id": "h1-0438", "hv": "Nhất hạ nhi", "pos_vi": "Cụm từ", "vi": "Một chút; thử một lần", "ex_zh": "请你看一下儿。", "ex_vi": "Mời bạn xem một chút."}
{"id": "h1-0439", "hv": "Nhất ta", "pos_vi": "Lượng từ", "vi": "Một vài; một ít", "ex_zh": "我买了一些水果。", "ex_vi": "Tôi mua một ít trái cây."}
{"id": "h1-0440", "hv": "Nhất dạng", "pos_vi": "Tính từ", "vi": "Giống nhau; như nhau", "ex_zh": "我们的书一样。", "ex_vi": "Sách của chúng tôi giống nhau."}
{"id": "h1-0441", "hv": "Y phục", "pos_vi": "Danh từ", "vi": "Quần áo; y phục", "ex_zh": "这件衣服很漂亮。", "ex_vi": "Cái áo này rất đẹp."}
{"id": "h1-0442", "hv": "Y sinh", "pos_vi": "Danh từ", "vi": "Bác sĩ", "ex_zh": "我妈妈是医生。", "ex_vi": "Mẹ tôi là bác sĩ."}
{"id": "h1-0443", "hv": "Y viện", "pos_vi": "Danh từ", "vi": "Bệnh viện", "ex_zh": "他在医院工作。", "ex_vi": "Anh ấy làm việc ở bệnh viện."}
{"id": "h1-0444", "hv": "Dụng", "pos_vi": "Động từ", "vi": "Dùng; sử dụng", "ex_zh": "我用电脑工作。", "ex_vi": "Tôi dùng máy tính để làm việc."}
{"id": "h1-0445", "hv": "Hữu", "pos_vi": "Động từ", "vi": "Có; có (tồn tại)", "ex_zh": "我有一只小猫。", "ex_vi": "Tôi có một con mèo nhỏ."}
{"id": "h1-0446", "hv": "Hữu đích", "pos_vi": "Đại từ", "vi": "Có (người, cái); một số", "ex_zh": "有的人喜欢喝茶。", "ex_vi": "Có người thích uống trà."}
{"id": "h1-0447", "hv": "Hữu danh", "pos_vi": "Tính từ", "vi": "Nổi tiếng; có tiếng", "ex_zh": "这家饭店很有名。", "ex_vi": "Nhà hàng này rất nổi tiếng."}
{"id": "h1-0448", "hv": "Hữu thời", "pos_vi": "Phó từ", "vi": "Đôi khi; thỉnh thoảng", "ex_zh": "我有时坐公共汽车。", "ex_vi": "Đôi khi tôi đi xe buýt."}
{"id": "h1-0449", "hv": "Hữu thời hậu", "pos_vi": "Phó từ", "vi": "Đôi khi; có lúc", "ex_zh": "他有时候不在家。", "ex_vi": "Có lúc anh ấy không ở nhà."}
{"id": "h1-0450", "hv": "Hữu ta", "pos_vi": "Đại từ", "vi": "Một số; hơi; có chút", "ex_zh": "我有些累了。", "ex_vi": "Tôi hơi mệt rồi."}
{"id": "h1-0451", "hv": "Hữu nhất ta", "pos_vi": "Phó từ", "vi": "Hơi; có chút; một số", "ex_zh": "今天有一些冷。", "ex_vi": "Hôm nay hơi lạnh."}
{"id": "h1-0452", "hv": "Hữu dụng", "pos_vi": "Tính từ", "vi": "Hữu ích; có ích", "ex_zh": "这本书很有用。", "ex_vi": "Quyển sách này rất hữu ích."}
{"id": "h1-0453", "hv": "Hữu", "pos_vi": "Danh từ", "vi": "Bên phải; phải", "ex_zh": "请往右走。", "ex_vi": "Xin đi về bên phải."}
{"id": "h1-0454", "hv": "Hữu biên", "pos_vi": "Danh từ", "vi": "Bên phải; phía phải", "ex_zh": "银行在右边。", "ex_vi": "Ngân hàng ở bên phải."}
{"id": "h1-0455", "hv": "Vũ", "pos_vi": "Danh từ", "vi": "Mưa", "ex_zh": "外面有大雨。", "ex_vi": "Bên ngoài có mưa lớn."}
{"id": "h1-0456", "hv": "Nguyên", "pos_vi": "Lượng từ", "vi": "Đồng (tiền Trung Quốc); nguyên", "ex_zh": "这本书十元。", "ex_vi": "Quyển sách này mười tệ."}
{"id": "h1-0457", "hv": "Viễn", "pos_vi": "Tính từ", "vi": "Xa; xa xôi", "ex_zh": "我家离学校很远。", "ex_vi": "Nhà tôi cách trường rất xa."}
{"id": "h1-0458", "hv": "Nguyệt", "pos_vi": "Danh từ", "vi": "Tháng; mặt trăng", "ex_zh": "一年有十二个月。", "ex_vi": "Một năm có mười hai tháng."}
{"id": "h1-0459", "hv": "Tái", "pos_vi": "Phó từ", "vi": "Lại; nữa; tiếp", "ex_zh": "请再说一遍。", "ex_vi": "Xin nói lại một lần nữa."}
{"id": "h1-0460", "hv": "Tái kiến", "pos_vi": "Động từ", "vi": "Tạm biệt; hẹn gặp lại", "ex_zh": "老师，再见！", "ex_vi": "Chào thầy cô, hẹn gặp lại!"}
{"id": "h1-0461", "hv": "Tại", "pos_vi": "Giới từ", "vi": "Ở; tại; đang", "ex_zh": "我在北京工作。", "ex_vi": "Tôi làm việc ở Bắc Kinh."}
{"id": "h1-0462", "hv": "Tại gia", "pos_vi": "Động từ", "vi": "Ở nhà", "ex_zh": "今天我在家。", "ex_vi": "Hôm nay tôi ở nhà."}
{"id": "h1-0463", "hv": "Tảo", "pos_vi": "Tính từ", "vi": "Sớm; buổi sáng", "ex_zh": "你今天起得真早。", "ex_vi": "Hôm nay bạn dậy sớm thật."}
{"id": "h1-0464", "hv": "Tảo phạn", "pos_vi": "Danh từ", "vi": "Bữa sáng; điểm tâm", "ex_zh": "我每天吃早饭。", "ex_vi": "Mỗi ngày tôi đều ăn sáng."}
{"id": "h1-0465", "hv": "Tảo thượng", "pos_vi": "Danh từ", "vi": "Buổi sáng sớm; sáng", "ex_zh": "我早上六点起床。", "ex_vi": "Sáng sáu giờ tôi dậy."}
{"id": "h1-0466", "hv": "Chẩm ma", "pos_vi": "Đại từ", "vi": "Thế nào; sao; như thế nào", "ex_zh": "你怎么去学校？", "ex_vi": "Bạn đến trường bằng cách nào?"}
{"id": "h1-0467", "hv": "Trạm", "pos_vi": "Động từ", "vi": "Đứng; ga; trạm", "ex_zh": "请站在这儿。", "ex_vi": "Xin hãy đứng ở đây."}
{"id": "h1-0468", "hv": "Trảo", "pos_vi": "Động từ", "vi": "Tìm; tìm kiếm", "ex_zh": "我在找我的手机。", "ex_vi": "Tôi đang tìm điện thoại."}
{"id": "h1-0469", "hv": "Trảo đáo", "pos_vi": "Động từ", "vi": "Tìm thấy; tìm được", "ex_zh": "我找到我的书了。", "ex_vi": "Tôi tìm thấy sách rồi."}
{"id": "h1-0470", "hv": "Giá", "pos_vi": "Đại từ", "vi": "Này; đây", "ex_zh": "这是我的朋友。", "ex_vi": "Đây là bạn của tôi."}
{"id": "h1-0471", "hv": "Giá biên", "pos_vi": "Đại từ", "vi": "Bên này; ở đây", "ex_zh": "请到这边来。", "ex_vi": "Mời đến bên này."}
{"id": "h1-0472", "hv": "Giá nhi", "pos_vi": "Đại từ", "vi": "Ở đây; chỗ này", "ex_zh": "我就住在这儿。", "ex_vi": "Tôi sống ngay ở đây."}
{"id": "h1-0473", "hv": "Giá lý", "pos_vi": "Đại từ", "vi": "Ở đây; chỗ này", "ex_zh": "这里有很多人。", "ex_vi": "Ở đây có rất nhiều người."}
{"id": "h1-0474", "hv": "Giá ta", "pos_vi": "Đại từ", "vi": "Những cái này; những", "ex_zh": "这些书都是我的。", "ex_vi": "Những quyển sách này đều là của tôi."}
{"id": "h1-0475", "hv": "Trước", "pos_vi": "Động từ", "vi": "Nước cờ; bước; mưu", "ex_zh": "这一着很好。", "ex_vi": "Nước đi này rất hay."}
{"id": "h1-0476", "hv": "Chân", "pos_vi": "Phó từ", "vi": "Thật; thật sự", "ex_zh": "这个菜真好吃！", "ex_vi": "Món này ngon thật!"}
{"id": "h1-0477", "hv": "Chân đích", "pos_vi": "Phó từ", "vi": "Thật sự; thực sự", "ex_zh": "你真的要走吗？", "ex_vi": "Bạn thật sự muốn đi à?"}
{"id": "h1-0478", "hv": "Chính", "pos_vi": "Phó từ", "vi": "Chính; tháng giêng; đúng", "ex_zh": "正月是一年的开始。", "ex_vi": "Tháng giêng là đầu năm."}
{"id": "h1-0479", "hv": "Chính tại", "pos_vi": "Phó từ", "vi": "Đang; đang lúc", "ex_zh": "他正在看电视。", "ex_vi": "Anh ấy đang xem ti vi."}
{"id": "h1-0480", "hv": "Tri đạo", "pos_vi": "Động từ", "vi": "Biết; hiểu", "ex_zh": "我不知道他是谁。", "ex_vi": "Tôi không biết anh ấy là ai."}
{"id": "h1-0481", "hv": "Tri thức", "pos_vi": "Danh từ", "vi": "Tri thức; kiến thức", "ex_zh": "书里有很多知识。", "ex_vi": "Trong sách có nhiều kiến thức."}
{"id": "h1-0482", "hv": "Trung", "pos_vi": "Danh từ", "vi": "Giữa; trong; Trung Quốc", "ex_zh": "他住在中国。", "ex_vi": "Anh ấy sống ở Trung Quốc."}
{"id": "h1-0483", "hv": "Trung quốc", "pos_vi": "Danh từ riêng", "vi": "Trung Quốc", "ex_zh": "我想去中国学习。", "ex_vi": "Tôi muốn đến Trung Quốc học."}
{"id": "h1-0484", "hv": "Trung gian", "pos_vi": "Danh từ", "vi": "Ở giữa; chính giữa", "ex_zh": "他坐在我们中间。", "ex_vi": "Anh ấy ngồi giữa chúng tôi."}
{"id": "h1-0485", "hv": "Trung văn", "pos_vi": "Danh từ", "vi": "Tiếng Trung; Hán ngữ", "ex_zh": "我在学中文。", "ex_vi": "Tôi đang học tiếng Trung."}
{"id": "h1-0486", "hv": "Trung ngọ", "pos_vi": "Danh từ", "vi": "Buổi trưa", "ex_zh": "中午我们一起吃饭。", "ex_vi": "Buổi trưa chúng ta cùng ăn cơm."}
{"id": "h1-0487", "hv": "Trung học", "pos_vi": "Danh từ", "vi": "Trung học", "ex_zh": "我哥哥在中学工作。", "ex_vi": "Anh trai tôi làm việc ở trường trung học."}
{"id": "h1-0488", "hv": "Trung học sinh", "pos_vi": "Danh từ", "vi": "Học sinh trung học", "ex_zh": "她是中学生。", "ex_vi": "Cô ấy là học sinh trung học."}
{"id": "h1-0489", "hv": "Trùng", "pos_vi": "Phó từ", "vi": "Lại; lặp lại; nhắc lại", "ex_zh": "请重说一遍。", "ex_vi": "Xin nói lại một lần."}
{"id": "h1-0490", "hv": "Trọng yếu", "pos_vi": "Tính từ", "vi": "Quan trọng; trọng yếu", "ex_zh": "这件事很重要。", "ex_vi": "Việc này rất quan trọng."}
{"id": "h1-0491", "hv": "Trú", "pos_vi": "Động từ", "vi": "Ở; sống; trọ", "ex_zh": "我住在河内。", "ex_vi": "Tôi sống ở Hà Nội."}
{"id": "h1-0492", "hv": "Chuẩn bị", "pos_vi": "Động từ", "vi": "Chuẩn bị; định", "ex_zh": "我在准备晚饭。", "ex_vi": "Tôi đang chuẩn bị bữa tối."}
{"id": "h1-0493", "hv": "Trác tử", "pos_vi": "Danh từ", "vi": "Cái bàn", "ex_zh": "桌子上有一本书。", "ex_vi": "Trên bàn có một quyển sách."}
{"id": "h1-0494", "hv": "Tự", "pos_vi": "Danh từ", "vi": "Chữ; chữ viết", "ex_zh": "这个字怎么写？", "ex_vi": "Chữ này viết thế nào?"}
{"id": "h1-0495", "hv": "Tử", "pos_vi": "Danh từ", "vi": "Con; hạt; hậu tố danh từ", "ex_zh": "他有两个儿子。", "ex_vi": "Anh ấy có hai người con trai."}
{"id": "h1-0496", "hv": "Tẩu", "pos_vi": "Động từ", "vi": "Đi; đi bộ; rời đi", "ex_zh": "我们走吧。", "ex_vi": "Chúng ta đi thôi."}
{"id": "h1-0497", "hv": "Tẩu lộ", "pos_vi": "Động từ", "vi": "Đi bộ", "ex_zh": "我每天走路上班。", "ex_vi": "Mỗi ngày tôi đi bộ đi làm."}
{"id": "h1-0498", "hv": "Tối", "pos_vi": "Phó từ", "vi": "Nhất; nhất (mức cao nhất)", "ex_zh": "我最喜欢苹果。", "ex_vi": "Tôi thích táo nhất."}
{"id": "h1-0499", "hv": "Tối hảo", "pos_vi": "Phó từ", "vi": "Tốt nhất; tốt hơn hết", "ex_zh": "你最好早点儿睡。", "ex_vi": "Tốt nhất bạn nên ngủ sớm."}
{"id": "h1-0500", "hv": "Tối hậu", "pos_vi": "Danh từ", "vi": "Cuối cùng; sau cùng", "ex_zh": "最后他笑了。", "ex_vi": "Cuối cùng anh ấy đã cười."}
{"id": "h1-0501", "hv": "Tạc thiên", "pos_vi": "Danh từ", "vi": "Hôm qua", "ex_zh": "昨天我去商店了。", "ex_vi": "Hôm qua tôi đi cửa hàng."}
{"id": "h1-0502", "hv": "Tả", "pos_vi": "Danh từ", "vi": "Trái; bên trái", "ex_zh": "请往左走。", "ex_vi": "Xin đi về bên trái."}
{"id": "h1-0503", "hv": "Tả biên", "pos_vi": "Danh từ", "vi": "Bên trái; phía trái", "ex_zh": "书在桌子左边。", "ex_vi": "Sách ở bên trái cái bàn."}
{"id": "h1-0504", "hv": "Tọa", "pos_vi": "Động từ", "vi": "Ngồi; đi (xe)", "ex_zh": "请坐，喝杯茶。", "ex_vi": "Mời ngồi, uống ly trà."}
