{"id": "h2-0377", "hv": "Nan thụ", "pos_vi": "Tính từ", "vi": "Khó chịu; buồn; đau khổ", "ex_zh": "我头疼，很难受。", "ex_vi": "Tôi đau đầu, rất khó chịu."}
{"id": "h2-0378", "hv": "Nan đề", "pos_vi": "Danh từ", "vi": "Câu hỏi khó; vấn đề nan giải", "ex_zh": "这个难题我不会做。", "ex_vi": "Bài khó này tôi không biết làm."}
{"id": "h2-0379", "hv": "Nan thính", "pos_vi": "Tính từ", "vi": "Khó nghe; chói tai", "ex_zh": "他唱的歌很难听。", "ex_vi": "Bài hát anh ấy hát rất khó nghe."}
{"id": "h2-0380", "hv": "Năng cấu", "pos_vi": "Động từ", "vi": "Có thể; có khả năng", "ex_zh": "你能够帮我吗？", "ex_vi": "Bạn có thể giúp tôi không?"}
{"id": "h2-0381", "hv": "Niên cấp", "pos_vi": "Danh từ", "vi": "Lớp; khối lớp", "ex_zh": "你上几年级？", "ex_vi": "Bạn học lớp mấy?"}
{"id": "h2-0382", "hv": "Niên khinh", "pos_vi": "Tính từ", "vi": "Trẻ; trẻ tuổi", "ex_zh": "她看起来很年轻。", "ex_vi": "Cô ấy trông rất trẻ."}
{"id": "h2-0383", "hv": "Điểu", "pos_vi": "Danh từ", "vi": "Chim", "ex_zh": "树上有一只鸟。", "ex_vi": "Trên cây có một con chim."}
{"id": "h2-0384", "hv": "Lộng", "pos_vi": "Động từ", "vi": "Làm; chơi; xoay xở; ngõ", "ex_zh": "别把水弄到地上。", "ex_vi": "Đừng làm nước đổ xuống đất."}
{"id": "h2-0385", "hv": "Nỗ lực", "pos_vi": "Động từ", "vi": "Nỗ lực; cố gắng; chăm chỉ", "ex_zh": "他学习很努力。", "ex_vi": "Anh ấy học tập rất chăm chỉ."}
{"id": "h2-0386", "hv": "Ba", "pos_vi": "Động từ", "vi": "Bò; leo; trèo", "ex_zh": "小孩子在地上爬。", "ex_vi": "Em bé đang bò trên sàn."}
{"id": "h2-0387", "hv": "Ba sơn", "pos_vi": "Động từ", "vi": "Leo núi", "ex_zh": "周末我们去爬山。", "ex_vi": "Cuối tuần chúng tôi đi leo núi."}
{"id": "h2-0388", "hv": "Phạ", "pos_vi": "Động từ", "vi": "Sợ; e rằng; lo", "ex_zh": "我怕黑，不敢一个人睡。", "ex_vi": "Tôi sợ bóng tối, không dám ngủ một mình."}
{"id": "h2-0389", "hv": "Bài", "pos_vi": "Động từ", "vi": "Hàng; dãy; xếp; sắp xếp", "ex_zh": "我们坐在第一排。", "ex_vi": "Chúng tôi ngồi ở hàng đầu."}
{"id": "h2-0390", "hv": "Bài đội", "pos_vi": "Động từ", "vi": "Xếp hàng", "ex_zh": "请大家排队上车。", "ex_vi": "Mời mọi người xếp hàng lên xe."}
{"id": "h2-0391", "hv": "Bài cầu", "pos_vi": "Danh từ", "vi": "Bóng chuyền", "ex_zh": "他很喜欢打排球。", "ex_vi": "Anh ấy rất thích chơi bóng chuyền."}
{"id": "h2-0392", "hv": "Bính", "pos_vi": "Động từ", "vi": "Va; đụng; chạm", "ex_zh": "小心，别碰那个杯子。", "ex_vi": "Cẩn thận, đừng đụng vào cái cốc đó."}
{"id": "h2-0393", "hv": "Bính đáo", "pos_vi": "Động từ", "vi": "Gặp phải; tình cờ gặp", "ex_zh": "我在路上碰到老师了。", "ex_vi": "Tôi tình cờ gặp thầy giáo trên đường."}
{"id": "h2-0394", "hv": "Bính kiến", "pos_vi": "Động từ", "vi": "Tình cờ gặp; gặp bất ngờ", "ex_zh": "昨天我碰见了老朋友。", "ex_vi": "Hôm qua tôi tình cờ gặp bạn cũ."}
{"id": "h2-0395", "hv": "Thiên", "pos_vi": "Lượng từ", "vi": "Bài; bài viết (lượng từ)", "ex_zh": "我写了一篇文章。", "ex_vi": "Tôi đã viết một bài văn."}
{"id": "h2-0396", "hv": "Phiến", "pos_vi": "Lượng từ", "vi": "Miếng; tấm; lát", "ex_zh": "请给我一片面包。", "ex_vi": "Làm ơn cho tôi một lát bánh mì."}
{"id": "h2-0397", "hv": "Phiêu lượng", "pos_vi": "Tính từ", "vi": "Đẹp; xinh đẹp", "ex_zh": "你的新衣服很漂亮。", "ex_vi": "Bộ quần áo mới của bạn rất đẹp."}
{"id": "h2-0398", "hv": "Bình", "pos_vi": "Tính từ", "vi": "Bằng phẳng; ngang bằng; bình thường", "ex_zh": "这条路很平。", "ex_vi": "Con đường này rất bằng phẳng."}
{"id": "h2-0399", "hv": "Bình an", "pos_vi": "Tính từ", "vi": "Bình an; an toàn", "ex_zh": "祝你一路平安！", "ex_vi": "Chúc bạn thượng lộ bình an!"}
{"id": "h2-0400", "hv": "Bình thường", "pos_vi": "Tính từ", "vi": "Bình thường; thường ngày", "ex_zh": "今天是很平常的一天。", "ex_vi": "Hôm nay là một ngày rất bình thường."}
{"id": "h2-0401", "hv": "Bình đẳng", "pos_vi": "Tính từ", "vi": "Bình đẳng", "ex_zh": "男女应该平等。", "ex_vi": "Nam nữ nên bình đẳng."}
{"id": "h2-0402", "hv": "Bình thời", "pos_vi": "Danh từ", "vi": "Ngày thường; lúc bình thường", "ex_zh": "我平时六点起床。", "ex_vi": "Ngày thường tôi dậy lúc sáu giờ."}
{"id": "h2-0403", "hv": "Bình", "pos_vi": "Lượng từ", "vi": "Chai; bình; lọ", "ex_zh": "我想买一瓶水。", "ex_vi": "Tôi muốn mua một chai nước."}
{"id": "h2-0404", "hv": "Bình tử", "pos_vi": "Danh từ", "vi": "Cái chai; cái bình", "ex_zh": "瓶子里有牛奶。", "ex_vi": "Trong chai có sữa."}
{"id": "h2-0405", "hv": "Phổ thông", "pos_vi": "Tính từ", "vi": "Phổ thông; bình thường; thông thường", "ex_zh": "他是一个普通学生。", "ex_vi": "Cậu ấy là một học sinh bình thường."}
{"id": "h2-0406", "hv": "Phổ thông thoại", "pos_vi": "Danh từ", "vi": "Tiếng phổ thông (tiếng Trung chuẩn)", "ex_zh": "她的普通话说得很好。", "ex_vi": "Cô ấy nói tiếng phổ thông rất tốt."}
{"id": "h2-0407", "hv": "Kỳ tha", "pos_vi": "Đại từ", "vi": "Khác; còn lại", "ex_zh": "其他人都回家了。", "ex_vi": "Những người khác đều về nhà rồi."}
{"id": "h2-0408", "hv": "Kỳ trung", "pos_vi": "Đại từ", "vi": "Trong đó; trong số đó", "ex_zh": "我们班有二十人，其中十人是女生。", "ex_vi": "Lớp có hai mươi người, trong đó mười người là nữ."}
{"id": "h2-0409", "hv": "Kị", "pos_vi": "Động từ", "vi": "Cưỡi; đi (xe đạp, xe máy)", "ex_zh": "他会骑马。", "ex_vi": "Anh ấy biết cưỡi ngựa."}
{"id": "h2-0410", "hv": "Kị xa", "pos_vi": "Động từ", "vi": "Đi xe đạp; đi xe máy", "ex_zh": "我每天骑车上班。", "ex_vi": "Mỗi ngày tôi đi xe đạp đi làm."}
{"id": "h2-0411", "hv": "Khởi phi", "pos_vi": "Động từ", "vi": "Cất cánh", "ex_zh": "飞机马上就要起飞了。", "ex_vi": "Máy bay sắp cất cánh rồi."}
{"id": "h2-0412", "hv": "Khí", "pos_vi": "Danh từ", "vi": "Khí; hơi; không khí; giận", "ex_zh": "轮胎里没有气了。", "ex_vi": "Trong lốp xe hết hơi rồi."}
{"id": "h2-0413", "hv": "Khí ôn", "pos_vi": "Danh từ", "vi": "Nhiệt độ không khí", "ex_zh": "今天的气温很高。", "ex_vi": "Nhiệt độ hôm nay rất cao."}
{"id": "h2-0414", "hv": "Thiên", "pos_vi": "Số từ", "vi": "Nghìn; một nghìn", "ex_zh": "这本书有一千页。", "ex_vi": "Quyển sách này có một nghìn trang."}
{"id": "h2-0415", "hv": "Thiên khắc", "pos_vi": "Lượng từ", "vi": "Ki-lô-gam; cân", "ex_zh": "我买了两千克苹果。", "ex_vi": "Tôi mua hai ki-lô-gam táo."}
{"id": "h2-0416", "hv": "Tiền niên", "pos_vi": "Danh từ", "vi": "Năm kia", "ex_zh": "我前年去过北京。", "ex_vi": "Năm kia tôi đã đến Bắc Kinh."}
{"id": "h2-0417", "hv": "Tường", "pos_vi": "Danh từ", "vi": "Tường; bức tường", "ex_zh": "墙上挂着一张地图。", "ex_vi": "Trên tường treo một tấm bản đồ."}
{"id": "h2-0418", "hv": "Thanh niên", "pos_vi": "Danh từ", "vi": "Thanh niên; tuổi trẻ", "ex_zh": "青年人应该多读书。", "ex_vi": "Thanh niên nên đọc nhiều sách."}
{"id": "h2-0419", "hv": "Thanh thiếu niên", "pos_vi": "Danh từ", "vi": "Thanh thiếu niên", "ex_zh": "这本书适合青少年看。", "ex_vi": "Cuốn sách này phù hợp cho thanh thiếu niên."}
{"id": "h2-0420", "hv": "Khinh", "pos_vi": "Tính từ", "vi": "Nhẹ; nhẹ nhàng; dễ", "ex_zh": "这个包很轻。", "ex_vi": "Cái túi này rất nhẹ."}
{"id": "h2-0421", "hv": "Thanh sở", "pos_vi": "Tính từ", "vi": "Rõ ràng; hiểu rõ", "ex_zh": "你听清楚了吗？", "ex_vi": "Bạn nghe rõ chưa?"}
{"id": "h2-0422", "hv": "Tình", "pos_vi": "Tính từ", "vi": "Trời quang; nắng ráo", "ex_zh": "天晴了，我们出去玩吧。", "ex_vi": "Trời quang rồi, chúng ta ra ngoài chơi đi."}
{"id": "h2-0423", "hv": "Tình thiên", "pos_vi": "Danh từ", "vi": "Trời nắng; trời quang", "ex_zh": "晴天的时候我喜欢跑步。", "ex_vi": "Lúc trời nắng tôi thích chạy bộ."}
{"id": "h2-0424", "hv": "Thỉnh khách", "pos_vi": "Động từ", "vi": "Mời khách; chiêu đãi", "ex_zh": "今天我请客。", "ex_vi": "Hôm nay tôi mời."}
{"id": "h2-0425", "hv": "Thỉnh cầu", "pos_vi": "Động từ", "vi": "Yêu cầu; thỉnh cầu; lời thỉnh cầu", "ex_zh": "他请求老师再给一次机会。", "ex_vi": "Cậu ấy xin thầy cho thêm một cơ hội."}
{"id": "h2-0426", "hv": "Thu thiên", "pos_vi": "Danh từ", "vi": "Mùa thu", "ex_zh": "秋天的天气很舒服。", "ex_vi": "Thời tiết mùa thu rất dễ chịu."}
{"id": "h2-0427", "hv": "Cầu", "pos_vi": "Động từ", "vi": "Cầu; xin; tìm kiếm", "ex_zh": "我求你帮帮我。", "ex_vi": "Tôi xin bạn giúp tôi."}
{"id": "h2-0428", "hv": "Cầu trường", "pos_vi": "Danh từ", "vi": "Sân bóng; sân vận động", "ex_zh": "球场上有很多人。", "ex_vi": "Trên sân bóng có rất nhiều người."}
{"id": "h2-0429", "hv": "Cầu đội", "pos_vi": "Danh từ", "vi": "Đội bóng", "ex_zh": "我们的球队赢了。", "ex_vi": "Đội bóng của chúng tôi thắng rồi."}
{"id": "h2-0430", "hv": "Cầu hài", "pos_vi": "Danh từ", "vi": "Giày thể thao", "ex_zh": "我想买一双新球鞋。", "ex_vi": "Tôi muốn mua một đôi giày thể thao mới."}
{"id": "h2-0431", "hv": "Thủ", "pos_vi": "Động từ", "vi": "Lấy; nhận; chọn", "ex_zh": "请去前台取钥匙。", "ex_vi": "Xin đến quầy lễ tân lấy chìa khóa."}
{"id": "h2-0432", "hv": "Thủ đắc", "pos_vi": "Động từ", "vi": "Đạt được; giành được", "ex_zh": "他取得了很好的成绩。", "ex_vi": "Cậu ấy đạt được thành tích rất tốt."}
{"id": "h2-0433", "hv": "Toàn", "pos_vi": "Phó từ", "vi": "Toàn; tất cả; đầy đủ", "ex_zh": "他全忘了。", "ex_vi": "Anh ấy quên hết cả rồi."}
{"id": "h2-0434", "hv": "Toàn bộ", "pos_vi": "Danh từ", "vi": "Toàn bộ; tất cả", "ex_zh": "这全部是我的书。", "ex_vi": "Tất cả những thứ này là sách của tôi."}
{"id": "h2-0435", "hv": "Toàn quốc", "pos_vi": "Danh từ", "vi": "Toàn quốc; cả nước", "ex_zh": "全国人民都很高兴。", "ex_vi": "Nhân dân cả nước đều rất vui."}
{"id": "h2-0436", "hv": "Toàn gia", "pos_vi": "Danh từ", "vi": "Cả nhà; cả gia đình", "ex_zh": "春节我们全家一起吃饭。", "ex_vi": "Tết cả nhà chúng tôi cùng ăn cơm."}
{"id": "h2-0437", "hv": "Toàn niên", "pos_vi": "Danh từ", "vi": "Cả năm", "ex_zh": "他全年都在工作。", "ex_vi": "Anh ấy làm việc suốt cả năm."}
{"id": "h2-0438", "hv": "Toàn thân", "pos_vi": "Danh từ", "vi": "Toàn thân; cả người", "ex_zh": "跑完步，我全身都是汗。", "ex_vi": "Chạy xong, cả người tôi đầy mồ hôi."}
{"id": "h2-0439", "hv": "Toàn thể", "pos_vi": "Danh từ", "vi": "Toàn thể; tất cả mọi người", "ex_zh": "全体同学请站起来。", "ex_vi": "Toàn thể các bạn học sinh xin đứng lên."}
{"id": "h2-0440", "hv": "Nhiên hậu", "pos_vi": "Liên từ", "vi": "Sau đó; rồi thì", "ex_zh": "先吃饭，然后看电视。", "ex_vi": "Ăn cơm trước, sau đó xem tivi."}
{"id": "h2-0441", "hv": "Nhượng", "pos_vi": "Động từ", "vi": "Nhường; để; bảo; cho phép", "ex_zh": "妈妈让我早点儿睡。", "ex_vi": "Mẹ bảo tôi đi ngủ sớm một chút."}
{"id": "h2-0442", "hv": "Nhiệt tình", "pos_vi": "Tính từ", "vi": "Nhiệt tình; nồng nhiệt", "ex_zh": "老师对学生很热情。", "ex_vi": "Thầy giáo rất nhiệt tình với học sinh."}
{"id": "h2-0443", "hv": "Nhân khẩu", "pos_vi": "Danh từ", "vi": "Dân số; nhân khẩu", "ex_zh": "这个城市人口很多。", "ex_vi": "Thành phố này có dân số rất đông."}
{"id": "h2-0444", "hv": "Nhân môn", "pos_vi": "Danh từ", "vi": "Mọi người; người ta", "ex_zh": "人们都喜欢好天气。", "ex_vi": "Mọi người đều thích thời tiết đẹp."}
{"id": "h2-0445", "hv": "Nhân số", "pos_vi": "Danh từ", "vi": "Số người; quân số", "ex_zh": "今天来的人数不多。", "ex_vi": "Số người đến hôm nay không nhiều."}
{"id": "h2-0446", "hv": "Nhận vi", "pos_vi": "Động từ", "vi": "Cho rằng; nghĩ rằng", "ex_zh": "我认为这个办法很好。", "ex_vi": "Tôi cho rằng cách này rất tốt."}
{"id": "h2-0447", "hv": "Nhật báo", "pos_vi": "Danh từ", "vi": "Nhật báo; báo hằng ngày", "ex_zh": "爸爸每天看日报。", "ex_vi": "Bố ngày nào cũng đọc báo."}
{"id": "h2-0448", "hv": "Nhật tử", "pos_vi": "Danh từ", "vi": "Ngày; ngày tháng; cuộc sống", "ex_zh": "今天是个好日子。", "ex_vi": "Hôm nay là một ngày tốt."}
{"id": "h2-0449", "hv": "Như quả", "pos_vi": "Liên từ", "vi": "Nếu; nếu như", "ex_zh": "如果明天下雨，我就不去。", "ex_vi": "Nếu ngày mai mưa thì tôi không đi."}
{"id": "h2-0450", "hv": "Nhập khẩu", "pos_vi": "Danh từ", "vi": "Lối vào; cửa vào; nhập khẩu", "ex_zh": "地铁入口在那边。", "ex_vi": "Lối vào tàu điện ngầm ở bên kia."}
{"id": "h2-0451", "hv": "Thương lượng", "pos_vi": "Động từ", "vi": "Bàn bạc; thương lượng", "ex_zh": "我们商量一下吧。", "ex_vi": "Chúng ta bàn bạc một chút nhé."}
{"id": "h2-0452", "hv": "Thương nhân", "pos_vi": "Danh từ", "vi": "Thương nhân; người buôn bán", "ex_zh": "他是一个有名的商人。", "ex_vi": "Ông ấy là một thương nhân nổi tiếng."}
{"id": "h2-0453", "hv": "Thượng chu", "pos_vi": "Danh từ", "vi": "Tuần trước", "ex_zh": "我上周去了上海。", "ex_vi": "Tuần trước tôi đã đi Thượng Hải."}
{"id": "h2-0454", "hv": "Thiếu niên", "pos_vi": "Danh từ", "vi": "Thiếu niên", "ex_zh": "这个少年很聪明。", "ex_vi": "Cậu thiếu niên này rất thông minh."}
{"id": "h2-0455", "hv": "Thiểu số", "pos_vi": "Danh từ", "vi": "Thiểu số; số ít", "ex_zh": "只有少数人同意。", "ex_vi": "Chỉ có số ít người đồng ý."}
{"id": "h2-0456", "hv": "Thân biên", "pos_vi": "Danh từ", "vi": "Bên cạnh; bên mình", "ex_zh": "我身边没有带钱。", "ex_vi": "Tôi không mang tiền theo bên mình."}
{"id": "h2-0457", "hv": "Thập ma dạng", "pos_vi": "Đại từ", "vi": "Như thế nào; loại gì", "ex_zh": "你喜欢什么样的衣服？", "ex_vi": "Bạn thích loại quần áo thế nào?"}
{"id": "h2-0458", "hv": "Sinh", "pos_vi": "Động từ", "vi": "Sinh; đẻ; sống; sống động", "ex_zh": "他是在北京生的。", "ex_vi": "Anh ấy sinh ra ở Bắc Kinh."}
{"id": "h2-0459", "hv": "Sinh từ", "pos_vi": "Danh từ", "vi": "Từ mới", "ex_zh": "今天我们学十个生词。", "ex_vi": "Hôm nay chúng ta học mười từ mới."}
{"id": "h2-0460", "hv": "Sinh hoạt", "pos_vi": "Danh từ", "vi": "Cuộc sống; sinh hoạt; sống", "ex_zh": "他在中国的生活很开心。", "ex_vi": "Cuộc sống của anh ấy ở Trung Quốc rất vui."}
{"id": "h2-0461", "hv": "Thanh âm", "pos_vi": "Danh từ", "vi": "Giọng nói; âm thanh", "ex_zh": "她的声音很好听。", "ex_vi": "Giọng của cô ấy rất hay."}
{"id": "h2-0462", "hv": "Tỉnh", "pos_vi": "Danh từ", "vi": "Tỉnh; tiết kiệm; lược bớt", "ex_zh": "你是哪个省的人？", "ex_vi": "Bạn là người tỉnh nào?"}
{"id": "h2-0463", "hv": "Thập phân", "pos_vi": "Phó từ", "vi": "Rất; hết sức; vô cùng", "ex_zh": "我十分喜欢这个地方。", "ex_vi": "Tôi vô cùng thích nơi này."}
{"id": "h2-0464", "hv": "Thực tế", "pos_vi": "Tính từ", "vi": "Thực tế; thực tiễn", "ex_zh": "这个计划不太实际。", "ex_vi": "Kế hoạch này không thực tế lắm."}
{"id": "h2-0465", "hv": "Thực tập", "pos_vi": "Động từ", "vi": "Thực tập", "ex_zh": "她在一家公司实习。", "ex_vi": "Cô ấy thực tập ở một công ty."}
{"id": "h2-0466", "hv": "Thực hiện", "pos_vi": "Động từ", "vi": "Thực hiện; biến thành hiện thực", "ex_zh": "他的梦想实现了。", "ex_vi": "Ước mơ của anh ấy đã thành hiện thực."}
{"id": "h2-0467", "hv": "Thực tại", "pos_vi": "Phó từ", "vi": "Thực sự; quả thật", "ex_zh": "这个菜实在太好吃了。", "ex_vi": "Món này thực sự quá ngon."}
{"id": "h2-0468", "hv": "Thực vật", "pos_vi": "Danh từ", "vi": "Thức ăn; đồ ăn", "ex_zh": "这些食物都很新鲜。", "ex_vi": "Những thức ăn này đều rất tươi."}
{"id": "h2-0469", "hv": "Sử dụng", "pos_vi": "Động từ", "vi": "Sử dụng; dùng", "ex_zh": "你会使用这个机器吗？", "ex_vi": "Bạn biết dùng cái máy này không?"}
{"id": "h2-0470", "hv": "Thị", "pos_vi": "Danh từ", "vi": "Thành phố; chợ", "ex_zh": "我家在市中心。", "ex_vi": "Nhà tôi ở trung tâm thành phố."}
{"id": "h2-0471", "hv": "Thị trưởng", "pos_vi": "Danh từ", "vi": "Thị trưởng; chủ tịch thành phố", "ex_zh": "市长今天来我们学校。", "ex_vi": "Thị trưởng hôm nay đến trường chúng tôi."}
{"id": "h2-0472", "hv": "Sự tình", "pos_vi": "Danh từ", "vi": "Sự việc; việc; chuyện", "ex_zh": "我有一件事情要告诉你。", "ex_vi": "Tôi có một việc muốn nói với bạn."}
{"id": "h2-0473", "hv": "Thu", "pos_vi": "Động từ", "vi": "Nhận; thu; cất", "ex_zh": "我今天收了一个包裹。", "ex_vi": "Hôm nay tôi nhận được một gói hàng."}
{"id": "h2-0474", "hv": "Thu đáo", "pos_vi": "Động từ", "vi": "Nhận được", "ex_zh": "我收到了你的信。", "ex_vi": "Tôi đã nhận được thư của bạn."}
{"id": "h2-0475", "hv": "Thu nhập", "pos_vi": "Danh từ", "vi": "Thu nhập; khoản thu", "ex_zh": "他的收入不太高。", "ex_vi": "Thu nhập của anh ấy không cao lắm."}
{"id": "h2-0476", "hv": "Thủ biểu", "pos_vi": "Danh từ", "vi": "Đồng hồ đeo tay", "ex_zh": "这块手表是我爸爸送的。", "ex_vi": "Chiếc đồng hồ đeo tay này là bố tôi tặng."}
{"id": "h2-0477", "hv": "Thụ đáo", "pos_vi": "Động từ", "vi": "Nhận được; chịu; bị", "ex_zh": "他受到了老师的表扬。", "ex_vi": "Cậu ấy được thầy giáo khen ngợi."}
{"id": "h2-0478", "hv": "Thư phục", "pos_vi": "Tính từ", "vi": "Dễ chịu; thoải mái; khỏe", "ex_zh": "这个沙发坐着很舒服。", "ex_vi": "Ngồi ghế sofa này rất thoải mái."}
{"id": "h2-0479", "hv": "Thục", "pos_vi": "Tính từ", "vi": "Chín; quen; thông thạo", "ex_zh": "这个菜还没熟。", "ex_vi": "Món này vẫn chưa chín."}
{"id": "h2-0480", "hv": "Số", "pos_vi": "Động từ", "vi": "Đếm; tính; kể", "ex_zh": "请你数一数有几个人。", "ex_vi": "Bạn đếm thử xem có mấy người."}
{"id": "h2-0481", "hv": "Số tự", "pos_vi": "Danh từ", "vi": "Con số; chữ số", "ex_zh": "请把数字写在这里。", "ex_vi": "Xin viết con số vào đây."}
{"id": "h2-0482", "hv": "Thủy bình", "pos_vi": "Danh từ", "vi": "Trình độ; mức; nằm ngang", "ex_zh": "他的汉语水平很高。", "ex_vi": "Trình độ tiếng Trung của anh ấy rất cao."}
{"id": "h2-0483", "hv": "Thuận lợi", "pos_vi": "Tính từ", "vi": "Thuận lợi; suôn sẻ", "ex_zh": "祝你工作顺利！", "ex_vi": "Chúc bạn công việc thuận lợi!"}
{"id": "h2-0484", "hv": "Thuyết minh", "pos_vi": "Động từ", "vi": "Giải thích; nói rõ; chứng tỏ", "ex_zh": "老师给我们说明了规则。", "ex_vi": "Thầy giáo giải thích quy tắc cho chúng tôi."}
{"id": "h2-0485", "hv": "Tư cơ", "pos_vi": "Danh từ", "vi": "Tài xế; lái xe", "ex_zh": "出租车司机很热情。", "ex_vi": "Tài xế taxi rất nhiệt tình."}
{"id": "h2-0486", "hv": "Tống đáo", "pos_vi": "Động từ", "vi": "Đưa đến; giao đến", "ex_zh": "请把这些花送到我家。", "ex_vi": "Xin giao những bông hoa này đến nhà tôi."}
{"id": "h2-0487", "hv": "Tống cấp", "pos_vi": "Động từ", "vi": "Tặng; gửi cho", "ex_zh": "我想送给妈妈一件礼物。", "ex_vi": "Tôi muốn tặng mẹ một món quà."}
{"id": "h2-0488", "hv": "Toán", "pos_vi": "Động từ", "vi": "Tính; coi như; kể là", "ex_zh": "这样算对不对？", "ex_vi": "Tính thế này có đúng không?"}
{"id": "h2-0489", "hv": "Tuy nhiên", "pos_vi": "Liên từ", "vi": "Tuy; mặc dù", "ex_zh": "虽然很累，但是我很高兴。", "ex_vi": "Tuy rất mệt nhưng tôi rất vui."}
{"id": "h2-0490", "hv": "Tùy tiện", "pos_vi": "Phó từ", "vi": "Tùy ý; tùy; qua loa", "ex_zh": "你随便坐，别客气。", "ex_vi": "Bạn cứ ngồi tự nhiên, đừng khách sáo."}
{"id": "h2-0491", "hv": "Tùy thời", "pos_vi": "Phó từ", "vi": "Bất cứ lúc nào; mọi lúc", "ex_zh": "有问题可以随时问我。", "ex_vi": "Có vấn đề gì bạn có thể hỏi tôi bất cứ lúc nào."}
{"id": "h2-0492", "hv": "Sở dĩ", "pos_vi": "Liên từ", "vi": "Cho nên; vì vậy", "ex_zh": "天气不好，所以我没去。", "ex_vi": "Thời tiết xấu nên tôi không đi."}
{"id": "h2-0493", "hv": "Sở hữu", "pos_vi": "Tính từ", "vi": "Tất cả; toàn bộ; sở hữu", "ex_zh": "所有人都到了。", "ex_vi": "Tất cả mọi người đều đã đến."}
{"id": "h2-0494", "hv": "Tha", "pos_vi": "Đại từ", "vi": "Nó; cái đó; con đó", "ex_zh": "这只猫很可爱，它叫小白。", "ex_vi": "Con mèo này rất đáng yêu, nó tên là Tiểu Bạch."}
{"id": "h2-0495", "hv": "Tha môn", "pos_vi": "Đại từ", "vi": "Chúng nó; chúng (chỉ vật)", "ex_zh": "我有两只猫，它们很可爱。", "ex_vi": "Tôi có hai con mèo, chúng rất đáng yêu."}
{"id": "h2-0496", "hv": "Thái thái", "pos_vi": "Danh từ", "vi": "Bà; phu nhân; vợ", "ex_zh": "王太太是我的老师。", "ex_vi": "Bà Vương là cô giáo của tôi."}
{"id": "h2-0497", "hv": "Thái dương", "pos_vi": "Danh từ", "vi": "Mặt trời", "ex_zh": "太阳从东边升起来。", "ex_vi": "Mặt trời mọc từ phía đông."}
{"id": "h2-0498", "hv": "Thái độ", "pos_vi": "Danh từ", "vi": "Thái độ", "ex_zh": "他的态度很好。", "ex_vi": "Thái độ của anh ấy rất tốt."}
{"id": "h2-0499", "hv": "Thảo luận", "pos_vi": "Động từ", "vi": "Thảo luận; bàn bạc", "ex_zh": "我们一起讨论这个问题。", "ex_vi": "Chúng ta cùng thảo luận vấn đề này."}
{"id": "h2-0500", "hv": "Sáo", "pos_vi": "Lượng từ", "vi": "Bộ; bao; trùm", "ex_zh": "我买了一套新衣服。", "ex_vi": "Tôi mua một bộ quần áo mới."}
{"id": "h2-0501", "hv": "Đặc biệt", "pos_vi": "Phó từ", "vi": "Đặc biệt; rất; riêng", "ex_zh": "今天特别冷。", "ex_vi": "Hôm nay đặc biệt lạnh."}
{"id": "h2-0502", "hv": "Đặc điểm", "pos_vi": "Danh từ", "vi": "Đặc điểm; nét riêng", "ex_zh": "这个手机有什么特点？", "ex_vi": "Chiếc điện thoại này có đặc điểm gì?"}
