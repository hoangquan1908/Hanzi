{"id": "h1-0001", "hv": "Ái", "pos_vi": "Động từ", "vi": "Yêu; thương; yêu quý", "ex_zh": "我爱我的家人。", "ex_vi": "Tôi yêu gia đình mình."}
{"id": "h1-0002", "hv": "Ái hảo", "pos_vi": "Danh từ", "vi": "Sở thích; yêu thích", "ex_zh": "你有什么爱好？", "ex_vi": "Bạn có sở thích gì?"}
{"id": "h1-0003", "hv": "Bát", "pos_vi": "Số từ", "vi": "Tám", "ex_zh": "我家有八个人。", "ex_vi": "Nhà tôi có tám người."}
{"id": "h1-0004", "hv": "Bá", "pos_vi": "Danh từ", "vi": "Bố; ba", "ex_zh": "他爸是老师。", "ex_vi": "Bố anh ấy là giáo viên."}
{"id": "h1-0005", "hv": "Bá bá", "pos_vi": "Danh từ", "vi": "Bố; ba", "ex_zh": "我爸爸很高。", "ex_vi": "Bố tôi rất cao."}
{"id": "h1-0006", "hv": "Ba", "pos_vi": "Trợ từ", "vi": "Nhé; đi (cuối câu); quán bar", "ex_zh": "我们走吧。", "ex_vi": "Chúng ta đi thôi."}
{"id": "h1-0007", "hv": "Bạch", "pos_vi": "Tính từ", "vi": "Trắng; sáng; công cốc", "ex_zh": "这个杯子是白的。", "ex_vi": "Cái cốc này màu trắng."}
{"id": "h1-0008", "hv": "Bạch thiên", "pos_vi": "Danh từ", "vi": "Ban ngày", "ex_zh": "我白天在公司工作。", "ex_vi": "Ban ngày tôi làm việc ở công ty."}
{"id": "h1-0009", "hv": "Bách", "pos_vi": "Số từ", "vi": "Trăm", "ex_zh": "这本书一百块。", "ex_vi": "Quyển sách này một trăm đồng."}
{"id": "h1-0010", "hv": "Ban", "pos_vi": "Danh từ", "vi": "Lớp; ca; chuyến", "ex_zh": "我们班有二十个人。", "ex_vi": "Lớp chúng tôi có hai mươi người."}
{"id": "h1-0011", "hv": "Bán", "pos_vi": "Số từ", "vi": "Một nửa; rưỡi", "ex_zh": "现在是三点半。", "ex_vi": "Bây giờ là ba giờ rưỡi."}
{"id": "h1-0012", "hv": "Bán niên", "pos_vi": "Danh từ", "vi": "Nửa năm", "ex_zh": "我学汉语半年了。", "ex_vi": "Tôi học tiếng Trung nửa năm rồi."}
{"id": "h1-0013", "hv": "Bán thiên", "pos_vi": "Danh từ", "vi": "Nửa ngày; rất lâu", "ex_zh": "我等了你半天。", "ex_vi": "Tôi đợi bạn lâu lắm rồi."}
{"id": "h1-0014", "hv": "Bang", "pos_vi": "Động từ", "vi": "Giúp; giúp đỡ", "ex_zh": "请你帮我一下。", "ex_vi": "Phiền bạn giúp tôi một chút."}
{"id": "h1-0015", "hv": "Bang mang", "pos_vi": "Động từ", "vi": "Giúp đỡ; giúp một tay", "ex_zh": "你能帮忙吗？", "ex_vi": "Bạn có thể giúp một tay không?"}
{"id": "h1-0016", "hv": "Bao", "pos_vi": "Danh từ", "vi": "Túi; cặp; bao; gói", "ex_zh": "她的包很漂亮。", "ex_vi": "Túi của cô ấy rất đẹp."}
{"id": "h1-0017", "hv": "Bao tử", "pos_vi": "Danh từ", "vi": "Bánh bao", "ex_zh": "我早上吃了两个包子。", "ex_vi": "Sáng tôi ăn hai cái bánh bao."}
{"id": "h1-0018", "hv": "Bôi", "pos_vi": "Lượng từ", "vi": "Cốc; ly; chén", "ex_zh": "我想喝一杯茶。", "ex_vi": "Tôi muốn uống một cốc trà."}
{"id": "h1-0019", "hv": "Bôi tử", "pos_vi": "Danh từ", "vi": "Cái cốc; ly", "ex_zh": "桌子上有一个杯子。", "ex_vi": "Trên bàn có một cái cốc."}
{"id": "h1-0020", "hv": "Bắc", "pos_vi": "Danh từ", "vi": "Phía bắc; miền bắc", "ex_zh": "我想去北方。", "ex_vi": "Tôi muốn đi miền bắc."}
{"id": "h1-0021", "hv": "Bắc biên", "pos_vi": "Danh từ", "vi": "Phía bắc; bên bắc", "ex_zh": "学校在商店的北边。", "ex_vi": "Trường học ở phía bắc cửa hàng."}
{"id": "h1-0022", "hv": "Bắc Kinh", "pos_vi": "Danh từ riêng", "vi": "Bắc Kinh", "ex_zh": "我想去北京玩。", "ex_vi": "Tôi muốn đi Bắc Kinh chơi."}
{"id": "h1-0023", "hv": "Bản", "pos_vi": "Lượng từ", "vi": "Quyển; cuốn; gốc", "ex_zh": "我买了三本书。", "ex_vi": "Tôi mua ba quyển sách."}
{"id": "h1-0024", "hv": "Bản tử", "pos_vi": "Danh từ", "vi": "Quyển vở; sổ", "ex_zh": "我有一个新本子。", "ex_vi": "Tôi có một quyển vở mới."}
{"id": "h1-0025", "hv": "Tỉ", "pos_vi": "Giới từ", "vi": "So với; so sánh", "ex_zh": "今天比昨天热。", "ex_vi": "Hôm nay nóng hơn hôm qua."}
{"id": "h1-0026", "hv": "Biệt", "pos_vi": "Phó từ", "vi": "Đừng; khác; chia tay", "ex_zh": "别在这里吃饭。", "ex_vi": "Đừng ăn cơm ở đây."}
{"id": "h1-0027", "hv": "Biệt đích", "pos_vi": "Đại từ", "vi": "Cái khác; người khác", "ex_zh": "你还要别的吗？", "ex_vi": "Bạn còn cần cái khác không?"}
{"id": "h1-0028", "hv": "Biệt nhân", "pos_vi": "Đại từ", "vi": "Người khác", "ex_zh": "别人都走了。", "ex_vi": "Những người khác đều đi rồi."}
{"id": "h1-0029", "hv": "Bệnh", "pos_vi": "Danh từ", "vi": "Bệnh; ốm", "ex_zh": "他今天病了。", "ex_vi": "Hôm nay anh ấy bị ốm."}
{"id": "h1-0030", "hv": "Bệnh nhân", "pos_vi": "Danh từ", "vi": "Bệnh nhân; người bệnh", "ex_zh": "医院里有很多病人。", "ex_vi": "Trong bệnh viện có nhiều bệnh nhân."}
{"id": "h1-0031", "hv": "Bất", "pos_vi": "Phó từ", "vi": "Không", "ex_zh": "我不是老师。", "ex_vi": "Tôi không phải giáo viên."}
{"id": "h1-0032", "hv": "Bất đại", "pos_vi": "Phó từ", "vi": "Không lắm; không to", "ex_zh": "这个房间不大。", "ex_vi": "Căn phòng này không lớn."}
{"id": "h1-0033", "hv": "Bất đối", "pos_vi": "Tính từ", "vi": "Sai; không đúng", "ex_zh": "你说得不对。", "ex_vi": "Bạn nói không đúng."}
{"id": "h1-0034", "hv": "Bất khách khí", "pos_vi": "Cụm từ", "vi": "Đừng khách sáo; không có gì", "ex_zh": "谢谢！不客气。", "ex_vi": "Cảm ơn! Đừng khách sáo."}
{"id": "h1-0035", "hv": "Bất dụng", "pos_vi": "Phó từ", "vi": "Không cần", "ex_zh": "你不用来了。", "ex_vi": "Bạn không cần đến nữa."}
{"id": "h1-0036", "hv": "Thái", "pos_vi": "Danh từ", "vi": "Món ăn; rau", "ex_zh": "这个菜很好吃。", "ex_vi": "Món này rất ngon."}
{"id": "h1-0037", "hv": "Trà", "pos_vi": "Danh từ", "vi": "Trà; chè", "ex_zh": "我喝茶不喝咖啡。", "ex_vi": "Tôi uống trà, không uống cà phê."}
{"id": "h1-0038", "hv": "Sai", "pos_vi": "Tính từ", "vi": "Kém; thiếu; chênh lệch", "ex_zh": "他的汉语不差。", "ex_vi": "Tiếng Trung của anh ấy không tệ."}
{"id": "h1-0039", "hv": "Thường", "pos_vi": "Phó từ", "vi": "Thường; hay", "ex_zh": "他常去图书馆。", "ex_vi": "Anh ấy hay đến thư viện."}
{"id": "h1-0040", "hv": "Thường thường", "pos_vi": "Phó từ", "vi": "Thường xuyên; hay", "ex_zh": "我常常看电影。", "ex_vi": "Tôi thường xem phim."}
{"id": "h1-0041", "hv": "Xướng", "pos_vi": "Động từ", "vi": "Hát", "ex_zh": "她唱得很好。", "ex_vi": "Cô ấy hát rất hay."}
{"id": "h1-0042", "hv": "Xướng ca", "pos_vi": "Động từ", "vi": "Hát; ca hát", "ex_zh": "我喜欢唱歌。", "ex_vi": "Tôi thích hát."}
{"id": "h1-0043", "hv": "Xa", "pos_vi": "Danh từ", "vi": "Xe", "ex_zh": "我的车是白色的。", "ex_vi": "Xe của tôi màu trắng."}
{"id": "h1-0044", "hv": "Xa phiếu", "pos_vi": "Danh từ", "vi": "Vé xe", "ex_zh": "我买了两张车票。", "ex_vi": "Tôi mua hai vé xe."}
{"id": "h1-0045", "hv": "Xa thượng", "pos_vi": "Danh từ", "vi": "Trên xe", "ex_zh": "车上有很多人。", "ex_vi": "Trên xe có nhiều người."}
{"id": "h1-0046", "hv": "Xa trạm", "pos_vi": "Danh từ", "vi": "Bến xe; ga", "ex_zh": "车站离我家很近。", "ex_vi": "Bến xe rất gần nhà tôi."}
{"id": "h1-0047", "hv": "Ngật", "pos_vi": "Động từ", "vi": "Ăn", "ex_zh": "我想吃米饭。", "ex_vi": "Tôi muốn ăn cơm."}
{"id": "h1-0048", "hv": "Ngật phạn", "pos_vi": "Động từ", "vi": "Ăn cơm; dùng bữa", "ex_zh": "我们去吃饭吧。", "ex_vi": "Chúng ta đi ăn cơm đi."}
{"id": "h1-0049", "hv": "Xuất", "pos_vi": "Động từ", "vi": "Ra; đi ra; xuất hiện", "ex_zh": "他出门了。", "ex_vi": "Anh ấy ra khỏi nhà rồi."}
{"id": "h1-0050", "hv": "Xuất lai", "pos_vi": "Động từ", "vi": "Đi ra; ra đây", "ex_zh": "你快出来吧。", "ex_vi": "Bạn mau ra đây đi."}
{"id": "h1-0051", "hv": "Xuất khứ", "pos_vi": "Động từ", "vi": "Đi ra ngoài", "ex_zh": "他出去买东西了。", "ex_vi": "Anh ấy ra ngoài mua đồ rồi."}
{"id": "h1-0052", "hv": "Xuyên", "pos_vi": "Động từ", "vi": "Mặc; xỏ", "ex_zh": "你穿这件衣服很好看。", "ex_vi": "Bạn mặc bộ đồ này rất đẹp."}
{"id": "h1-0053", "hv": "Sàng", "pos_vi": "Danh từ", "vi": "Giường", "ex_zh": "我的床很大。", "ex_vi": "Giường của tôi rất lớn."}
{"id": "h1-0054", "hv": "Thứ", "pos_vi": "Lượng từ", "vi": "Lần; thứ hai", "ex_zh": "我去过一次北京。", "ex_vi": "Tôi đã đến Bắc Kinh một lần."}
{"id": "h1-0055", "hv": "Tòng", "pos_vi": "Giới từ", "vi": "Từ; theo", "ex_zh": "我从家走到学校。", "ex_vi": "Tôi đi bộ từ nhà đến trường."}
{"id": "h1-0056", "hv": "Thác", "pos_vi": "Tính từ", "vi": "Sai; nhầm", "ex_zh": "这个字写错了。", "ex_vi": "Chữ này viết sai rồi."}
{"id": "h1-0057", "hv": "Đả", "pos_vi": "Động từ", "vi": "Đánh; gọi; chơi", "ex_zh": "他在打电话。", "ex_vi": "Anh ấy đang gọi điện thoại."}
{"id": "h1-0058", "hv": "Đả xa", "pos_vi": "Động từ", "vi": "Bắt taxi; đi taxi", "ex_zh": "我们打车去吧。", "ex_vi": "Chúng ta bắt taxi đi."}
{"id": "h1-0059", "hv": "Đả điện thoại", "pos_vi": "Động từ", "vi": "Gọi điện thoại", "ex_zh": "我给妈妈打电话。", "ex_vi": "Tôi gọi điện cho mẹ."}
{"id": "h1-0060", "hv": "Đả khai", "pos_vi": "Động từ", "vi": "Mở; bật", "ex_zh": "请打开门。", "ex_vi": "Làm ơn mở cửa."}
{"id": "h1-0061", "hv": "Đả cầu", "pos_vi": "Động từ", "vi": "Chơi bóng", "ex_zh": "他每天下午打球。", "ex_vi": "Chiều nào anh ấy cũng chơi bóng."}
{"id": "h1-0062", "hv": "Đại", "pos_vi": "Tính từ", "vi": "To; lớn; già hơn", "ex_zh": "这个房子很大。", "ex_vi": "Căn nhà này rất lớn."}
{"id": "h1-0063", "hv": "Đại học", "pos_vi": "Danh từ", "vi": "Đại học", "ex_zh": "我在大学学汉语。", "ex_vi": "Tôi học tiếng Trung ở đại học."}
{"id": "h1-0064", "hv": "Đại học sinh", "pos_vi": "Danh từ", "vi": "Sinh viên", "ex_zh": "他是大学生。", "ex_vi": "Anh ấy là sinh viên."}
{"id": "h1-0065", "hv": "Đáo", "pos_vi": "Động từ", "vi": "Đến; tới", "ex_zh": "我八点到学校。", "ex_vi": "Tám giờ tôi đến trường."}
{"id": "h1-0066", "hv": "Địa", "pos_vi": "Trợ từ", "vi": "Một cách (trợ từ trạng ngữ); đất", "ex_zh": "他高兴地笑了。", "ex_vi": "Anh ấy cười vui vẻ."}
{"id": "h1-0067", "hv": "Địa điểm", "pos_vi": "Danh từ", "vi": "Địa điểm; nơi", "ex_zh": "我们在什么地点见面？", "ex_vi": "Chúng ta gặp nhau ở địa điểm nào?"}
{"id": "h1-0068", "hv": "Địa phương", "pos_vi": "Danh từ", "vi": "Nơi; chỗ; địa phương", "ex_zh": "这个地方很漂亮。", "ex_vi": "Nơi này rất đẹp."}
{"id": "h1-0069", "hv": "Địa thượng", "pos_vi": "Danh từ", "vi": "Trên mặt đất; dưới đất", "ex_zh": "地上有一本书。", "ex_vi": "Dưới đất có một quyển sách."}
{"id": "h1-0070", "hv": "Địa đồ", "pos_vi": "Danh từ", "vi": "Bản đồ", "ex_zh": "我有一张中国地图。", "ex_vi": "Tôi có một tấm bản đồ Trung Quốc."}
{"id": "h1-0071", "hv": "Đích", "pos_vi": "Trợ từ", "vi": "Của; (trợ từ định ngữ)", "ex_zh": "这是我的书。", "ex_vi": "Đây là sách của tôi."}
{"id": "h1-0072", "hv": "Đắc đáo", "pos_vi": "Động từ", "vi": "Có được; nhận được", "ex_zh": "他得到了一份工作。", "ex_vi": "Anh ấy đã có được một công việc."}
{"id": "h1-0073", "hv": "Đẳng", "pos_vi": "Động từ", "vi": "Đợi; chờ; vân vân", "ex_zh": "请等一下。", "ex_vi": "Xin đợi một chút."}
{"id": "h1-0074", "hv": "Đệ", "pos_vi": "Danh từ", "vi": "Em trai", "ex_zh": "我弟在读大学。", "ex_vi": "Em trai tôi đang học đại học."}
{"id": "h1-0075", "hv": "Đệ đệ", "pos_vi": "Danh từ", "vi": "Em trai", "ex_zh": "我弟弟八岁了。", "ex_vi": "Em trai tôi tám tuổi rồi."}
{"id": "h1-0076", "hv": "Đệ", "pos_vi": "Số từ", "vi": "Thứ (tiền tố số thứ tự)", "ex_zh": "这是我第一次来。", "ex_vi": "Đây là lần đầu tôi đến."}
{"id": "h1-0077", "hv": "Đệ nhị", "pos_vi": "Số từ", "vi": "Thứ hai; kế tiếp", "ex_zh": "第二天我去上班。", "ex_vi": "Ngày hôm sau tôi đi làm."}
{"id": "h1-0078", "hv": "Điểm", "pos_vi": "Lượng từ", "vi": "Giờ; điểm; chút; gọi món", "ex_zh": "现在几点了？", "ex_vi": "Bây giờ là mấy giờ rồi?"}
{"id": "h1-0079", "hv": "Điện", "pos_vi": "Danh từ", "vi": "Điện", "ex_zh": "家里没有电了。", "ex_vi": "Trong nhà hết điện rồi."}
{"id": "h1-0080", "hv": "Điện thoại", "pos_vi": "Danh từ", "vi": "Điện thoại", "ex_zh": "你的电话号码是多少？", "ex_vi": "Số điện thoại của bạn là bao nhiêu?"}
{"id": "h1-0081", "hv": "Điện não", "pos_vi": "Danh từ", "vi": "Máy tính", "ex_zh": "我用电脑工作。", "ex_vi": "Tôi dùng máy tính để làm việc."}
{"id": "h1-0082", "hv": "Điện thị", "pos_vi": "Danh từ", "vi": "Tivi; truyền hình", "ex_zh": "我在看电视。", "ex_vi": "Tôi đang xem tivi."}
{"id": "h1-0083", "hv": "Điện thị cơ", "pos_vi": "Danh từ", "vi": "Cái tivi", "ex_zh": "客厅里有一台电视机。", "ex_vi": "Trong phòng khách có một cái tivi."}
{"id": "h1-0084", "hv": "Điện ảnh", "pos_vi": "Danh từ", "vi": "Phim; điện ảnh", "ex_zh": "我们去看电影吧。", "ex_vi": "Chúng ta đi xem phim đi."}
{"id": "h1-0085", "hv": "Điện ảnh viện", "pos_vi": "Danh từ", "vi": "Rạp chiếu phim", "ex_zh": "电影院在商店后面。", "ex_vi": "Rạp chiếu phim ở sau cửa hàng."}
{"id": "h1-0086", "hv": "Đông", "pos_vi": "Danh từ", "vi": "Phía đông; hướng đông", "ex_zh": "太阳从东方出来。", "ex_vi": "Mặt trời mọc từ phương đông."}
{"id": "h1-0087", "hv": "Đông biên", "pos_vi": "Danh từ", "vi": "Phía đông; bên đông", "ex_zh": "学校的东边有一家饭店。", "ex_vi": "Phía đông trường có một nhà hàng."}
{"id": "h1-0088", "hv": "Đông tây", "pos_vi": "Danh từ", "vi": "Đồ đạc; thứ; đồ vật", "ex_zh": "我去商店买东西。", "ex_vi": "Tôi đi cửa hàng mua đồ."}
{"id": "h1-0089", "hv": "Động", "pos_vi": "Động từ", "vi": "Động; cử động; di chuyển", "ex_zh": "请坐好，不要乱动！", "ex_vi": "Xin ngồi yên, đừng cựa quậy!"}
{"id": "h1-0090", "hv": "Động tác", "pos_vi": "Danh từ", "vi": "Động tác; hành động", "ex_zh": "他的动作很快。", "ex_vi": "Động tác của anh ấy rất nhanh."}
{"id": "h1-0091", "hv": "Đô", "pos_vi": "Phó từ", "vi": "Đều; cả", "ex_zh": "我们都是学生。", "ex_vi": "Chúng tôi đều là học sinh."}
{"id": "h1-0092", "hv": "Độc", "pos_vi": "Động từ", "vi": "Đọc; học", "ex_zh": "我在读大学。", "ex_vi": "Tôi đang học đại học."}
{"id": "h1-0093", "hv": "Độc thư", "pos_vi": "Động từ", "vi": "Đọc sách; đi học", "ex_zh": "他喜欢读书。", "ex_vi": "Anh ấy thích đọc sách."}
{"id": "h1-0094", "hv": "Đối", "pos_vi": "Tính từ", "vi": "Đúng; với; đối với", "ex_zh": "你说得对。", "ex_vi": "Bạn nói đúng."}
{"id": "h1-0095", "hv": "Đối bất khởi", "pos_vi": "Cụm từ", "vi": "Xin lỗi", "ex_zh": "对不起，我来晚了。", "ex_vi": "Xin lỗi, tôi đến muộn."}
{"id": "h1-0096", "hv": "Đa", "pos_vi": "Tính từ", "vi": "Nhiều; hơn", "ex_zh": "这里的人很多。", "ex_vi": "Ở đây có nhiều người."}
{"id": "h1-0097", "hv": "Đa thiểu", "pos_vi": "Đại từ", "vi": "Bao nhiêu", "ex_zh": "这个多少钱？", "ex_vi": "Cái này bao nhiêu tiền?"}
{"id": "h1-0098", "hv": "Ngạ", "pos_vi": "Tính từ", "vi": "Đói", "ex_zh": "我很饿，想吃饭。", "ex_vi": "Tôi rất đói, muốn ăn cơm."}
{"id": "h1-0099", "hv": "Nhi tử", "pos_vi": "Danh từ", "vi": "Con trai", "ex_zh": "他的儿子五岁了。", "ex_vi": "Con trai anh ấy năm tuổi rồi."}
{"id": "h1-0100", "hv": "Nhị", "pos_vi": "Số từ", "vi": "Hai", "ex_zh": "我今年二十岁。", "ex_vi": "Năm nay tôi hai mươi tuổi."}
{"id": "h1-0101", "hv": "Phạn", "pos_vi": "Danh từ", "vi": "Cơm; bữa ăn", "ex_zh": "妈妈做的饭很好吃。", "ex_vi": "Cơm mẹ nấu rất ngon."}
{"id": "h1-0102", "hv": "Phạn điếm", "pos_vi": "Danh từ", "vi": "Nhà hàng; khách sạn", "ex_zh": "这家饭店的菜很好吃。", "ex_vi": "Món ăn của nhà hàng này rất ngon."}
{"id": "h1-0103", "hv": "Phòng gian", "pos_vi": "Danh từ", "vi": "Phòng", "ex_zh": "我的房间很干净。", "ex_vi": "Phòng của tôi rất sạch."}
{"id": "h1-0104", "hv": "Phòng tử", "pos_vi": "Danh từ", "vi": "Nhà; căn nhà", "ex_zh": "他的房子很大。", "ex_vi": "Nhà của anh ấy rất lớn."}
{"id": "h1-0105", "hv": "Phóng", "pos_vi": "Động từ", "vi": "Đặt; để; thả", "ex_zh": "把书放在桌子上。", "ex_vi": "Đặt sách lên bàn."}
{"id": "h1-0106", "hv": "Phóng giả", "pos_vi": "Động từ", "vi": "Nghỉ lễ; nghỉ", "ex_zh": "明天学校放假。", "ex_vi": "Ngày mai trường nghỉ."}
{"id": "h1-0107", "hv": "Phóng học", "pos_vi": "Động từ", "vi": "Tan học", "ex_zh": "我四点放学。", "ex_vi": "Bốn giờ tôi tan học."}
{"id": "h1-0108", "hv": "Phi", "pos_vi": "Động từ", "vi": "Bay", "ex_zh": "鸟在天上飞。", "ex_vi": "Chim bay trên trời."}
{"id": "h1-0109", "hv": "Phi cơ", "pos_vi": "Danh từ", "vi": "Máy bay", "ex_zh": "我坐飞机去北京。", "ex_vi": "Tôi đi máy bay đến Bắc Kinh."}
{"id": "h1-0110", "hv": "Phi thường", "pos_vi": "Phó từ", "vi": "Rất; vô cùng; phi thường", "ex_zh": "今天非常热。", "ex_vi": "Hôm nay rất nóng."}
{"id": "h1-0111", "hv": "Phân", "pos_vi": "Động từ", "vi": "Chia; phân; phút; điểm", "ex_zh": "我考了九十分。", "ex_vi": "Tôi thi được chín mươi điểm."}
{"id": "h1-0112", "hv": "Phong", "pos_vi": "Danh từ", "vi": "Gió", "ex_zh": "今天风很大。", "ex_vi": "Hôm nay gió rất to."}
{"id": "h1-0113", "hv": "Can", "pos_vi": "Tính từ", "vi": "Khô; ráo", "ex_zh": "衣服干了吗？", "ex_vi": "Quần áo khô chưa?"}
{"id": "h1-0114", "hv": "Can tịnh", "pos_vi": "Tính từ", "vi": "Sạch; sạch sẽ", "ex_zh": "这件衣服很干净。", "ex_vi": "Bộ quần áo này rất sạch."}
{"id": "h1-0115", "hv": "Cán thập ma", "pos_vi": "Cụm từ", "vi": "Làm gì", "ex_zh": "你在干什么？", "ex_vi": "Bạn đang làm gì vậy?"}
{"id": "h1-0116", "hv": "Cao", "pos_vi": "Tính từ", "vi": "Cao", "ex_zh": "他很高。", "ex_vi": "Anh ấy rất cao."}
{"id": "h1-0117", "hv": "Cao hứng", "pos_vi": "Tính từ", "vi": "Vui; vui mừng", "ex_zh": "见到你我很高兴。", "ex_vi": "Gặp bạn tôi rất vui."}
{"id": "h1-0118", "hv": "Cáo tố", "pos_vi": "Động từ", "vi": "Nói cho biết; bảo", "ex_zh": "请告诉我你的名字。", "ex_vi": "Xin cho tôi biết tên bạn."}
{"id": "h1-0119", "hv": "Ca", "pos_vi": "Danh từ", "vi": "Anh trai", "ex_zh": "我哥在北京工作。", "ex_vi": "Anh trai tôi làm việc ở Bắc Kinh."}
{"id": "h1-0120", "hv": "Ca ca", "pos_vi": "Danh từ", "vi": "Anh trai", "ex_zh": "我哥哥是医生。", "ex_vi": "Anh trai tôi là bác sĩ."}
{"id": "h1-0121", "hv": "Ca", "pos_vi": "Danh từ", "vi": "Bài hát; hát", "ex_zh": "这首歌很好听。", "ex_vi": "Bài hát này rất hay."}
{"id": "h1-0122", "hv": "Cá", "pos_vi": "Lượng từ", "vi": "Cái; con; người", "ex_zh": "我有三个朋友。", "ex_vi": "Tôi có ba người bạn."}
{"id": "h1-0123", "hv": "Cấp", "pos_vi": "Động từ", "vi": "Cho; đưa; tặng", "ex_zh": "我给你一本书。", "ex_vi": "Tôi cho bạn một quyển sách."}
{"id": "h1-0124", "hv": "Cân", "pos_vi": "Giới từ", "vi": "Cùng; với; theo", "ex_zh": "我跟朋友去看电影。", "ex_vi": "Tôi đi xem phim với bạn."}
{"id": "h1-0125", "hv": "Công nhân", "pos_vi": "Danh từ", "vi": "Công nhân", "ex_zh": "他爸爸是工人。", "ex_vi": "Bố anh ấy là công nhân."}
{"id": "h1-0126", "hv": "Công tác", "pos_vi": "Động từ", "vi": "Làm việc; công việc", "ex_zh": "我在北京工作。", "ex_vi": "Tôi làm việc ở Bắc Kinh."}
