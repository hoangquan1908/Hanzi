{"id": "h1-0127", "hv": "Quan", "pos_vi": "Động từ", "vi": "Đóng; liên quan; họ Quan", "ex_zh": "天冷了，请关门。", "ex_vi": "Trời lạnh rồi, làm ơn đóng cửa."}
{"id": "h1-0128", "hv": "Quan thượng", "pos_vi": "Động từ", "vi": "Đóng lại; tắt", "ex_zh": "请把门关上。", "ex_vi": "Làm ơn đóng cửa lại."}
{"id": "h1-0129", "hv": "Quý", "pos_vi": "Tính từ", "vi": "Đắt; quý; cao quý", "ex_zh": "这件衣服太贵了。", "ex_vi": "Bộ quần áo này đắt quá."}
{"id": "h1-0130", "hv": "Quốc", "pos_vi": "Danh từ", "vi": "Nước; quốc gia; họ Quách", "ex_zh": "我爱我的国。", "ex_vi": "Tôi yêu đất nước của tôi."}
{"id": "h1-0131", "hv": "Quốc gia", "pos_vi": "Danh từ", "vi": "Quốc gia; đất nước", "ex_zh": "中国是一个大国家。", "ex_vi": "Trung Quốc là một quốc gia lớn."}
{"id": "h1-0132", "hv": "Quốc ngoại", "pos_vi": "Danh từ", "vi": "Nước ngoài; hải ngoại", "ex_zh": "他在国外工作。", "ex_vi": "Anh ấy làm việc ở nước ngoài."}
{"id": "h1-0133", "hv": "Quá", "pos_vi": "Động từ", "vi": "Qua; đã từng; quá", "ex_zh": "我去过北京。", "ex_vi": "Tôi đã từng đến Bắc Kinh."}
{"id": "h1-0134", "hv": "Hoàn", "pos_vi": "Phó từ", "vi": "Vẫn; còn; trả lại", "ex_zh": "他还在学校里。", "ex_vi": "Anh ấy vẫn còn ở trong trường."}
{"id": "h1-0135", "hv": "Hoàn thị", "pos_vi": "Liên từ", "vi": "Hay là; vẫn; nên", "ex_zh": "你喝茶还是喝咖啡？", "ex_vi": "Bạn uống trà hay uống cà phê?"}
{"id": "h1-0136", "hv": "Hoàn hữu", "pos_vi": "Cụm từ", "vi": "Còn có; ngoài ra", "ex_zh": "桌子上还有一本书。", "ex_vi": "Trên bàn còn có một cuốn sách."}
{"id": "h1-0137", "hv": "Hài tử", "pos_vi": "Danh từ", "vi": "Đứa trẻ; con cái", "ex_zh": "这个孩子很可爱。", "ex_vi": "Đứa bé này rất đáng yêu."}
{"id": "h1-0138", "hv": "Hán ngữ", "pos_vi": "Danh từ", "vi": "Tiếng Hán; tiếng Trung", "ex_zh": "我在学汉语。", "ex_vi": "Tôi đang học tiếng Trung."}
{"id": "h1-0139", "hv": "Hán tự", "pos_vi": "Danh từ", "vi": "Chữ Hán", "ex_zh": "汉字很难写。", "ex_vi": "Chữ Hán rất khó viết."}
{"id": "h1-0140", "hv": "Hảo", "pos_vi": "Tính từ", "vi": "Tốt; hay; được", "ex_zh": "今天天气很好。", "ex_vi": "Hôm nay thời tiết rất tốt."}
{"id": "h1-0141", "hv": "Hảo cật", "pos_vi": "Tính từ", "vi": "Ngon", "ex_zh": "这个菜很好吃。", "ex_vi": "Món này rất ngon."}
{"id": "h1-0142", "hv": "Hảo khán", "pos_vi": "Tính từ", "vi": "Đẹp; hay; dễ nhìn", "ex_zh": "这件衣服很好看。", "ex_vi": "Bộ quần áo này rất đẹp."}
{"id": "h1-0143", "hv": "Hảo thính", "pos_vi": "Tính từ", "vi": "Nghe hay; dễ nghe", "ex_zh": "这首歌很好听。", "ex_vi": "Bài hát này nghe rất hay."}
{"id": "h1-0144", "hv": "Hảo ngoạn nhi", "pos_vi": "Tính từ", "vi": "Vui; thú vị", "ex_zh": "这个游戏很好玩儿。", "ex_vi": "Trò chơi này rất vui."}
{"id": "h1-0145", "hv": "Hiệu", "pos_vi": "Lượng từ", "vi": "Ngày (mùng); số; hiệu", "ex_zh": "今天是五号。", "ex_vi": "Hôm nay là ngày mùng năm."}
{"id": "h1-0146", "hv": "Hát", "pos_vi": "Động từ", "vi": "Uống", "ex_zh": "我想喝一杯水。", "ex_vi": "Tôi muốn uống một cốc nước."}
{"id": "h1-0147", "hv": "Hòa", "pos_vi": "Liên từ", "vi": "Và; với; hòa", "ex_zh": "我和他是朋友。", "ex_vi": "Tôi và anh ấy là bạn."}
{"id": "h1-0148", "hv": "Ngận", "pos_vi": "Phó từ", "vi": "Rất; khá", "ex_zh": "我今天很高兴。", "ex_vi": "Hôm nay tôi rất vui."}
{"id": "h1-0149", "hv": "Hậu", "pos_vi": "Danh từ", "vi": "Sau; phía sau; họ Hậu", "ex_zh": "三天后我回家。", "ex_vi": "Ba ngày nữa tôi về nhà."}
{"id": "h1-0150", "hv": "Hậu biên", "pos_vi": "Danh từ", "vi": "Phía sau; đằng sau", "ex_zh": "学校后边有一家商店。", "ex_vi": "Phía sau trường có một cửa hàng."}
{"id": "h1-0151", "hv": "Hậu thiên", "pos_vi": "Danh từ", "vi": "Ngày kia; hậu thiên", "ex_zh": "后天我们去北京。", "ex_vi": "Ngày kia chúng tôi đi Bắc Kinh."}
{"id": "h1-0152", "hv": "Hoa", "pos_vi": "Danh từ", "vi": "Hoa; tiêu; tốn", "ex_zh": "这些花很漂亮。", "ex_vi": "Những bông hoa này rất đẹp."}
{"id": "h1-0153", "hv": "Thoại", "pos_vi": "Danh từ", "vi": "Lời nói; tiếng; câu chuyện", "ex_zh": "他说的话我听不懂。", "ex_vi": "Lời anh ấy nói tôi nghe không hiểu."}
{"id": "h1-0154", "hv": "Hoại", "pos_vi": "Tính từ", "vi": "Xấu; hỏng", "ex_zh": "我的电脑坏了。", "ex_vi": "Máy tính của tôi hỏng rồi."}
{"id": "h1-0155", "hv": "Hồi", "pos_vi": "Động từ", "vi": "Về; quay lại; lần", "ex_zh": "他回学校了。", "ex_vi": "Anh ấy quay về trường rồi."}
{"id": "h1-0156", "hv": "Hồi đáp", "pos_vi": "Động từ", "vi": "Trả lời; đáp lại", "ex_zh": "请回答我的问题。", "ex_vi": "Hãy trả lời câu hỏi của tôi."}
{"id": "h1-0157", "hv": "Hồi đáo", "pos_vi": "Động từ", "vi": "Trở về; quay về", "ex_zh": "他回到了家。", "ex_vi": "Anh ấy đã về đến nhà."}
{"id": "h1-0158", "hv": "Hồi gia", "pos_vi": "Động từ", "vi": "Về nhà", "ex_zh": "我六点回家。", "ex_vi": "Sáu giờ tôi về nhà."}
{"id": "h1-0159", "hv": "Hồi lai", "pos_vi": "Động từ", "vi": "Trở về; quay lại", "ex_zh": "你什么时候回来？", "ex_vi": "Khi nào bạn quay về?"}
{"id": "h1-0160", "hv": "Hồi khứ", "pos_vi": "Động từ", "vi": "Trở về; đi về", "ex_zh": "太晚了，我要回去了。", "ex_vi": "Muộn quá rồi, tôi phải về đây."}
{"id": "h1-0161", "hv": "Hội", "pos_vi": "Động từ", "vi": "Biết; có thể; sẽ; họp", "ex_zh": "我会说汉语。", "ex_vi": "Tôi biết nói tiếng Trung."}
{"id": "h1-0162", "hv": "Hỏa xa", "pos_vi": "Danh từ", "vi": "Tàu hỏa", "ex_zh": "我坐火车去北京。", "ex_vi": "Tôi đi tàu hỏa đến Bắc Kinh."}
{"id": "h1-0163", "hv": "Cơ trường", "pos_vi": "Danh từ", "vi": "Sân bay", "ex_zh": "机场离这儿很远。", "ex_vi": "Sân bay cách đây rất xa."}
{"id": "h1-0164", "hv": "Cơ phiếu", "pos_vi": "Danh từ", "vi": "Vé máy bay", "ex_zh": "我买了两张机票。", "ex_vi": "Tôi đã mua hai vé máy bay."}
{"id": "h1-0165", "hv": "Kê đản", "pos_vi": "Danh từ", "vi": "Trứng gà", "ex_zh": "我早上吃鸡蛋。", "ex_vi": "Buổi sáng tôi ăn trứng gà."}
{"id": "h1-0166", "hv": "Kỷ", "pos_vi": "Đại từ", "vi": "Mấy; bao nhiêu; vài", "ex_zh": "你家有几口人？", "ex_vi": "Nhà bạn có mấy người?"}
{"id": "h1-0167", "hv": "Ký", "pos_vi": "Động từ", "vi": "Nhớ; ghi chép", "ex_zh": "请记一下我的电话。", "ex_vi": "Làm ơn ghi lại số điện thoại của tôi."}
{"id": "h1-0168", "hv": "Ký đắc", "pos_vi": "Động từ", "vi": "Nhớ", "ex_zh": "我记得他的名字。", "ex_vi": "Tôi nhớ tên của anh ấy."}
{"id": "h1-0169", "hv": "Ký trú", "pos_vi": "Động từ", "vi": "Nhớ kỹ; ghi nhớ", "ex_zh": "请记住这个词。", "ex_vi": "Hãy nhớ kỹ từ này."}
{"id": "h1-0170", "hv": "Gia", "pos_vi": "Danh từ", "vi": "Nhà; gia đình", "ex_zh": "我家离学校很近。", "ex_vi": "Nhà tôi cách trường rất gần."}
{"id": "h1-0171", "hv": "Gia lý", "pos_vi": "Danh từ", "vi": "Trong nhà; ở nhà", "ex_zh": "他今天在家里。", "ex_vi": "Hôm nay anh ấy ở nhà."}
{"id": "h1-0172", "hv": "Gia nhân", "pos_vi": "Danh từ", "vi": "Người nhà; gia đình", "ex_zh": "我爱我的家人。", "ex_vi": "Tôi yêu gia đình của tôi."}
{"id": "h1-0173", "hv": "Gian", "pos_vi": "Lượng từ", "vi": "Gian; phòng; giữa", "ex_zh": "我们家有三间房。", "ex_vi": "Nhà chúng tôi có ba phòng."}
{"id": "h1-0174", "hv": "Kiến", "pos_vi": "Động từ", "vi": "Thấy; gặp", "ex_zh": "很高兴见到你。", "ex_vi": "Rất vui được gặp bạn."}
{"id": "h1-0175", "hv": "Kiến diện", "pos_vi": "Động từ", "vi": "Gặp mặt; gặp nhau", "ex_zh": "我们明天见面吧。", "ex_vi": "Ngày mai chúng ta gặp nhau nhé."}
{"id": "h1-0176", "hv": "Khiếu", "pos_vi": "Động từ", "vi": "Gọi; kêu; tên là", "ex_zh": "他叫小明，是我同学。", "ex_vi": "Cậu ấy tên Tiểu Minh, là bạn học của tôi."}
{"id": "h1-0177", "hv": "Giáo", "pos_vi": "Động từ", "vi": "Dạy; họ Giáo", "ex_zh": "他教我们汉语。", "ex_vi": "Thầy ấy dạy chúng tôi tiếng Trung."}
{"id": "h1-0178", "hv": "Giáo học lâu", "pos_vi": "Danh từ", "vi": "Tòa nhà giảng dạy", "ex_zh": "教学楼在学校后边。", "ex_vi": "Tòa nhà giảng dạy ở phía sau trường."}
{"id": "h1-0179", "hv": "Giới thiệu", "pos_vi": "Động từ", "vi": "Giới thiệu", "ex_zh": "请介绍一下你自己。", "ex_vi": "Hãy giới thiệu một chút về bản thân bạn."}
{"id": "h1-0180", "hv": "Tỷ", "pos_vi": "Danh từ", "vi": "Chị; chị gái", "ex_zh": "我姐在北京工作。", "ex_vi": "Chị tôi làm việc ở Bắc Kinh."}
{"id": "h1-0181", "hv": "Tỷ tỷ", "pos_vi": "Danh từ", "vi": "Chị gái", "ex_zh": "我姐姐是老师。", "ex_vi": "Chị gái tôi là giáo viên."}
{"id": "h1-0182", "hv": "Kim niên", "pos_vi": "Danh từ", "vi": "Năm nay", "ex_zh": "我今年二十岁。", "ex_vi": "Năm nay tôi hai mươi tuổi."}
{"id": "h1-0183", "hv": "Kim thiên", "pos_vi": "Danh từ", "vi": "Hôm nay; hiện nay", "ex_zh": "今天你有时间吗？", "ex_vi": "Hôm nay bạn có thời gian không?"}
{"id": "h1-0184", "hv": "Tiến", "pos_vi": "Động từ", "vi": "Vào; tiến lên", "ex_zh": "请进，请坐。", "ex_vi": "Mời vào, mời ngồi."}
{"id": "h1-0185", "hv": "Tiến lai", "pos_vi": "Động từ", "vi": "Vào đây; đi vào", "ex_zh": "请进来坐一会儿。", "ex_vi": "Mời vào ngồi một lát."}
{"id": "h1-0186", "hv": "Tiến khứ", "pos_vi": "Động từ", "vi": "Đi vào", "ex_zh": "他走进去了。", "ex_vi": "Anh ấy đi vào trong rồi."}
{"id": "h1-0187", "hv": "Cửu", "pos_vi": "Số từ", "vi": "Chín; số 9", "ex_zh": "我家有九口人。", "ex_vi": "Nhà tôi có chín người."}
{"id": "h1-0188", "hv": "Tựu", "pos_vi": "Phó từ", "vi": "Liền; ngay; thì; chính là", "ex_zh": "他一到家就吃饭。", "ex_vi": "Anh ấy vừa về đến nhà là ăn cơm."}
{"id": "h1-0189", "hv": "Giác đắc", "pos_vi": "Động từ", "vi": "Cảm thấy; nghĩ rằng", "ex_zh": "我觉得汉语很有意思。", "ex_vi": "Tôi thấy tiếng Trung rất thú vị."}
{"id": "h1-0190", "hv": "Khai", "pos_vi": "Động từ", "vi": "Mở; lái; bật", "ex_zh": "请把窗户开开。", "ex_vi": "Làm ơn mở cửa sổ ra."}
{"id": "h1-0191", "hv": "Khai xa", "pos_vi": "Động từ", "vi": "Lái xe", "ex_zh": "他每天开车上班。", "ex_vi": "Anh ấy ngày nào cũng lái xe đi làm."}
{"id": "h1-0192", "hv": "Khai hội", "pos_vi": "Động từ", "vi": "Họp; mở họp", "ex_zh": "我们下午开会。", "ex_vi": "Chiều nay chúng tôi họp."}
{"id": "h1-0193", "hv": "Khai ngoạn tiếu", "pos_vi": "Động từ", "vi": "Đùa; nói đùa", "ex_zh": "别生气，我在开玩笑。", "ex_vi": "Đừng giận, tôi đang đùa thôi."}
{"id": "h1-0194", "hv": "Khán", "pos_vi": "Động từ", "vi": "Xem; nhìn; thăm", "ex_zh": "我喜欢看电影。", "ex_vi": "Tôi thích xem phim."}
{"id": "h1-0195", "hv": "Khán bệnh", "pos_vi": "Động từ", "vi": "Khám bệnh; đi khám", "ex_zh": "他去医院看病。", "ex_vi": "Anh ấy đến bệnh viện khám bệnh."}
{"id": "h1-0196", "hv": "Khán đáo", "pos_vi": "Động từ", "vi": "Nhìn thấy", "ex_zh": "我看到他了。", "ex_vi": "Tôi nhìn thấy anh ấy rồi."}
{"id": "h1-0197", "hv": "Khán kiến", "pos_vi": "Động từ", "vi": "Nhìn thấy; trông thấy", "ex_zh": "你看见我的书了吗？", "ex_vi": "Bạn có thấy sách của tôi không?"}
{"id": "h1-0198", "hv": "Khảo", "pos_vi": "Động từ", "vi": "Thi; kiểm tra", "ex_zh": "明天我要考汉语。", "ex_vi": "Ngày mai tôi phải thi tiếng Trung."}
{"id": "h1-0199", "hv": "Khảo thí", "pos_vi": "Động từ", "vi": "Thi; kỳ thi", "ex_zh": "明天有汉语考试。", "ex_vi": "Ngày mai có kỳ thi tiếng Trung."}
{"id": "h1-0200", "hv": "Khát", "pos_vi": "Tính từ", "vi": "Khát", "ex_zh": "我很渴，想喝水。", "ex_vi": "Tôi rất khát, muốn uống nước."}
{"id": "h1-0201", "hv": "Khóa", "pos_vi": "Danh từ", "vi": "Bài học; tiết học; môn", "ex_zh": "今天有两节课。", "ex_vi": "Hôm nay có hai tiết học."}
{"id": "h1-0202", "hv": "Khóa bản", "pos_vi": "Danh từ", "vi": "Sách giáo khoa", "ex_zh": "请打开课本。", "ex_vi": "Hãy mở sách giáo khoa ra."}
{"id": "h1-0203", "hv": "Khóa văn", "pos_vi": "Danh từ", "vi": "Bài khóa; bài đọc", "ex_zh": "这篇课文很长。", "ex_vi": "Bài khóa này rất dài."}
{"id": "h1-0204", "hv": "Khẩu", "pos_vi": "Danh từ", "vi": "Miệng; cửa; (người)", "ex_zh": "我家有四口人。", "ex_vi": "Nhà tôi có bốn người."}
{"id": "h1-0205", "hv": "Khối", "pos_vi": "Lượng từ", "vi": "Miếng; cục; đồng (tiền)", "ex_zh": "一共十块钱。", "ex_vi": "Tổng cộng mười đồng."}
{"id": "h1-0206", "hv": "Khoái", "pos_vi": "Tính từ", "vi": "Nhanh; sắp", "ex_zh": "他跑得很快。", "ex_vi": "Anh ấy chạy rất nhanh."}
{"id": "h1-0207", "hv": "Lai", "pos_vi": "Động từ", "vi": "Đến; tới", "ex_zh": "你来我家吧。", "ex_vi": "Bạn đến nhà tôi đi."}
{"id": "h1-0208", "hv": "Lai đáo", "pos_vi": "Động từ", "vi": "Đến; tới nơi", "ex_zh": "我来到了北京。", "ex_vi": "Tôi đã đến Bắc Kinh."}
{"id": "h1-0209", "hv": "Lão", "pos_vi": "Tính từ", "vi": "Già; cũ; lão", "ex_zh": "我爷爷很老了。", "ex_vi": "Ông nội tôi già rồi."}
{"id": "h1-0210", "hv": "Lão nhân", "pos_vi": "Danh từ", "vi": "Người già; cụ già", "ex_zh": "这位老人今年八十岁。", "ex_vi": "Cụ này năm nay tám mươi tuổi."}
{"id": "h1-0211", "hv": "Lão sư", "pos_vi": "Danh từ", "vi": "Thầy giáo; cô giáo", "ex_zh": "我的老师很好。", "ex_vi": "Giáo viên của tôi rất tốt."}
{"id": "h1-0212", "hv": "Liễu", "pos_vi": "Trợ từ", "vi": "Rồi; đã (hoàn thành)", "ex_zh": "我已经吃了早饭。", "ex_vi": "Tôi đã ăn sáng rồi."}
{"id": "h1-0213", "hv": "Lụy", "pos_vi": "Tính từ", "vi": "Mệt; tích lũy", "ex_zh": "今天我很累。", "ex_vi": "Hôm nay tôi rất mệt."}
{"id": "h1-0214", "hv": "Lãnh", "pos_vi": "Tính từ", "vi": "Lạnh; họ Lãnh", "ex_zh": "今天天气很冷。", "ex_vi": "Hôm nay trời rất lạnh."}
{"id": "h1-0215", "hv": "Lý", "pos_vi": "Danh từ", "vi": "Trong; bên trong; dặm", "ex_zh": "书包里有一本书。", "ex_vi": "Trong cặp có một cuốn sách."}
{"id": "h1-0216", "hv": "Lý biên", "pos_vi": "Danh từ", "vi": "Bên trong", "ex_zh": "房间里边有人。", "ex_vi": "Bên trong phòng có người."}
{"id": "h1-0217", "hv": "Lưỡng", "pos_vi": "Số từ", "vi": "Hai; cả hai; vài", "ex_zh": "我有两个哥哥。", "ex_vi": "Tôi có hai anh trai."}
{"id": "h1-0218", "hv": "Linh", "pos_vi": "Số từ", "vi": "Không; số 0", "ex_zh": "现在是零点。", "ex_vi": "Bây giờ là không giờ."}
{"id": "h1-0219", "hv": "Lục", "pos_vi": "Số từ", "vi": "Sáu; số 6", "ex_zh": "我六点起床。", "ex_vi": "Tôi thức dậy lúc sáu giờ."}
{"id": "h1-0220", "hv": "Lâu", "pos_vi": "Danh từ", "vi": "Tòa nhà; tầng; lầu", "ex_zh": "我住在三楼。", "ex_vi": "Tôi sống ở tầng ba."}
{"id": "h1-0221", "hv": "Lâu thượng", "pos_vi": "Danh từ", "vi": "Trên lầu; tầng trên", "ex_zh": "他住在楼上。", "ex_vi": "Anh ấy sống ở tầng trên."}
{"id": "h1-0222", "hv": "Lâu hạ", "pos_vi": "Danh từ", "vi": "Dưới lầu; tầng dưới", "ex_zh": "我在楼下等你。", "ex_vi": "Tôi đợi bạn ở dưới lầu."}
{"id": "h1-0223", "hv": "Lộ", "pos_vi": "Danh từ", "vi": "Đường; con đường", "ex_zh": "这条路很长。", "ex_vi": "Con đường này rất dài."}
{"id": "h1-0224", "hv": "Lộ khẩu", "pos_vi": "Danh từ", "vi": "Ngã tư; ngã ba", "ex_zh": "前面的路口往左走。", "ex_vi": "Đến ngã tư phía trước thì rẽ trái."}
{"id": "h1-0225", "hv": "Lộ thượng", "pos_vi": "Danh từ", "vi": "Trên đường", "ex_zh": "路上请小心。", "ex_vi": "Đi đường nhớ cẩn thận."}
{"id": "h1-0226", "hv": "Ma", "pos_vi": "Danh từ", "vi": "Mẹ; má", "ex_zh": "我妈今天不在家。", "ex_vi": "Hôm nay mẹ tôi không ở nhà."}
{"id": "h1-0227", "hv": "Ma ma", "pos_vi": "Danh từ", "vi": "Mẹ; má", "ex_zh": "妈妈做的菜很好吃。", "ex_vi": "Món mẹ nấu rất ngon."}
{"id": "h1-0228", "hv": "Mã lộ", "pos_vi": "Danh từ", "vi": "Đường phố; lòng đường", "ex_zh": "过马路要小心。", "ex_vi": "Qua đường phải cẩn thận."}
{"id": "h1-0229", "hv": "Mã thượng", "pos_vi": "Phó từ", "vi": "Ngay; lập tức", "ex_zh": "请等一下，我马上来。", "ex_vi": "Xin đợi chút, tôi đến ngay."}
{"id": "h1-0230", "hv": "Ma", "pos_vi": "Trợ từ", "vi": "Trợ từ nghi vấn cuối câu", "ex_zh": "你是老师吗？", "ex_vi": "Bạn là giáo viên à?"}
{"id": "h1-0231", "hv": "Mãi", "pos_vi": "Động từ", "vi": "Mua", "ex_zh": "我想买一本书。", "ex_vi": "Tôi muốn mua một cuốn sách."}
{"id": "h1-0232", "hv": "Mạn", "pos_vi": "Tính từ", "vi": "Chậm", "ex_zh": "请说慢一点儿。", "ex_vi": "Làm ơn nói chậm một chút."}
{"id": "h1-0233", "hv": "Mang", "pos_vi": "Tính từ", "vi": "Bận; vội", "ex_zh": "我今天很忙。", "ex_vi": "Hôm nay tôi rất bận."}
{"id": "h1-0234", "hv": "Mao", "pos_vi": "Danh từ", "vi": "Lông; hào (tiền); họ Mao", "ex_zh": "这只猫的毛很长。", "ex_vi": "Lông của con mèo này rất dài."}
{"id": "h1-0235", "hv": "Một", "pos_vi": "Phó từ", "vi": "Không; chưa; không có", "ex_zh": "我没吃早饭。", "ex_vi": "Tôi chưa ăn sáng."}
{"id": "h1-0236", "hv": "Một quan hệ", "pos_vi": "Cụm từ", "vi": "Không sao; không có gì", "ex_zh": "没关系，你别着急。", "ex_vi": "Không sao, bạn đừng vội."}
{"id": "h1-0237", "hv": "Một thập ma", "pos_vi": "Cụm từ", "vi": "Không có gì; không sao", "ex_zh": "没什么，我很好。", "ex_vi": "Không có gì, tôi khỏe."}
{"id": "h1-0238", "hv": "Một sự nhi", "pos_vi": "Cụm từ", "vi": "Không sao; rảnh rỗi", "ex_zh": "没事儿，你先走吧。", "ex_vi": "Không sao, bạn đi trước đi."}
{"id": "h1-0239", "hv": "Một hữu", "pos_vi": "Động từ", "vi": "Không có; chưa", "ex_zh": "我没有哥哥。", "ex_vi": "Tôi không có anh trai."}
{"id": "h1-0240", "hv": "Muội", "pos_vi": "Danh từ", "vi": "Em gái", "ex_zh": "我妹今年上学了。", "ex_vi": "Em gái tôi năm nay đi học rồi."}
{"id": "h1-0241", "hv": "Muội muội", "pos_vi": "Danh từ", "vi": "Em gái", "ex_zh": "我妹妹今年八岁。", "ex_vi": "Em gái tôi năm nay tám tuổi."}
{"id": "h1-0242", "hv": "Môn", "pos_vi": "Danh từ", "vi": "Cửa; cổng; họ Môn", "ex_zh": "请把门打开。", "ex_vi": "Làm ơn mở cửa ra."}
{"id": "h1-0243", "hv": "Môn khẩu", "pos_vi": "Danh từ", "vi": "Cửa ra vào; cổng", "ex_zh": "他在门口等你。", "ex_vi": "Anh ấy đợi bạn ở cửa."}
{"id": "h1-0244", "hv": "Môn phiếu", "pos_vi": "Danh từ", "vi": "Vé vào cửa", "ex_zh": "这里的门票多少钱？", "ex_vi": "Vé vào cửa ở đây bao nhiêu tiền?"}
{"id": "h1-0245", "hv": "Môn", "pos_vi": "Trợ từ", "vi": "Các; những (hậu tố số nhiều)", "ex_zh": "我们是好朋友。", "ex_vi": "Chúng tôi là bạn tốt."}
{"id": "h1-0246", "hv": "Mễ phạn", "pos_vi": "Danh từ", "vi": "Cơm", "ex_zh": "我喜欢吃米饭。", "ex_vi": "Tôi thích ăn cơm."}
{"id": "h1-0247", "hv": "Diện bao", "pos_vi": "Danh từ", "vi": "Bánh mì", "ex_zh": "我早上吃面包。", "ex_vi": "Buổi sáng tôi ăn bánh mì."}
{"id": "h1-0248", "hv": "Diện điều nhi", "pos_vi": "Danh từ", "vi": "Mì sợi; mì", "ex_zh": "我想吃面条儿。", "ex_vi": "Tôi muốn ăn mì."}
{"id": "h1-0249", "hv": "Danh tự", "pos_vi": "Danh từ", "vi": "Tên; tên gọi", "ex_zh": "你叫什么名字？", "ex_vi": "Bạn tên là gì?"}
{"id": "h1-0250", "hv": "Minh bạch", "pos_vi": "Động từ", "vi": "Hiểu; rõ ràng", "ex_zh": "你明白我的意思吗？", "ex_vi": "Bạn có hiểu ý tôi không?"}
{"id": "h1-0251", "hv": "Minh niên", "pos_vi": "Danh từ", "vi": "Năm sau; sang năm", "ex_zh": "明年我想去中国。", "ex_vi": "Sang năm tôi muốn đi Trung Quốc."}
{"id": "h1-0252", "hv": "Minh thiên", "pos_vi": "Danh từ", "vi": "Ngày mai", "ex_zh": "明天你有时间吗？", "ex_vi": "Ngày mai bạn có thời gian không?"}
